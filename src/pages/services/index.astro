---
/**
 * services/index.astro — Services Hub
 * URL: /services/
 *
 * Comprehensive overview of the 6 core SEO & GEO services:
 * Technique, Contenu, Local, Audit, Stratégie, GEO.
 */
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { buildTitle, SITE_URL } from '../../utils/seo';
import { services } from '../../data/services';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Services', href: '/services/' },
];

const decisionGuide = [
  {
    situation: 'Je ne comprends pas pourquoi mon site n\'apparaît pas sur Google.',
    recommendedService: 'Audit SEO',
    url: '/services/audit-seo/',
    rationale: 'Un diagnostic complet de vos fondations techniques, sémantiques et concurrentielles pour isoler les blocages.',
  },
  {
    situation: 'Mon site a des erreurs d\'exploration, des lenteurs ou un balisage incomplet.',
    recommendedService: 'SEO Technique',
    url: '/services/seo-technique/',
    rationale: 'Assainissement du crawl, accélération des Core Web Vitals, architecture propre et code Schema.org.',
  },
  {
    situation: 'Mes contenus manquent de visibilité ou ne ciblent pas les bonnes intentions.',
    recommendedService: 'SEO Contenu & Sémantique',
    url: '/services/seo-contenu/',
    rationale: 'Cartographie des intentions de recherche, optimisation on-page et maillage interne thématique.',
  },
  {
    situation: 'Je veux être trouvé par des clients dans ma ville ou ma région.',
    recommendedService: 'SEO Local',
    url: '/services/seo-local/',
    rationale: 'Optimisation Google Business Profile, signaux de proximité et pages locales à forte pertinence.',
  },
  {
    situation: 'J\'ai besoin d\'une feuille de route claire pour guider mes investissements sur l\'année.',
    recommendedService: 'Stratégie SEO',
    url: '/services/strategie-seo/',
    rationale: 'Étude de marché, benchmark de concurrence, priorisation ROI/effort et pilotage des KPIs.',
  },
  {
    situation: 'Je souhaite anticiper l\'impact de l\'IA et apparaître dans les synthèses génératives.',
    recommendedService: 'GEO (Search IA)',
    url: '/services/geo/',
    rationale: 'Déclaration explicite des entités d\'affaires, graphes de données et optimisation pour les modèles de réponse.',
  },
];

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Services SEO & GEO — Ujjwal SEO',
  description: 'Services d\'accompagnement en référencement naturel et optimisation pour les moteurs IA : technique, contenu, local, audit, stratégie et GEO.',
  url: `${SITE_URL}/services/`,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      url: `${SITE_URL}/services/${s.slug}/`,
      description: s.shortDescription,
    },
  })),
};
---

<ServiceLayout
  title={buildTitle('Services SEO & GEO — Audit, Technique, Contenu, Local & Search IA')}
  description="Découvrez l'ensemble des prestations d'accompagnement en référencement naturel (SEO) et optimisation pour moteurs de recherche IA (GEO). Méthode claire et résultats durables."
  canonicalPath="/services/"
  breadcrumbs={breadcrumbs}
  schema={servicesSchema}
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Expertises & Prestations"
      title="Services SEO & GEO"
      description="Une suite d'interventions ciblées, pensées pour résoudre des blocages concrets et construire une présence numérique robuste, compréhensible et durable."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Découvrir mon approche', href: '/approche/' }}
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <!-- ══ GRILLE DES 6 SERVICES ══ -->
    <section class="section" aria-labelledby="hub-services-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Domaines d'intervention</p>
          <h2 id="hub-services-heading">6 expertises au service de votre visibilité</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Chaque prestation correspond à une étape de maturité ou à un défi spécifique de votre présence en ligne.
          </p>
        </div>

        <div class="grid-auto">
          {services.map((service, i) => (
            <ServiceCard
              title={service.title}
              slug={service.slug}
              description={service.shortDescription}
              category={service.category}
              deliverables={service.deliverables}
              index={i + 1}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- ══ GUIDE D'AIDE AU CHOIX ══ -->
    <section class="section section--surface" aria-labelledby="guide-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Orientation</p>
          <h2 id="guide-heading">Quel service correspond à votre situation ?</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Identifiez votre défi principal pour trouver le point de départ le plus pertinent.
          </p>
        </div>

        <div class="decision-grid">
          {decisionGuide.map((item) => (
            <div class="decision-card">
              <p class="decision-card__situation">« {item.situation} »</p>
              <div class="decision-card__answer">
                <span class="decision-card__label">Point d'entrée conseillé :</span>
                <a href={item.url} class="decision-card__link">
                  {item.recommendedService} &rarr;
                </a>
              </div>
              <p class="decision-card__rationale">{item.rationale}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ CTA FINAL ══ -->
    <CTA
      heading="Vous avez un doute sur la prestation adaptée ?"
      body="Chaque projet est unique. Discutons-en 30 minutes : nous établirons un premier diagnostic sans engagement."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Consulter la méthodologie', href: '/approche/' }}
      variant="navy"
    />
  </main>

  <Footer />
</ServiceLayout>

<style>
.decision-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
  margin-top: var(--space-10);
}

@media (max-width: 768px) {
  .decision-grid {
    grid-template-columns: 1fr;
  }
}

.decision-card {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
}

.decision-card__situation {
  font-family: var(--font-serif);
  font-size: var(--text-base);
  font-style: italic;
  color: var(--color-navy);
  margin-bottom: var(--space-4);
  line-height: var(--leading-relaxed);
}

.decision-card__answer {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
  padding-bottom: var(--space-2);
  border-bottom: 1px solid var(--color-border-light);
}

.decision-card__label {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-text-muted);
}

.decision-card__link {
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: var(--color-atlantic);
  text-decoration: none;
}

.decision-card__link:hover {
  text-decoration: underline;
}

.decision-card__rationale {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  margin: 0;
}
</style>
