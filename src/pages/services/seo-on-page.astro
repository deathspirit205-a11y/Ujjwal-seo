---
/**
 * services/seo-on-page.astro — SEO On-Page service page
 * URL: /services/seo-on-page/
 */
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { buildTitle, SITE_URL } from '../../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'SEO On-Page', href: '/services/seo-on-page/' },
];

const faqItems = [
  {
    id: 'onpage-mots-cles',
    question: 'Comment choisit-on les mots-clés à cibler ?',
    answer:
      'On analyse trois dimensions : le volume de recherche mensuel (combien de personnes cherchent ce terme), la difficulté concurrentielle (à quelle hauteur vous devrez vous battre pour vous positionner), et l\'intention derrière la requête (l\'utilisateur cherche-t-il à acheter, à s\'informer, ou à naviguer ?). L\'objectif est de cibler des mots-clés atteignables, pertinents pour votre activité et capables d\'attirer des visiteurs qualifiés.',
  },
  {
    id: 'onpage-réécriture',
    question: 'Faut-il réécrire entièrement les pages existantes ?',
    answer:
      'Pas systématiquement. Souvent, des ajustements ciblés suffisent : améliorer le titre, restructurer les sous-titres, enrichir une section manquante, renforcer le maillage interne. La refonte complète est réservée aux pages dont la structure ou l\'angle ne correspondent pas du tout à l\'intention de recherche ciblée.',
  },
  {
    id: 'onpage-contenu',
    question: 'L\'optimisation on-page inclut-elle la rédaction de contenu ?',
    answer:
      'L\'analyse et les recommandations de contenu sont incluses : quoi écrire, dans quel ordre, avec quelle profondeur. La rédaction elle-même peut être prise en charge dans le cadre d\'une mission d\'accompagnement, ou confiée à votre rédacteur en suivant les recommandations fournies.',
  },
  {
    id: 'onpage-difference',
    question: 'Quelle est la différence entre le SEO on-page et le SEO technique ?',
    answer:
      'Le SEO technique concerne la capacité de Google à explorer et à indexer votre site (infrastructure). Le SEO on-page concerne la pertinence de chaque page pour des requêtes spécifiques (signal). La technique est le prérequis : si les fondations sont défaillantes, l\'on-page ne compensera pas. Les deux sont complémentaires et souvent travaillés ensemble.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'SEO On-Page',
  description:
    'Optimisation on-page : recherche de mots-clés, intention de recherche, titres, structure Hn, contenu, maillage interne. Pour faire de chaque page un signal pertinent pour Google.',
  url: `${SITE_URL}/services/seo-on-page/`,
  provider: {
    '@type': 'ProfessionalService',
    name: 'Ujjwal SEO',
    url: SITE_URL,
  },
  areaServed: [
    { '@type': 'City', name: 'Rennes' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
    { '@type': 'Country', name: 'France' },
  ],
};
---

<ServiceLayout
  title={buildTitle('SEO On-Page — Optimisation de contenu et de structure')}
  description="SEO on-page : recherche de mots-clés, intention de recherche, structure Hn, optimisation des balises et du contenu. Pour que chaque page réponde précisément à ce que cherchent vos clients. Consultant SEO Rennes."
  canonicalPath="/services/seo-on-page/"
  breadcrumbs={breadcrumbs}
  schema={serviceSchema}
>
  <Header />
  <main id="main-content">

    <!-- ══ HERO ══ -->
    <PageHero
      bgImage="/assets/hero/architecture.jpg"
      bgAlt="Structure architecturale épurée symbolisant l'organisation du contenu"
      eyebrow="Service"
      title="SEO On-Page — Optimisation de contenu et de structure"
      description="Une fois les fondations techniques en ordre, la pertinence de chaque page devient l'enjeu central. Le SEO on-page s'assure que chaque page de votre site répond précisément à ce que vos visiteurs — et Google — cherchent."
      primaryCTA={{ label: 'Réserver un appel', href: '/reserver-un-appel/' }}
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />


    <!-- ══ CONCEPT ══ -->
    <section class="section section--surface" aria-labelledby="concept-heading">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow">Le principe</p>
          <h2 id="concept-heading">Du contenu qui répond à une intention</h2>
        </div>
        <div class="concept-grid">
          <div>
            <p style="color: var(--color-text-muted); line-height: var(--leading-relaxed)">
              Google ne classe pas des sites — il classe des pages. Et il classe en priorité les
              pages qui répondent le mieux à l'intention derrière une requête de recherche.
              Cette intention peut être informationnelle ("comment faire X"), transactionnelle
              ("acheter Y"), navigationnelle ou commerciale ("meilleur Z").
            </p>
            <p style="color: var(--color-text-muted); line-height: var(--leading-relaxed); margin-top: var(--space-4)">
              Comprendre cette intention est la première étape. Ensuite seulement, on travaille
              la structure de la page, le titre, les sous-titres, la profondeur du contenu et
              les liens internes pour que Google comprenne clairement de quoi parle la page et
              pourquoi elle mérite d'être bien classée.
            </p>
          </div>
          <div class="intention-types">
            <p class="intention-types__label">Types d'intention de recherche</p>
            <div class="intention-item">
              <span class="intention-item__tag intention-item__tag--info">Informationnelle</span>
              <span class="intention-item__example">"comment améliorer son SEO"</span>
            </div>
            <div class="intention-item">
              <span class="intention-item__tag intention-item__tag--commercial">Commerciale</span>
              <span class="intention-item__example">"meilleur consultant SEO Rennes"</span>
            </div>
            <div class="intention-item">
              <span class="intention-item__tag intention-item__tag--transac">Transactionnelle</span>
              <span class="intention-item__example">"demander un audit SEO"</span>
            </div>
            <div class="intention-item">
              <span class="intention-item__tag intention-item__tag--nav">Navigationnelle</span>
              <span class="intention-item__example">"Ujjwal SEO Rennes"</span>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ══ CE QUI EST OPTIMISÉ ══ -->
    <section class="section" aria-labelledby="optimise-heading">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow">Périmètre</p>
          <h2 id="optimise-heading">Ce qui est analysé et optimisé</h2>
        </div>

        <ol class="onpage-list" role="list">
          <li class="onpage-item">
            <div class="onpage-item__step" aria-hidden="true">01</div>
            <div class="onpage-item__content">
              <h3 class="onpage-item__title">Recherche de mots-clés</h3>
              <p class="onpage-item__desc">
                Identification des requêtes pertinentes pour chaque page ou section du site :
                volume, difficulté, intention, opportunités de positionnement réaliste. Base de
                toute la stratégie on-page.
              </p>
            </div>
          </li>
          <li class="onpage-item">
            <div class="onpage-item__step" aria-hidden="true">02</div>
            <div class="onpage-item__content">
              <h3 class="onpage-item__title">Balises title et méta description</h3>
              <p class="onpage-item__desc">
                Réécriture des balises pour intégrer les mots-clés cibles naturellement, respecter
                les limites d'affichage de Google et inciter au clic. Ces balises sont le premier
                signal envoyé à Google et la première impression pour l'utilisateur.
              </p>
            </div>
          </li>
          <li class="onpage-item">
            <div class="onpage-item__step" aria-hidden="true">03</div>
            <div class="onpage-item__content">
              <h3 class="onpage-item__title">Structure des titres (Hn)</h3>
              <p class="onpage-item__desc">
                Organisation logique des H1, H2, H3 pour créer une hiérarchie claire, faciliter
                la lecture et envoyer des signaux de pertinence cohérents à Google. Un seul H1
                par page, descriptif et ciblé.
              </p>
            </div>
          </li>
          <li class="onpage-item">
            <div class="onpage-item__step" aria-hidden="true">04</div>
            <div class="onpage-item__content">
              <h3 class="onpage-item__title">Contenu et profondeur</h3>
              <p class="onpage-item__desc">
                Analyse des lacunes de contenu par rapport aux pages concurrentes qui se positionnent.
                Recommandations sur les sujets à couvrir, les questions à traiter et la profondeur
                attendue pour une page compétitive.
              </p>
            </div>
          </li>
          <li class="onpage-item">
            <div class="onpage-item__step" aria-hidden="true">05</div>
            <div class="onpage-item__content">
              <h3 class="onpage-item__title">Maillage interne</h3>
              <p class="onpage-item__desc">
                Création de liens internes stratégiques entre les pages pour distribuer l'autorité,
                faciliter la navigation et signaler à Google les pages les plus importantes de votre
                site.
              </p>
            </div>
          </li>
          <li class="onpage-item">
            <div class="onpage-item__step" aria-hidden="true">06</div>
            <div class="onpage-item__content">
              <h3 class="onpage-item__title">Optimisation des images</h3>
              <p class="onpage-item__desc">
                Vérification des attributs alt (accessibilité et signal sémantique), des noms de
                fichiers et de la compression. Les images correctement décrites contribuent à la
                pertinence globale de la page.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>


    <!-- ══ POUR QUI ══ -->
    <section class="section section--warm" aria-labelledby="pourqui-heading">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow">Pour qui</p>
          <h2 id="pourqui-heading">L'optimisation on-page est adaptée si…</h2>
        </div>
        <ul class="check-list" role="list">
          <li class="check-item">
            <span class="check-item__marker" aria-hidden="true">→</span>
            <div>
              <strong>Votre site a une bonne base technique</strong> mais vos pages ne se positionnent pas sur vos requêtes cibles.
            </div>
          </li>
          <li class="check-item">
            <span class="check-item__marker" aria-hidden="true">→</span>
            <div>
              <strong>Vous avez du contenu existant</strong> mais il ne génère pas de trafic organique significatif.
            </div>
          </li>
          <li class="check-item">
            <span class="check-item__marker" aria-hidden="true">→</span>
            <div>
              <strong>Vous créez de nouvelles pages stratégiques</strong> (services, catégories, landing pages) et vous voulez les optimiser dès la création.
            </div>
          </li>
          <li class="check-item">
            <span class="check-item__marker" aria-hidden="true">→</span>
            <div>
              <strong>Vous n'avez jamais fait de recherche de mots-clés structurée</strong> et vos pages ciblent des termes soit trop compétitifs, soit pas du tout recherchés.
            </div>
          </li>
        </ul>
      </div>
    </section>


    <!-- ══ RELATED ══ -->
    <section class="section section--surface" aria-labelledby="related-heading">
      <div class="container">
        <div class="prose-header">
          <p class="eyebrow">Services complémentaires</p>
          <h2 id="related-heading">Une optimisation complète passe par les deux piliers</h2>
        </div>
        <div class="related-grid">
          <a href="/services/seo-technique/" class="suite-link">
            <span class="suite-link__title">SEO Technique</span>
            <span class="suite-link__desc">Le prérequis : s'assurer que Google peut explorer et indexer</span>
            <span class="suite-link__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/services/audit-seo/" class="suite-link">
            <span class="suite-link__title">Audit SEO</span>
            <span class="suite-link__desc">Diagnostic complet pour identifier les priorités on-page et techniques</span>
            <span class="suite-link__arrow" aria-hidden="true">→</span>
          </a>
          <a href="/services/accompagnement-seo/" class="suite-link">
            <span class="suite-link__title">Accompagnement SEO</span>
            <span class="suite-link__desc">L'on-page intégré dans un suivi mensuel continu</span>
            <span class="suite-link__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>


    <!-- ══ FAQ ══ -->
    <FAQ items={faqItems} heading="Questions fréquentes sur le SEO on-page" />


    <!-- ══ CTA ══ -->
    <CTA
      heading="Vos pages ont du potentiel. Faisons-le ressortir."
      body="Un premier échange pour identifier les pages à fort potentiel et définir les priorités d'optimisation."
      primaryCTA={{ label: 'Réserver un appel', href: '/reserver-un-appel/' }}
      secondaryCTA={{ label: 'Commencer par un audit', href: '/services/audit-seo/' }}
      variant="dark"
    />

  </main>
  <Footer />
</ServiceLayout>

<style>
.service-hero {
  padding-top: var(--space-16);
  padding-bottom: var(--space-12);
}
.service-hero__content {
  max-width: 44rem;
}
.service-hero__h1 {
  font-family: var(--font-serif);
  font-size: clamp(1.875rem, 4vw, 2.75rem);
  font-weight: var(--weight-bold);
  line-height: 1.15;
  letter-spacing: -0.02em;
  margin-bottom: var(--space-5);
}
.prose-header {
  max-width: 40rem;
  margin-bottom: var(--space-10);
}
.prose-header h2 {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: var(--weight-bold);
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin-top: var(--space-2);
}

/* ══ CONCEPT ══ */
.concept-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-12);
  align-items: start;
}
@media (max-width: 768px) {
  .concept-grid { grid-template-columns: 1fr; }
}

.intention-types {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}
.intention-types__label {
  font-size: var(--text-xs);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-text-subtle);
  font-weight: var(--weight-semibold);
  margin-bottom: var(--space-2);
}
.intention-item {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-4);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
  background-color: var(--color-bg);
}
.intention-item__tag {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  padding: 2px var(--space-2);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  text-transform: capitalize;
}
.intention-item__tag--info    { background-color: #EBF5FB; color: #1A5276; }
.intention-item__tag--commercial { background-color: #EAFAF1; color: #1E8449; }
.intention-item__tag--transac { background-color: #FEF9E7; color: #9A7D0A; }
.intention-item__tag--nav     { background-color: #F4ECF7; color: #6C3483; }
.intention-item__example {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  font-style: italic;
}

/* ══ ON-PAGE LIST ══ */
.onpage-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  max-width: 52rem;
}
.onpage-item {
  display: flex;
  gap: var(--space-5);
  align-items: flex-start;
  padding: var(--space-6);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  background-color: var(--color-bg);
}
.onpage-item__step {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-accent);
  flex-shrink: 0;
  min-width: 2rem;
}
.onpage-item__title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  margin-bottom: var(--space-2);
}
.onpage-item__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
}

/* ══ CHECK LIST ══ */
.check-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  max-width: 48rem;
}
.check-item {
  display: flex;
  gap: var(--space-4);
  align-items: flex-start;
  padding: var(--space-5);
  background-color: var(--color-bg);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
}
.check-item__marker {
  color: var(--color-accent);
  font-weight: var(--weight-bold);
  flex-shrink: 0;
}
.check-item div {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
}
.check-item strong {
  color: var(--color-text);
}

/* ══ RELATED ══ */
.related-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  max-width: 40rem;
}
.suite-link {
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-rows: auto auto;
  gap: 0 var(--space-3);
  padding: var(--space-4) var(--space-5);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: border-color var(--transition-fast), background-color var(--transition-fast);
  align-items: center;
}
.suite-link:hover {
  border-color: var(--color-accent);
  background-color: var(--color-surface);
}
.suite-link__title {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-text);
  grid-column: 1;
  grid-row: 1;
}
.suite-link__desc {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  grid-column: 1;
  grid-row: 2;
}
.suite-link__arrow {
  color: var(--color-accent);
  grid-column: 2;
  grid-row: 1 / 3;
  font-size: 1.1rem;
}
</style>
