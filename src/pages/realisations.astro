---
/**
 * realisations.astro — Portfolio / case studies
 * URL: /realisations/
 * Per spec §19: real projects only. Uses an honest "en construction" framing
 * with a strong lead-gen angle while awaiting real case studies.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import PageHero from '../components/PageHero.astro';
import { buildTitle, SITE_URL } from '../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Réalisations', href: '/realisations/' },
];

// CollectionPage schema — portfolio/case studies page
// https://schema.org/CollectionPage
const realisationsSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Réalisations SEO — Ujjwal Lage',
    description: 'Exemples de projets SEO réalisés par Ujjwal Lage : audits, optimisations techniques, SEO local et accompagnements pour des entreprises à Rennes et en Bretagne.',
    url: `${SITE_URL}/realisations/`,
    author: {
      '@type': 'Person',
      name: 'Ujjwal Lage',
      url: `${SITE_URL}/a-propos/`,
    },
    inLanguage: 'fr',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Accueil',
        item: SITE_URL,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Réalisations',
        item: `${SITE_URL}/realisations/`,
      },
    ],
  },
];

// NOTE: Replace with real anonymized case studies when available.
// Per spec §19: do NOT invent or exaggerate results.
const typesResultats = [
  {
    icon: '📈',
    titre: 'Trafic organique',
    description: 'Augmentation du nombre de visiteurs issus des recherches Google grâce à un meilleur positionnement sur les mots-clés cibles.',
  },
  {
    icon: '📍',
    titre: 'Visibilité locale',
    description: 'Apparition dans le pack local et Google Maps pour les recherches géolocalisées pertinentes pour le client.',
  },
  {
    icon: '⚙️',
    titre: 'Performance technique',
    description: 'Amélioration des Core Web Vitals et des scores Lighthouse pour une meilleure expérience utilisateur et indexation.',
  },
  {
    icon: '📝',
    titre: 'Pages optimisées',
    description: 'Création et optimisation de pages de services et d\'articles de blog ciblant des intentions de recherche précises.',
  },
];
---

<BaseLayout
  title={buildTitle('Réalisations — Projets SEO de Ujjwal Lage')}
  description="Découvrez les projets SEO de Ujjwal Lage : audits, optimisations techniques, SEO local et accompagnements pour des entreprises à Rennes et en Bretagne."
  canonicalPath="/realisations/"
  schema={realisationsSchema}
>
  <Header />
  <main id="main-content">
    <PageHero
      bgImage="/assets/hero/digital-network.jpg"
      bgAlt="Visualisation de flux de données et graphiques de performance SEO"
      eyebrow="Réalisations"
      title="Des résultats concrets, mesurables"
      description="Chaque mission part d'un objectif business clair — pas d'une liste de tâches SEO abstraites. Vous trouverez ici des exemples des résultats que j'obtiens pour mes clients, présentés honnêtement et sans exagération."
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <!-- Honest placeholder -->
    <section class="section section--alt">
      <div class="container">
        <div class="placeholder-notice">
          <div class="placeholder-notice__icon" aria-hidden="true">🔒</div>
          <div class="placeholder-notice__content">
            <h2>Études de cas en cours de rédaction</h2>
            <p>
              Je prends le temps de documenter correctement chaque projet — avec le contexte,
              les actions menées, et les résultats réels. Je préfère attendre d'avoir quelque
              chose d'honnête et de détaillé plutôt que de publier des chiffres inventés.
            </p>
            <p>
              <strong>Les études de cas seront disponibles prochainement.</strong>
              En attendant, je vous invite à me contacter directement pour discuter de cas
              similaires à votre situation.
            </p>
            <a href="/contact/" class="btn btn--primary">Discuter de votre projet</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Types de résultats -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Les types de résultats que j'obtiens</h2>
        <p class="section-subtitle">
          Voici les axes sur lesquels je travaille et les résultats que mes clients constatent.
        </p>
        <div class="resultats-grid">
          {typesResultats.map((r) => (
            <article class="resultat-card">
              <span class="resultat-card__icon" aria-hidden="true">{r.icon}</span>
              <h3 class="resultat-card__titre">{r.titre}</h3>
              <p class="resultat-card__desc">{r.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Process rapide -->
    <section class="section section--alt">
      <div class="container">
        <div class="process-simple">
          <h2>Comment je travaille</h2>
          <p>
            Chaque projet commence par une phase d'analyse approfondie (audit SEO, étude de mots-clés,
            analyse concurrentielle). J'élabore ensuite une stratégie priorisée et je l'exécute
            en collaboration avec vous — avec un reporting mensuel transparent pour suivre les progrès.
          </p>
          <div class="process-simple__links">
            <a href="/services/audit-seo/" class="process-link">Audit SEO →</a>
            <a href="/services/accompagnement-seo/" class="process-link">Accompagnement mensuel →</a>
            <a href="/a-propos/" class="process-link">Mon parcours →</a>
          </div>
        </div>
      </div>
    </section>

    <CTA
      title="Votre entreprise pourrait être la prochaine réalisation"
      description="Que vous soyez à Rennes, en Bretagne ou ailleurs en France, parlons de votre projet SEO lors d'un appel découverte de 30 minutes, gratuit et sans engagement."
      primaryLabel="Réserver un appel gratuit"
      primaryHref="/reserver-un-appel/"
      secondaryLabel="Voir mes services"
      secondaryHref="/services/"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .realisations-hero {
    padding-top: var(--space-12);
  }



  /* Placeholder notice */
  .placeholder-notice {
    display: flex;
    gap: var(--space-8);
    align-items: flex-start;
    background: white;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
  }

  .placeholder-notice__icon {
    font-size: 3rem;
    flex-shrink: 0;
  }

  .placeholder-notice__content h2 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .placeholder-notice__content p {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  /* Résultats */
  .resultats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .resultat-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .resultat-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .resultat-card__icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--space-3);
  }

  .resultat-card__titre {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .resultat-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Process simple */
  .process-simple {
    max-width: 700px;
  }

  .process-simple h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .process-simple > p {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .process-simple__links {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .process-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    transition: all 0.2s ease;
  }

  .process-link:hover {
    background: var(--color-accent);
    color: white;
  }

  @media (max-width: 640px) {
    .placeholder-notice {
      flex-direction: column;
      gap: var(--space-4);
    }
  }
</style>
