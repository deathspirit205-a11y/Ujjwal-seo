---
/**
 * approche.astro — Méthode et déroulement des projets
 * URL: /approche/
 *
 * Details the collaborative methodology, diagnostic phases, strategy formulation,
 * execution, monitoring, and communication principles.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EntityDiagram from '../components/EntityDiagram.astro';
import MethodTimeline from '../components/MethodTimeline.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { buildTitle, SITE_URL } from '../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Approche', href: '/approche/' },
];

const approachSteps = [
  {
    title: 'Comprendre',
    when: 'Semaine 1',
    description: 'Immersion dans votre modèle économique, vos offres à forte marge et la demande réelle sur votre marché.',
  },
  {
    title: 'Structurer',
    when: 'Semaines 2–3',
    description: 'Cartographie des entités, arborescence en silos, maillage interne et levée des blocages d\'indexation.',
  },
  {
    title: 'Optimiser',
    when: 'Semaines 3–6',
    description: 'Réécriture des pages clés, balisage Schema.org (JSON-LD), Core Web Vitals et signaux locaux.',
  },
  {
    title: 'Développer',
    when: 'Mois 2–6',
    description: 'Création de contenus d\'autorité et réponses synthétiques citables par Google et les IA génératives.',
  },
  {
    title: 'Mesurer',
    when: 'Chaque mois',
    description: 'Suivi dans Google Search Console : positions, clics qualifiés, prises de contact et citations IA.',
  },
];

const faqApproach = [
  {
    id: 'approche-duree',
    question: 'Combien de temps faut-il pour constater des résultats concrets ?',
    answer: 'En SEO comme en GEO, il n\'y a pas d\'interrupteur magique. Les corrections techniques et l\'indexation de pages fraîches portent leurs premiers fruits entre 6 à 12 semaines. Le renforcement durable de l\'autorité et le positionnement sur des requêtes concurrentielles s\'inscrivent généralement dans un cycle de 4 à 6 mois de travail régulier.',
  },
  {
    id: 'approche-technique',
    question: 'Faut-il savoir coder pour mettre en œuvre vos recommandations ?',
    answer: 'Non. Je rédige des spécifications claires et pédagogiques. Si vous disposez d\'un développeur ou d\'une agence web, je leur transmets des consignes techniques précises. Pour les aspects de contenu, de balisage ou de CMS (WordPress, Webflow, Shopify, etc.), nous pouvons intervenir directement selon vos préférences.',
  },
  {
    id: 'approche-distance',
    question: 'Comment s\'organise le travail si nous ne sommes pas dans la même ville ?',
    answer: 'La très grande majorité des missions s\'effectuent à distance dans toute la France avec une excellente efficacité : points réguliers par visioconférence, tableau de bord partagé, échanges par email et messagerie instantanée réactive. Pour les entreprises basées en Bretagne et Pays de la Loire, des rencontres physiques sont tout à fait envisageables.',
  },
  {
    id: 'approche-garantie',
    question: 'Proposez-vous une garantie de première place sur Google ou ChatGPT ?',
    answer: 'Non, et aucun professionnel honnête ne le fera. Les algorithmes de Google et les modèles génératifs évoluent constamment et dépendent de critères extérieurs. Ce que je garantis en revanche, c\'est une rigueur méthodologique absolue, un travail sans raccourci pénalisant et des fondations conformes aux meilleures pratiques de l\'industrie.',
  },
];

const schemaWebPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Approche & Méthodologie — Ujjwal SEO',
  description: 'Découvrez la méthodologie de travail d\'Ujjwal SEO : compréhension des enjeux, structuration technique, optimisation sémantique, et veille active sur le GEO.',
  url: `${SITE_URL}/approche/`,
  provider: {
    '@type': 'ProfessionalService',
    name: 'Ujjwal SEO',
    url: SITE_URL,
  },
};
---

<BaseLayout
  title={buildTitle('Mon approche SEO & GEO — Méthodologie & Collaboration')}
  description="Découvrez comment se déroule un accompagnement SEO & GEO : diagnostic approfondi, stratégie sur-mesure, exécution transparente et pilotage par la donnée."
  canonicalPath="/approche/"
  schema={[schemaWebPage]}
>
  <Header />

  <main id="main-content">
    <PageHero
      visual="traffic"
      eyebrow="Méthode & Vision"
      title="Une approche rigoureuse, transparente et orientée business"
      description="Le référencement naturel et l'optimisation pour les moteurs IA ne relèvent pas de l'alchimie. C'est une discipline d'ingénierie de l'information qui associe structure technique, pertinence éditoriale et compréhension d'entités."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Consulter les services', href: '/services/' }}
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <!-- ══ CADRE MÉTHODOLOGIQUE : LA MÉTHODE A.R.C. ══ -->
    <section class="section section--surface" aria-labelledby="philosophy-heading">
      <div class="container">
        <div class="section-header--centered reveal">
          <p class="eyebrow">Cadre de travail propriétaire</p>
          <h2 id="philosophy-heading">La Méthode <span class="mark">A.R.C.</span> : trois couches indissociables</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Pour qu'une entreprise soit classée par Google et citée par les moteurs IA, elle doit valider trois niveaux successifs : <strong>Accessibilité</strong>, <strong>Relevance (Pertinence)</strong> et <strong>Citations</strong>.
          </p>
        </div>

        <div class="pillars-grid">
          <div class="pillar-card reveal">
            <span class="pillar-card__num">A · Accessibilité</span>
            <h3 class="pillar-card__title">Être lu et indexé sans friction</h3>
            <p class="pillar-card__desc">
              Un robot qui bute sur des erreurs d'exploration, des pages lentes ou une arborescence confuse n'indexera jamais correctement vos offres. On assainit d'abord le socle technique et les Core Web Vitals.
            </p>
          </div>

          <div class="pillar-card reveal reveal-delay-1">
            <span class="pillar-card__num">R · Relevance &amp; Entités</span>
            <h3 class="pillar-card__title">Répondre exactement à l'intention</h3>
            <p class="pillar-card__desc">
              Chaque page cible une intention précise et déclare explicitement vos entités (qui vous êtes, ce que vous faites, où vous intervenez) via un maillage logique et un graphe Schema.org complet.
            </p>
          </div>

          <div class="pillar-card reveal reveal-delay-2">
            <span class="pillar-card__num">C · Citations &amp; Autorité</span>
            <h3 class="pillar-card__title">Devenir la source que l'on cite</h3>
            <p class="pillar-card__desc">
              Qu'il s'agisse du Pack Local Google Maps ou d'une réponse générée par ChatGPT / Perplexity, les moteurs retiennent les entreprises dont les faits, avis et preuves sont cohérents partout sur le web.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ SYSTÈME SEARCH LANDSCAPE & COMPRÉHENSION ══ -->
    <EntityDiagram />

    <!-- ══ CYCLE DE VIE D'UN PROJET ══ -->
    <MethodTimeline
      steps={approachSteps}
      heading="Le déroulement concret d'un projet"
      subheading="De la prise de contact initiale au suivi mensuel des retombées, chaque étape est documentée et validée ensemble."
    />

    <!-- ══ OUTILS & EXIGENCES TECHNIQUES ══ -->
    <section class="section section--surface" aria-labelledby="tools-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Environnement de travail</p>
          <h2 id="tools-heading">Des outils reconnus et des standards ouverts</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Les analyses reposent sur les standards officiels du W3C, de Google et de Schema.org, combinés aux outils professionnels de référence de l'industrie du search.
          </p>
        </div>

        <div class="tools-grid">
          <div class="tool-item">
            <h4 class="tool-item__title">Google Search Console & Analytics</h4>
            <p class="tool-item__desc">Les données de première main fournies directement par Google pour mesurer les impressions, le CTR, les requêtes exactes et la santé technique.</p>
          </div>
          <div class="tool-item">
            <h4 class="tool-item__title">Crawl & Exploration (Screaming Frog)</h4>
            <p class="tool-item__desc">Audit systématique de l'arborescence, des codes HTTP, du budget de crawl, des balises canoniques et de la profondeur de clic.</p>
          </div>
          <div class="tool-item">
            <h4 class="tool-item__title">Balisage Schema.org & JSON-LD</h4>
            <p class="tool-item__desc">Structuration sémantique normalisée pour expliciter vos services, votre organisation, vos auteurs et vos zones géographiques.</p>
          </div>
          <div class="tool-item">
            <h4 class="tool-item__title">Veille & Moteurs de réponse IA</h4>
            <p class="tool-item__desc">Surveillance des extractions contextuelles dans les Google AI Overviews et moteurs de réponse de nouvelle génération.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ FAQ APPROCHE ══ -->
    <FAQ items={faqApproach} heading="Questions fréquentes sur le déroulement" />

    <!-- ══ CTA FINAL ══ -->
    <CTA
      heading="Envie d'échanger sur la méthode adaptée à votre activité ?"
      body="Chaque projet démarre par une discussion ouverte sur vos enjeux commerciaux et votre situation actuelle. Sans engagement."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Explorer les services', href: '/services/' }}
      variant="navy"
    />
  </main>

  <Footer />
</BaseLayout>

<style>
/* ══ PILLARS GRID ══ */
.pillars-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
  margin-top: var(--space-10);
}

@media (max-width: 860px) {
  .pillars-grid {
    grid-template-columns: 1fr;
  }
}

.pillar-card {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
}

.pillar-card__num {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: var(--color-atlantic);
  margin-bottom: var(--space-4);
  display: inline-block;
}

.pillar-card__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-3);
  line-height: var(--leading-snug);
}

.pillar-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin: 0;
}

/* ══ TOOLS GRID ══ */
.tools-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
  margin-top: var(--space-10);
}

@media (max-width: 768px) {
  .tools-grid {
    grid-template-columns: 1fr;
  }
}

.tool-item {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-left: 3px solid var(--color-atlantic);
  border-radius: var(--radius-sm);
  padding: var(--space-6);
}

.tool-item__title {
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-2);
}

.tool-item__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin: 0;
}
</style>
