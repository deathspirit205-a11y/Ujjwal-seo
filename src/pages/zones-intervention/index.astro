---
/**
 * zones-intervention/index.astro — Zones d'intervention Hub
 * URL: /zones-intervention/
 *
 * Visual interactive map of Western France (Bretagne, Pays de la Loire)
 * and clear explanation of regional vs national remote accompaniment.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InteractiveWesternMap from '../../components/InteractiveWesternMap.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { buildTitle, SITE_URL } from '../../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Zones d\'intervention', href: '/zones-intervention/' },
];

const faqZones = [
  {
    id: 'zone-rencontre',
    question: 'Pouvons-nous nous rencontrer en personne ?',
    answer: 'Oui, tout à fait. Pour les entreprises situées en Ille-et-Vilaine (Rennes, Vitré, Fougères, Janzé, Bruz, Cesson-Sévigné) et en Mayenne (Laval, Château-Gontier), des rendez-vous physiques ou des sessions de travail dans vos locaux peuvent être organisés selon les besoins de la mission.',
  },
  {
    id: 'zone-distance',
    question: 'Comment se passe l\'accompagnement à distance pour le reste de la France ?',
    answer: 'La localisation géographique n\'a aucun impact négatif sur l\'efficacité du travail SEO et GEO. Nous collaborons avec la même proximité via visioconférences (Google Meet), messagerie instantanée, partages d\'écrans et tableaux de suivi en ligne.',
  },
  {
    id: 'zone-local-importance',
    question: 'Pourquoi travailler le SEO local pour mon entreprise ?',
    answer: 'Pour les commerces, artisans, professions libérales et PME avec une zone de chalandise physique, le SEO local capte les internautes au moment exact où leur intention d\'achat est maximale (ex: "expert-comptable Rennes", "charpentier Vitré"). Nous optimisons votre présence sur Google Maps, vos fiches d\'établissement et vos contenus territoriaux.',
  },
];

const schemaWebPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Zones d\'intervention SEO & GEO — Bretagne, Pays de la Loire et France entière',
  description: 'Découvrez les zones d\'intervention d\'Ujjwal SEO : ancrage territorial dans le Grand Ouest (Rennes, Vitré, Fougères, Laval, Nantes) et accompagnement SEO/GEO à distance dans toute la France.',
  url: `${SITE_URL}/zones-intervention/`,
  provider: {
    '@type': 'ProfessionalService',
    name: 'Ujjwal SEO',
    url: SITE_URL,
  },
};
---

<BaseLayout
  title={buildTitle('Zones d\'intervention SEO & GEO — Bretagne, Pays de la Loire & France')}
  description="Consultant SEO & GEO : ancrage territorial dans le Grand Ouest (Rennes, Vitré, Fougères, Laval, Nantes) et accompagnement partout en France à distance."
  canonicalPath="/zones-intervention/"
  schema={[schemaWebPage]}
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Rayonnement Territorial & National"
      title="Zones d'intervention SEO & GEO"
      description="De la Bretagne aux Pays de la Loire pour un accompagnement de proximité, et partout en France à distance pour les entreprises ayant des ambitions nationales."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Découvrir mon approche', href: '/approche/' }}
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <!-- ══ PHILOSOPHIE GÉOGRAPHIQUE ══ -->
    <section class="section section--surface" aria-labelledby="geo-phil-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Vision géographique</p>
          <h2 id="geo-phil-heading">Local quand l'ancrage compte. À distance quand il n'a pas d'importance.</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Certaines problématiques exigent une compréhension fine du tissu économique local et des rencontres en face à face. D'autres projets nécessitent une expertise pointue en ingénierie sémantique ou en SEO technique qui s'exécute parfaitement à distance.
          </p>
        </div>

        <div class="phil-cards-grid">
          <div class="phil-card">
            <span class="phil-card__badge">Proximité territoriale</span>
            <h3 class="phil-card__title">Grand Ouest & Rencontres physiques</h3>
            <p class="phil-card__desc">
              Implanté au cœur de la Bretagne et des Pays de la Loire, je me déplace pour des audits stratégiques, des ateliers d'équipe ou des comités de direction à Rennes, Vitré, Fougères, Laval ou Nantes.
            </p>
            <ul class="phil-card__list">
              <li>Connaissance des spécificités économiques locales</li>
              <li>Ateliers de travail en présentiel</li>
              <li>SEO local et visibilité Google Maps ciblée</li>
            </ul>
          </div>

          <div class="phil-card phil-card--remote">
            <span class="phil-card__badge phil-card__badge--remote">National</span>
            <h3 class="phil-card__title">France entière & Accompagnement à distance</h3>
            <p class="phil-card__desc">
              Que vous soyez à Paris, Lyon, Bordeaux, Lille ou dans toute autre région française, nous travaillons avec une méthodologie collaborative parfaitement rodée.
            </p>
            <ul class="phil-card__list">
              <li>Points réguliers en visioconférence</li>
              <li>Livrables partagés et suivi transparent</li>
              <li>SEO national, e-commerce & GEO sémantique</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CARTE INTERACTIVE DU GRAND OUEST ══ -->
    <InteractiveWesternMap />

    <!-- ══ GUIDES DÉPARTEMENTAUX & LIENS ══ -->
    <section class="section section--surface" aria-labelledby="depts-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Territoires</p>
          <h2 id="depts-heading">Explorer par département ou bassin économique</h2>
        </div>

        <div class="depts-grid">
          <article class="dept-card">
            <h3 class="dept-card__title">Ille-et-Vilaine (35)</h3>
            <p class="dept-card__lead">Cœur économique breton, métropole dynamique et villes intermédiaires en plein développement.</p>
            <ul class="dept-card__cities">
              <li><a href="/zones-intervention/seo-rennes/">SEO Rennes</a></li>
              <li><a href="/zones-intervention/seo-vitre/">SEO Vitré</a></li>
              <li><a href="/zones-intervention/seo-fougeres/">SEO Fougères</a></li>
              <li><a href="/zones-intervention/seo-janze/">SEO Janzé</a></li>
              <li><a href="/zones-intervention/seo-redon/">SEO Redon</a></li>
            </ul>
            <a href="/zones-intervention/ille-et-vilaine/" class="dept-card__main-link">Découvrir le pôle Ille-et-Vilaine &rarr;</a>
          </article>

          <article class="dept-card">
            <h3 class="dept-card__title">Bretagne régionale</h3>
            <p class="dept-card__lead">Accompagnement des acteurs du littoral, de l'agroalimentaire et des services sur les 4 départements.</p>
            <ul class="dept-card__cities">
              <li><a href="/zones-intervention/bretagne/">SEO Bretagne (Vue d'ensemble)</a></li>
              <li><span>Saint-Malo & Côte d'Émeraude</span></li>
              <li><span>Saint-Brieuc & Côtes-d'Armor</span></li>
              <li><span>Vannes & Lorient (Morbihan)</span></li>
              <li><span>Brest & Quimper (Finistère)</span></li>
            </ul>
            <a href="/zones-intervention/bretagne/" class="dept-card__main-link">Explorer la région Bretagne &rarr;</a>
          </article>

          <article class="dept-card">
            <h3 class="dept-card__title">Mayenne & Pays de la Loire</h3>
            <p class="dept-card__lead">Bassin industriel et agro-économique actif reliant la Bretagne à l'Île-de-France.</p>
            <ul class="dept-card__cities">
              <li><a href="/zones-intervention/seo-laval/">SEO Laval</a></li>
              <li><a href="/zones-intervention/mayenne/">Mayenne & Château-Gontier</a></li>
              <li><a href="/zones-intervention/seo-chateaubriant/">SEO Châteaubriant</a></li>
              <li><a href="/zones-intervention/loire-atlantique/">Nantes & Loire-Atlantique</a></li>
              <li><a href="/zones-intervention/maine-et-loire/">Angers & Maine-et-Loire</a></li>
            </ul>
            <a href="/zones-intervention/mayenne/" class="dept-card__main-link">Explorer la Mayenne & Pays de la Loire &rarr;</a>
          </article>
        </div>
      </div>
    </section>

    <!-- ══ FAQ ZONES ══ -->
    <FAQ items={faqZones} heading="Questions fréquentes sur les interventions géographiques" />

    <!-- ══ CTA FINAL ══ -->
    <CTA
      heading="Parlons de votre marché et de votre visibilité locale ou nationale."
      body="Que vous souhaitiez capter des clients dans votre zone de chalandise ou développer votre autorité dans toute la France, nous établissons un plan adapté à votre secteur."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Découvrir la méthodologie', href: '/approche/' }}
      variant="navy"
    />
  </main>

  <Footer />
</BaseLayout>

<style>
/* ══ PHILOSOPHY CARDS ══ */
.phil-cards-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
  margin-top: var(--space-10);
}

@media (max-width: 800px) {
  .phil-cards-grid {
    grid-template-columns: 1fr;
  }
}

.phil-card {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
}

.phil-card--remote {
  border-color: rgba(37, 99, 235, 0.35);
  background: rgba(37, 99, 235, 0.02);
}

.phil-card__badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 0.72rem;
  font-weight: var(--weight-bold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-atlantic);
  background: rgba(37, 99, 235, 0.08);
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-4);
}

.phil-card__badge--remote {
  color: #1D4ED8;
  background: rgba(29, 78, 216, 0.1);
}

.phil-card__title {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-3);
}

.phil-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-6);
}

.phil-card__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text);
}

.phil-card__list li {
  position: relative;
  padding-left: var(--space-5);
}

.phil-card__list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--color-atlantic);
  font-weight: bold;
}

/* ══ DEPTS GRID ══ */
.depts-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
  margin-top: var(--space-10);
}

@media (max-width: 900px) {
  .depts-grid {
    grid-template-columns: 1fr;
  }
}

.dept-card {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
}

.dept-card__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-2);
  padding-bottom: var(--space-2);
  border-bottom: 2px solid var(--color-border-light);
}

.dept-card__lead {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-4);
}

.dept-card__cities {
  list-style: none;
  padding: 0;
  margin: 0 0 var(--space-6) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.dept-card__cities li a {
  font-size: var(--text-sm);
  font-weight: var(--weight-medium);
  color: var(--color-atlantic);
  text-decoration: none;
}

.dept-card__cities li a:hover {
  text-decoration: underline;
}

.dept-card__cities li span {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

.dept-card__main-link {
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  text-decoration: none;
  margin-top: auto;
  padding-top: var(--space-3);
  border-top: 1px solid var(--color-border-light);
}

.dept-card__main-link:hover {
  color: var(--color-atlantic);
}
</style>
