---
/**
 * zones-intervention/seo-fougeres.astro — Local landing page for Fougères
 * URL: /zones-intervention/seo-fougeres/
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import FAQ from '../../components/FAQ.astro';
import CTA from '../../components/CTA.astro';
import { buildTitle, SITE_URL } from '../../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Zones d\'intervention', href: '/zones-intervention/' },
  { label: 'SEO Fougères', href: '/zones-intervention/seo-fougeres/' },
];

const faqFougeres = [
  {
    id: 'fougeres-interet',
    question: 'Quel est l\'intérêt du SEO pour une entreprise à Fougères ?',
    answer: 'Fougères dispose d\'un bassin de vie de plus de 55 000 habitants. Les internautes fougerais recherchent quotidiennement des prestataires fiables sur Google (artisans, experts, commerces spécialisés). Un site bien référencé localement capte cette demande directe sans frais publicitaires récurrents.',
  },
  {
    id: 'fougeres-normandie',
    question: 'Peut-on cibler à la fois Fougères et les communes proches en Normandie ou Mayenne ?',
    answer: 'Oui, c\'est un atout géographique majeur de Fougères. Nous pouvons concevoir une architecture sémantique ciblant le Pays de Fougères, mais aussi le sud-Manche (Avranches, Saint-James) et l\'ouest mayennais (Ernée).',
  },
];

const schemaFougeres = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ujjwal SEO — Consultant SEO & GEO à Fougères',
  description: 'Consultant SEO & GEO intervenant à Fougères et dans le Pays de Fougères : référencement naturel, optimisation Google Maps et visibilité IA.',
  url: `${SITE_URL}/zones-intervention/seo-fougeres/`,
  areaServed: [
    { '@type': 'City', name: 'Fougères', sameAs: 'https://www.wikidata.org/wiki/Q185145' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
  ],
};
---

<BaseLayout
  title={buildTitle('Consultant SEO & GEO à Fougères — Référencement naturel & Local')}
  description="Consultant SEO & GEO à Fougères : gagnez en visibilité sur Google et les moteurs IA. SEO local, Google Business Profile et stratégie pour les entreprises fougeraises."
  canonicalPath="/zones-intervention/seo-fougeres/"
  schema={[schemaFougeres]}
>
  <Header />

  <main id="main-content">
    <PageHero
      eyebrow="Pays de Fougères & Portes de Normandie"
      title="Consultant SEO & GEO à Fougères"
      description="Développez l'impact commercial de votre site dans le bassin fougerais : référencement local, assainissement technique et positionnement dans les moteurs de recherche nouvelle génération."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Découvrir l\'audit SEO', href: '/services/audit-seo/' }}
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <section class="section section--surface" aria-labelledby="fougeres-context-heading">
      <div class="container">
        <div class="grid-2-asym">
          <div>
            <div class="prose-header">
              <p class="eyebrow">Contexte Territorial</p>
              <h2 id="fougeres-context-heading">Fougères : tradition industrielle et renouveau économique</h2>
            </div>
            <p class="lead" style="margin-top: var(--space-4)">
              Célèbre pour son château médiéval et son histoire industrielle (chaussure, maroquinerie d'excellence, mécanique de précision, agroalimentaire et optique), le Pays de Fougères combine attractivité patrimoniale et vitalité productive.
            </p>
            <p>
              Pour les artisans, les commerçants du centre et les PME industrielles du bassin de Fougères Agglomération, le référencement naturel offre un canal d'acquisition stable et rentable, reliant votre savoir-faire aux besoins des clients du nord-est de l'Ille-et-Vilaine.
            </p>
          </div>

          <div class="local-fact-card">
            <h3>Bassin de Fougères</h3>
            <ul>
              <li><strong>Périmètre :</strong> Fougères, Lécousse, Javené, Saint-Aubin-du-Cormier, Liffré, Louvigné-du-Désert.</li>
              <li><strong>Positionnement stratégique :</strong> Porte d'entrée entre la Bretagne, la Normandie et les Pays de la Loire sur l'autoroute des Estuaires (A84).</li>
              <li><strong>Priorité SEO :</strong> Visibilité locale ciblée, réputation en ligne et référencement naturel B2B.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <FAQ items={faqFougeres} heading="Questions fréquentes sur le SEO à Fougères" />

    <CTA
      heading="Faisons grandir votre présence numérique à Fougères."
      body="Échangeons lors d'un appel découverte de 30 minutes sans engagement pour évaluer vos opportunités."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Consulter tous les services', href: '/services/' }}
      variant="navy"
    />
  </main>

  <Footer />
</BaseLayout>

<style>
.grid-2-asym {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: var(--space-12);
  align-items: center;
}

@media (max-width: 860px) {
  .grid-2-asym {
    grid-template-columns: 1fr;
  }
}

.local-fact-card {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-atlantic);
  border-radius: var(--radius-md);
  padding: var(--space-6);
}

.local-fact-card h3 {
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-3);
}

.local-fact-card ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: var(--leading-relaxed);
}
</style>
