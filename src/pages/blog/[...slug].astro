---
/**
 * blog/[...slug].astro — Dynamic blog article route
 * URL: /blog/[slug]/
 * Full design: Phase 9
 *
 * Uses Astro content collections. Each markdown file in src/content/blog/
 * automatically generates a page at /blog/[filename-without-extension]/
 */
import BlogLayout from '../../layouts/BlogLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}/`}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  featuredImage={post.data.featuredImage}
  featuredImageAlt={post.data.featuredImageAlt}
>
  <Header />
  <main id="main-content">
    <article class="blog-article">
      <div class="container">
        <header class="blog-article__header">
          <h1>{post.data.title}</h1>
          <p class="blog-article__description">{post.data.description}</p>
          <time datetime={post.data.pubDate.toISOString()}>
            {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.pubDate)}
          </time>
        </header>

        <div class="blog-article__content prose">
          <Content />
        </div>

        <!-- Related articles and services: Phase 9 -->
      </div>
    </article>
  </main>
  <Footer />
</BlogLayout>
