---
/**
 * blog/index.astro — Blog index
 * URL: /blog/
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHero from '../../components/PageHero.astro';
import { buildTitle, SITE_URL } from '../../utils/seo';
import { getCollection } from 'astro:content';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Blog SEO', href: '/blog/' },
];

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Articles published as standalone pages outside /blog/ (not in the content collection)
const standalonePosts = [
  {
    title: 'Comment apparaître sur Google Maps : le guide pour les commerces locaux',
    description:
      'Découvrez comment créer, valider et optimiser votre fiche Google Business Profile pour apparaître sur Google Maps et attirer plus de clients locaux.',
    pubDate: new Date('2026-11-12'),
    slug: 'comment-apparaitre-sur-google-maps',
    href: '/comment-apparaitre-sur-google-maps/',
    categories: ['SEO Local'],
    featuredImage: undefined as string | undefined,
    featuredImageAlt: undefined as string | undefined,
  },
];

const posts = [
  ...allPosts.map((post) => ({
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    slug: post.id.replace(/\.mdx?$/, ''),
    href: undefined as string | undefined,
    categories: post.data.categories,
    featuredImage: post.data.featuredImage,
    featuredImageAlt: post.data.featuredImageAlt,
  })),
  ...standalonePosts,
].sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

// Get unique categories
const allCategories = [...new Set(posts.flatMap((p) => p.categories))].sort();

const blogListSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog SEO — Ujjwal Lage',
  description: 'Conseils SEO, stratégies de référencement et guides pratiques pour améliorer la visibilité de votre entreprise sur Google.',
  url: `${SITE_URL}/blog/`,
  author: {
    '@type': 'Person',
    name: 'Ujjwal Lage',
    url: `${SITE_URL}/a-propos/`,
  },
};
---

<BaseLayout
  title={buildTitle('Blog SEO — Conseils et stratégies pour améliorer votre référencement')}
  description="Articles SEO par Ujjwal Lage : référencement local, SEO technique, optimisation on-page et stratégies pour améliorer votre visibilité sur Google."
  canonicalPath="/blog/"
  schema={blogListSchema}
>
  <Header />
  <main id="main-content">
    <PageHero
      visual="content"
      bgAlt=""
      eyebrow="Blog"
      title="Ressources SEO"
      description="Des guides pratiques et des stratégies concrètes pour améliorer votre référencement naturel. Écrits par un consultant SEO, pour des dirigeants qui veulent comprendre sans perdre de temps."
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <!-- Categories filter -->
    {allCategories.length > 0 && (
      <section class="blog-categories section--compact">
        <div class="container">
          <div class="categories-bar" role="group" aria-label="Filtrer par catégorie">
            <span class="categories-bar__label">Catégories :</span>
            <button type="button" class="category-pill is-active" data-filter="all" aria-pressed="true">
              Tous ({posts.length})
            </button>
            {allCategories.map((cat) => (
              <button type="button" class="category-pill" data-filter={cat} aria-pressed="false">
                {cat}
              </button>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Articles grid -->
    <section class="blog-grid section">
      <div class="container">
        {posts.length === 0 ? (
          <p class="blog-empty">Les articles seront publiés prochainement.</p>
        ) : (
          <div class="articles-grid" id="articles-grid">
            {posts.map((post) => (
              <div class="article-item" data-categories={post.categories.join('|')}>
                <BlogCard
                  title={post.title}
                  description={post.description}
                  pubDate={post.pubDate}
                  slug={post.slug}
                  href={post.href}
                  categories={post.categories}
                  featuredImage={post.featuredImage}
                  featuredImageAlt={post.featuredImageAlt}
                />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="section section--alt">
      <div class="container">
        <div class="newsletter-cta">
          <div class="newsletter-cta__text">
            <h2>Vous voulez aller plus loin ?</h2>
            <p>
              Chaque article de ce blog représente des dizaines d'heures d'expérience terrain.
              Si vous souhaitez appliquer ces stratégies à votre site, parlons-en.
            </p>
          </div>
          <div class="newsletter-cta__action">
            <a href="/reserver-un-appel/" class="btn btn--primary">Réserver un appel gratuit</a>
            <a href="/contact/" class="btn btn--outline">Demander un audit SEO</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-hero {
    padding-top: var(--space-12);
  }

  .blog-hero__eyebrow {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .blog-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-text);
    margin-bottom: var(--space-5);
  }

  .blog-hero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    max-width: 680px;
  }

  /* Categories */
  .section--compact {
    padding-top: 0;
    padding-bottom: var(--space-4);
  }

  .categories-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .categories-bar__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .category-pill {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-1) var(--space-3);
    border-radius: 100px;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .category-pill:hover,
  .category-pill.is-active {
    background: var(--color-text);
    color: white;
    border-color: var(--color-text);
  }

  .article-item {
    display: flex;
  }

  .article-item[hidden] {
    display: none;
  }

  /* Articles grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .blog-empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* Newsletter CTA */
  .newsletter-cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .newsletter-cta__text h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .newsletter-cta__text p {
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 480px;
  }

  .newsletter-cta__action {
    display: flex;
    gap: var(--space-3);
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .newsletter-cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.category-pill');
  const items = document.querySelectorAll<HTMLElement>('.article-item');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const selected = pill.dataset.filter || 'all';
      pills.forEach((p) => {
        const active = p === pill;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      });
      items.forEach((item) => {
        const cats = (item.dataset.categories || '').split('|');
        const match = selected === 'all' || cats.includes(selected);
        item.hidden = !match;
      });
    });
  });
</script>
