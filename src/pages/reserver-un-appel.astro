---
/**
 * reserver-un-appel.astro — Booking page
 * URL: /reserver-un-appel/
 * Direct 30-minute discovery call booking via WhatsApp, phone, or contact form.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import { buildTitle, SITE_URL } from '../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Réserver un appel', href: '/reserver-un-appel/' },
];

const bookingSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Appel découverte SEO & GEO — 30 minutes gratuit',
  description: 'Appel découverte de 30 minutes gratuit et sans engagement avec Ujjwal Lage, consultant SEO & GEO indépendant (Rennes, Vitré, Laval, Fougères, Janzé, Châteaubriant, Redon & France).',
  url: `${SITE_URL}/reserver-un-appel/`,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
    description: 'Appel découverte gratuit de 30 minutes',
  },
  provider: {
    '@type': 'ProfessionalService',
    '@id': `${SITE_URL}/#organization`,
    name: 'Ujjwal SEO',
    url: SITE_URL,
  },
};

const faqAppel = [
  {
    id: 'appel-gratuit',
    question: 'Cet appel de 30 minutes est-il vraiment gratuit et sans engagement ?',
    answer: 'Oui, intégralement. Cet échange initial de 30 minutes est gratuit et sans aucune obligation d\'achat. Son objectif est d\'analyser ensemble votre situation actuelle, vos objectifs commerciaux et de vérifier si une intervention SEO ou GEO est rentable pour votre entreprise.',
  },
  {
    id: 'appel-deroulement',
    question: 'Que se passe-t-il concrètement pendant les 30 minutes ?',
    answer: 'Nous regardons votre site en direct (partage d\'écran possible), vos requêtes stratégiques et vos principaux concurrents locaux ou nationaux. Je vous indique avec franchise les blocages techniques ou éditoriaux que j\'observe et les trois leviers prioritaires à activer.',
  },
  {
    id: 'appel-preparation',
    question: 'Devez-vous préparer des documents avant notre échange ?',
    answer: 'Avoir l\'URL de votre site web et une idée de vos offres prioritaires suffit. Si vous disposez déjà d\'un accès Google Search Console, nous pourrons y jeter un œil rapide ensemble, mais ce n\'est absolument pas obligatoire.',
  },
  {
    id: 'appel-suite',
    question: 'Que se passe-t-il à l\'issue de l\'appel ?',
    answer: 'Si votre besoin correspond à mon expertise, je vous transmets sous 48 heures ouvrées une proposition chiffrée et détaillée (périmètre, livrables, calendrier). Si le référencement naturel n\'est pas le bon levier pour vous aujourd\'hui, je vous le dis tout aussi franchement.',
  },
];

const etapes = [
  {
    num: '01',
    title: 'Choisissez votre canal de prise de rendez-vous',
    desc: 'Envoyez un message sur WhatsApp, appelez directement ou indiquez vos créneaux préférés via le formulaire de contact.',
  },
  {
    num: '02',
    title: 'Confirmation sous 24h ouvrées',
    desc: 'Nous validons l\'horaire ensemble et je vous envoie une invitation agenda avec le lien de visioconférence (Google Meet) ou d\'appel téléphonique.',
  },
  {
    num: '03',
    title: 'Diagnostic en direct (30 minutes)',
    desc: 'Analyse de votre site, de votre marché (Rennes, Grand Ouest ou France) et de vos opportunités SEO & GEO sans jargon.',
  },
  {
    num: '04',
    title: 'Feuille de route & proposition sous 48h',
    desc: 'Vous recevez une synthèse claire du périmètre recommandé, des livrables attendus et du budget associé.',
  },
];
---

<BaseLayout
  title={buildTitle('Réserver un appel découverte SEO & GEO — 30 min gratuit')}
  description="Réservez un appel découverte gratuit de 30 minutes avec Ujjwal Lage, consultant SEO & GEO indépendant (Rennes, Bretagne, Mayenne & France). Diagnostic direct et sans engagement."
  canonicalPath="/reserver-un-appel/"
  schema={bookingSchema}
>
  <Header />
  <main id="main-content">
    <PageHero
      visual="network"
      eyebrow="Échange initial · 30 minutes · Gratuit & sans engagement"
      title="Réservez votre appel découverte SEO & GEO"
      description="Vous souhaitez savoir pourquoi votre site stagne, comment capter plus de demandes qualifiées sur Google ou comment structurer votre présence dans les réponses IA ? Échangeons en direct pendant 30 minutes avec Ujjwal Lage."
      primaryCTA={{ label: 'Réserver via WhatsApp', href: 'https://wa.me/33757579666?text=Bonjour%20Ujjwal%2C%20je%20souhaite%20r%C3%A9server%20un%20appel%20d%C3%A9couverte%20SEO%20de%2030%20minutes.' }}
      secondaryCTA={{ label: 'Passer par le formulaire écrit', href: '/contact/' }}
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <!-- ══ CE QUE VOUS OBTENEZ PENDANT L'APPEL ══ -->
    <section class="section section--surface" aria-labelledby="booking-value-heading">
      <div class="container">
        <div class="booking-grid">
          <div class="booking-card">
            <p class="eyebrow">Ordre du jour</p>
            <h2 id="booking-value-heading">Un premier regard honnête sur votre visibilité</h2>
            <p class="booking-card__lead">
              Pas de discours commercial préfabriqué : je prépare chaque appel en inspectant votre domaine avant notre rendez-vous afin que ces 30 minutes vous soient immédiatement utiles.
            </p>
            <ul class="booking-checks">
              <li>
                <span class="booking-checks__icon" aria-hidden="true">✓</span>
                <div>
                  <strong>Pré-diagnostic de votre site actuel</strong>
                  <p>Vérification rapide de l'indexation, de la structure Hn, des performances techniques et du balisage Schema.org.</p>
                </div>
              </li>
              <li>
                <span class="booking-checks__icon" aria-hidden="true">✓</span>
                <div>
                  <strong>Analyse de votre paysage concurrentiel</strong>
                  <p>Observation des acteurs qui occupent la première page Google et le Pack Local sur vos requêtes cibles.</p>
                </div>
              </li>
              <li>
                <span class="booking-checks__icon" aria-hidden="true">✓</span>
                <div>
                  <strong>Identification du bon levier de départ</strong>
                  <p>Faut-il commencer par un <a href="/services/audit-seo/">audit SEO complet</a>, un chantier de <a href="/services/seo-local/">SEO local</a>, une refonte de <a href="/services/seo-contenu/">contenu sémantique</a> ou du <a href="/services/geo/">GEO</a> ?</p>
                </div>
              </li>
            </ul>
            <p class="booking-card__note">
              Consultez également le détail de ma <a href="/approche/">méthodologie en 8 étapes</a> et les exemples de <a href="/realisations/">livrables SEO &amp; GEO</a> avant notre appel.
            </p>
          </div>

          <div class="booking-steps">
            <h3 class="booking-steps__heading">Déroulement en 4 étapes simples</h3>
            {etapes.map((e) => (
              <div class="booking-step">
                <span class="booking-step__num">{e.num}</span>
                <div class="booking-step__content">
                  <strong>{e.title}</strong>
                  <p>{e.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══ CANAUX DE RÉSERVATION DIRECTE ══ -->
    <section class="section" aria-labelledby="channels-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Planification rapide</p>
          <h2 id="channels-heading">Choisissez le mode de réservation qui vous convient</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Vous échangez directement avec <strong>Ujjwal Lage</strong> (aucun commercial intermédiaire). Réponse garantie sous 24 heures ouvrées.
          </p>
        </div>

        <div class="channels-grid">
          <article class="channel-card channel-card--featured">
            <span class="channel-card__badge">Le plus rapide · Réponse dans la journée</span>
            <h3 class="channel-card__title">1. Réserver un créneau via WhatsApp</h3>
            <p class="channel-card__desc">
              Envoyez-moi un court message avec l'adresse de votre site et vos préférences horaires (matin ou après-midi). Nous fixons le créneau de 30 minutes immédiatement.
            </p>
            <a
              href="https://wa.me/33757579666?text=Bonjour%20Ujjwal%2C%20je%20souhaite%20r%C3%A9server%20un%20appel%20d%C3%A9couverte%20SEO%20de%2030%20minutes."
              class="btn btn--primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              Ouvrir WhatsApp (+33 7 57 57 96 66) &rarr;
            </a>
          </article>

          <article class="channel-card">
            <span class="channel-card__badge">Par écrit · Décrivez votre projet</span>
            <h3 class="channel-card__title">2. Demander un créneau via le formulaire</h3>
            <p class="channel-card__desc">
              Précisez l'URL de votre site, votre secteur d'activité et votre objectif principal dans le formulaire de contact. Je vous réponds par email sous 24h avec 3 propositions de créneaux.
            </p>
            <a href="/contact/" class="btn btn--secondary">
              Accéder au formulaire de contact &rarr;
            </a>
          </article>

          <article class="channel-card">
            <span class="channel-card__badge">Ligne directe · Lundi au vendredi</span>
            <h3 class="channel-card__title">3. Appel téléphonique ou email direct</h3>
            <p class="channel-card__desc">
              Vous préférez appeler directement ou envoyer un email depuis votre messagerie professionnelle ? Utilisez mes coordonnées directes ci-dessous :
            </p>
            <div class="channel-card__contacts">
              <a href="tel:+33757579666" class="channel-contact-link">📞 +33 7 57 57 96 66</a>
              <a href="mailto:contact@ujjwal-seo.com" class="channel-contact-link">✉️ contact@ujjwal-seo.com</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <FAQ items={faqAppel} heading="Questions fréquentes sur l'appel découverte" />
  </main>
  <Footer />
</BaseLayout>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (max-width: 900px) {
    .booking-grid {
      grid-template-columns: 1fr;
    }
  }

  .booking-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-xs);
  }

  .booking-card h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .booking-card__lead {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-6);
  }

  .booking-checks {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .booking-checks li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
  }

  .booking-checks__icon {
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: rgba(57, 123, 155, 0.14);
    color: var(--color-atlantic);
    font-weight: var(--weight-bold);
    font-size: var(--text-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .booking-checks strong {
    display: block;
    color: var(--color-navy);
    font-size: var(--text-base);
    margin-bottom: 2px;
  }

  .booking-checks p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .booking-card__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-light);
  }

  .booking-steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .booking-steps__heading {
    font-size: var(--text-lg);
    color: var(--color-navy);
    margin-bottom: var(--space-2);
  }

  .booking-step {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }

  .booking-step__num {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    color: var(--color-atlantic);
    background: var(--color-surface);
    padding: 0.25rem 0.55rem;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .booking-step__content strong {
    display: block;
    font-size: var(--text-base);
    color: var(--color-navy);
    margin-bottom: 4px;
  }

  .booking-step__content p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  @media (max-width: 920px) {
    .channels-grid {
      grid-template-columns: 1fr;
    }
  }

  .channel-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .channel-card--featured {
    border-color: var(--color-atlantic);
    box-shadow: var(--shadow-md);
    background: linear-gradient(180deg, #FFFFFF 0%, #F7F8F5 100%);
  }

  .channel-card__badge {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-atlantic);
    background: var(--color-surface);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }

  .channel-card__title {
    font-size: var(--text-xl);
    color: var(--color-navy);
    margin: 0;
  }

  .channel-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    flex: 1;
  }

  .channel-card__contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-2);
  }

  .channel-contact-link {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-navy);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
  }

  .channel-contact-link:hover {
    border-color: var(--color-atlantic);
    color: var(--color-atlantic);
  }
</style>
