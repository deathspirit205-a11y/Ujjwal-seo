---
/**
 * seo-bretagne.astro — Regional landing page for Brittany
 * URL: /seo-bretagne/
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { buildTitle, SITE_URL } from '../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Consultant SEO Bretagne', href: '/seo-bretagne/' },
];

const faqBretagne = [
  {
    id: 'bretagne-zone',
    question: 'Travaillez-vous dans toute la Bretagne ?',
    answer: 'Oui. Basé à Rennes, je travaille avec des entreprises dans tout le Grand Ouest : Ille-et-Vilaine, Finistère, Morbihan, Côtes-d\'Armor, Loire-Atlantique. Le travail SEO étant largement réalisable à distance, la localisation n\'est pas un frein.',
  },
  {
    id: 'bretagne-experience',
    question: 'Avez-vous de l\'expérience avec des entreprises bretonnes ?',
    answer: 'Oui. Je connais le tissu économique breton — tourisme côtier, agroalimentaire, industrie nautique, artisanat — et adapte ma stratégie SEO aux spécificités de chaque secteur et de chaque ville.',
  },
  {
    id: 'bretagne-petites-villes',
    question: 'Le SEO local fonctionne-t-il pour les petites villes bretonnes ?',
    answer: 'Absolument. Dans une ville de taille moyenne (Quimper, Lorient, Brest, Vannes…), la concurrence SEO est moins intense qu\'à Paris ou Rennes. Un bon référencement local peut vous placer en tête très rapidement.',
  },
  {
    id: 'bretagne-echanges-distance',
    question: 'Comment se passent les échanges si je ne suis pas à Rennes ?',
    answer: 'Tout se fait à distance, par visioconférence et e-mail. Je fournis des rapports mensuels clairs et suis disponible pour des points réguliers. Certains clients préfèrent même ce mode de travail à des réunions en présentiel.',
  },
];

const bretagneSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ujjwal SEO — Consultant SEO Bretagne',
  description: 'Consultant SEO indépendant en Bretagne. Référencement naturel, SEO local et audit SEO pour les entreprises bretonnes.',
  url: `${SITE_URL}/seo-bretagne/`,
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
    { '@type': 'AdministrativeArea', name: 'Finistère' },
    { '@type': 'AdministrativeArea', name: 'Morbihan' },
    { '@type': 'AdministrativeArea', name: "Côtes-d'Armor" },
  ],
};

const villes = [
  { name: 'Rennes', href: '/seo-rennes/', cta: true },
  { name: 'Brest', href: null },
  { name: 'Quimper', href: null },
  { name: 'Lorient', href: null },
  { name: 'Vannes', href: null },
  { name: 'Saint-Malo', href: null },
  { name: 'Saint-Brieuc', href: null },
  { name: 'Quimper', href: null },
  { name: 'Pontivy', href: null },
  { name: 'Morlaix', href: null },
  { name: 'Lannion', href: null },
  { name: 'Dinan', href: null },
  { name: 'Fougères', href: null },
  { name: 'Vitré', href: null },
  { name: 'Redon', href: null },
  { name: 'Concarneau', href: null },
];

const secteurs = [
  { icon: '🏖️', name: 'Tourisme & hôtellerie', description: 'Hôtels, gîtes, campings, activités nautiques — captez les recherches saisonnières.' },
  { icon: '🍞', name: 'Agroalimentaire & artisans', description: 'Producteurs locaux, boulangeries, crêperies — valorisez votre ancrage breton sur Google.' },
  { icon: '⚓', name: 'Nautisme & industrie maritime', description: 'Chantiers navals, loueurs de bateaux, marinas — un secteur à fort potentiel SEO.' },
  { icon: '🏗️', name: 'BTP & artisanat', description: 'Plombiers, électriciens, couvreurs — dominez les recherches locales dans votre ville.' },
  { icon: '💊', name: 'Santé & bien-être', description: 'Médecins, kinés, ostéopathes, centres de soins — attirez des patients locaux qualifiés.' },
  { icon: '⚖️', name: 'Services professionnels', description: 'Avocats, experts-comptables, consultants — établissez votre autorité en ligne en Bretagne.' },
];
---

<BaseLayout
  title={buildTitle('Consultant SEO Bretagne — Référencement naturel en Bretagne')}
  description="Consultant SEO en Bretagne : améliorez durablement votre visibilité sur Google. SEO local, SEO technique et audit SEO pour les entreprises de Bretagne (Rennes, Brest, Lorient, Vannes, Quimper)."
  canonicalPath="/seo-bretagne/"
  schema={bretagneSchema}
>
  <Header />
  <main id="main-content">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero -->
    <section class="local-hero">
      <div class="container">
        <div class="local-hero__badge">🌊 Bretagne — Grand Ouest</div>
        <h1 class="local-hero__title">Consultant SEO<br /><span class="accent">en Bretagne</span></h1>
        <p class="local-hero__lead">
          Votre entreprise bretonne mérite d'être visible sur Google. Basé à Rennes,
          j'accompagne les TPE et PME de toute la Bretagne dans leur développement
          SEO — du référencement local à la stratégie de contenu longue durée.
        </p>
        <div class="local-hero__actions">
          <a href="/reserver-un-appel/" class="btn btn--primary">Réserver un appel gratuit</a>
          <a href="/services/" class="btn btn--outline">Voir mes services</a>
        </div>
        <p class="local-hero__reassurance">
          ✓ Appel de 30 min gratuit et sans engagement &nbsp;·&nbsp; ✓ Travail à distance dans toute la Bretagne
        </p>
      </div>
    </section>

    <!-- Secteurs -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">SEO adapté aux secteurs bretons</h2>
        <p class="section-subtitle">
          La Bretagne a ses spécificités économiques. Je les connais et j'adapte ma stratégie SEO en conséquence.
        </p>
        <div class="secteurs-grid">
          {secteurs.map((s) => (
            <article class="secteur-card">
              <span class="secteur-card__icon" aria-hidden="true">{s.icon}</span>
              <h3 class="secteur-card__title">{s.name}</h3>
              <p class="secteur-card__desc">{s.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Pourquoi consultant indépendant -->
    <section class="section section--alt">
      <div class="container">
        <div class="why-grid">
          <div class="why-text">
            <h2>Pourquoi choisir un consultant indépendant pour votre SEO en Bretagne ?</h2>
            <p>
              Les agences SEO généralistes traitent des dizaines de clients simultanément.
              Avec moi, vous avez un interlocuteur unique, disponible, qui suit votre dossier
              de A à Z — de l'audit initial aux optimisations mensuelles.
            </p>
            <ul class="why-list">
              <li>
                <span class="why-list__check">✓</span>
                <div>
                  <strong>Pas d'intermédiaire</strong> — Vous travaillez directement avec la
                  personne qui optimise votre site.
                </div>
              </li>
              <li>
                <span class="why-list__check">✓</span>
                <div>
                  <strong>Connaissance du terrain breton</strong> — Basé à Rennes, je comprends
                  les dynamiques locales de chaque département breton.
                </div>
              </li>
              <li>
                <span class="why-list__check">✓</span>
                <div>
                  <strong>Tarifs transparents</strong> — Pas de frais cachés ni de packages
                  inutiles. Vous payez pour ce dont vous avez réellement besoin.
                </div>
              </li>
              <li>
                <span class="why-list__check">✓</span>
                <div>
                  <strong>Résultats mesurables</strong> — Reporting mensuel clair avec les
                  positions, le trafic organique et les objectifs atteints.
                </div>
              </li>
            </ul>
          </div>
          <div class="why-visual">
            <div class="comparison-card">
              <div class="comparison-card__header">Agence SEO généraliste</div>
              <ul class="comparison-list comparison-list--minus">
                <li>Gestionnaire de compte tournant</li>
                <li>Contrat annuel rigide</li>
                <li>Reporting automatisé peu personnalisé</li>
                <li>Connaissance limitée du marché local</li>
              </ul>
            </div>
            <div class="comparison-card comparison-card--highlight">
              <div class="comparison-card__header">Ujjwal SEO</div>
              <ul class="comparison-list comparison-list--plus">
                <li>Interlocuteur unique du début à la fin</li>
                <li>Engagement flexible, mois par mois</li>
                <li>Reporting personnalisé et commenté</li>
                <li>Ancré dans l'écosystème breton</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Villes -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Villes où j'interviens en Bretagne</h2>
        <div class="villes-grid">
          {villes.map((v) => (
            v.cta
              ? <a href={v.href!} class="ville-card ville-card--featured">{v.name} <span>→</span></a>
              : <span class="ville-card">{v.name}</span>
          ))}
        </div>
        <p class="villes-note">
          Votre ville ne figure pas dans la liste ? Pas de problème — je travaille avec
          n'importe quelle entreprise en France. <a href="/contact/">Contactez-moi.</a>
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section section--alt">
      <div class="container">
        <h2 class="section-title">Questions fréquentes</h2>
        <FAQ items={faqBretagne} />
      </div>
    </section>

    <CTA
      title="Votre entreprise bretonne mérite d'être en tête de Google"
      description="Parlons de votre projet lors d'un appel découverte de 30 minutes, gratuit et sans engagement."
      primaryLabel="Réserver un appel gratuit"
      primaryHref="/reserver-un-appel/"
      secondaryLabel="Voir mes services"
      secondaryHref="/services/"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .local-hero {
    background: linear-gradient(135deg, #0f1f3d 0%, #1a3a5c 100%);
    color: white;
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
  }

  .local-hero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: var(--space-2) var(--space-4);
    border-radius: 100px;
    font-size: var(--text-sm);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-6);
  }

  .local-hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-6);
    color: white;
  }

  .local-hero__title .accent { color: var(--color-accent); }

  .local-hero__lead {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.85);
    max-width: 680px;
    margin: 0 auto var(--space-8);
    line-height: 1.7;
  }

  .local-hero__actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .local-hero__reassurance {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  /* Secteurs */
  .secteurs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .secteur-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .secteur-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .secteur-card__icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--space-3);
  }

  .secteur-card__title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .secteur-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Why section */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .why-text h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .why-text > p {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-6);
  }

  .why-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .why-list li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .why-list__check {
    color: var(--color-accent);
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .why-list strong {
    display: block;
    color: var(--color-text);
    margin-bottom: 2px;
  }

  .why-list div {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Comparison */
  .why-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .comparison-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .comparison-card--highlight {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px rgba(79, 150, 100, 0.15);
  }

  .comparison-card__header {
    padding: var(--space-3) var(--space-5);
    font-weight: 600;
    font-size: var(--text-sm);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .comparison-card--highlight .comparison-card__header {
    background: var(--color-accent);
    color: white;
    border-bottom-color: var(--color-accent);
  }

  .comparison-list {
    list-style: none;
    padding: var(--space-4) var(--space-5);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .comparison-list li {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    padding-left: var(--space-5);
    position: relative;
  }

  .comparison-list--minus li::before {
    content: '✗';
    position: absolute;
    left: 0;
    color: #e44;
  }

  .comparison-list--plus li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  /* Villes */
  .villes-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-8) 0;
  }

  .ville-card {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: var(--text-sm);
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  a.ville-card:hover {
    background: var(--color-text);
    color: white;
    border-color: var(--color-text);
  }

  .ville-card--featured {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
    font-weight: 600;
  }

  .villes-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .villes-note a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .why-grid { grid-template-columns: 1fr; }
  }
</style>
