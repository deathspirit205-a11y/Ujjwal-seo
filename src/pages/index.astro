---
/**
 * index.astro — Homepage
 * URL: /
 * H1: Consultant SEO & GEO
 *
 * Information Architecture:
 *  01. Hero (SearchLandscapeHero) + CommitmentBand (animated offer facts)
 *  02. SEO vs GEO — interactive comparison (SerpVsAi)
 *  03. "Comment votre entreprise est comprise" (EntityDiagram)
 *  04. Services SEO & GEO (6 expertises claires)
 *  05. Méthode en 5 étapes (MethodTimeline)
 *  06. Ce que je refuse de faire (navy band + portrait)
 *  07. Zones d'intervention (Bretagne, Pays de la Loire & France à distance)
 *  08. Blog & Ressources
 *  09. FAQ
 *  10. CTA Final
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchLandscapeHero from '../components/SearchLandscapeHero.astro';
import CommitmentBand from '../components/CommitmentBand.astro';
import SerpVsAi from '../components/SerpVsAi.astro';
import EntityDiagram from '../components/EntityDiagram.astro';
import ServiceCard from '../components/ServiceCard.astro';
import MethodTimeline from '../components/MethodTimeline.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import BlogCard from '../components/BlogCard.astro';
import { buildTitle, SITE_URL } from '../utils/seo';
import { services } from '../data/services';
import { faqGeneral } from '../data/faq';
import { getCollection } from 'astro:content';

// Fetch latest published blog posts (max 3 for homepage)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// 5-step methodology — short, scannable, with indicative timing
const processSteps = [
  {
    title: 'Comprendre',
    when: 'Semaine 1',
    description: 'Votre marché, vos marges, vos concurrents et ce que vos clients tapent vraiment.',
  },
  {
    title: 'Structurer',
    when: 'Semaines 2–3',
    description: 'Architecture, maillage interne et entités : des fondations que Google comprend.',
  },
  {
    title: 'Optimiser',
    when: 'Semaines 3–6',
    description: 'Blocages techniques levés, pages clés réécrites, Schema.org en place.',
  },
  {
    title: 'Développer',
    when: 'Mois 2–6',
    description: 'Contenus qui répondent aux vraies questions et construisent votre autorité.',
  },
  {
    title: 'Mesurer',
    when: 'Chaque mois',
    description: 'Search Console, positions, leads : ce qui progresse, ce qu\'on ajuste.',
  },
];

// "What I refuse to do" — confident positioning, replaces repeated generic claims
const refusals = [
  {
    title: 'Promettre des positions miracles',
    text: 'Aucun consultant sérieux ne contrôle l\'algorithme de Google. Mon engagement repose sur une méthode rigoureuse, des fondations techniques solides et une croissance mesurable et pérenne.',
  },
  {
    title: 'Acheter des liens',
    text: 'Les liens achetés finissent par coûter plus cher qu\'ils ne rapportent. L\'autorité se mérite.',
  },
  {
    title: 'Vous noyer sous des rapports',
    text: 'Pas de PDF de 80 pages illisible. Une liste priorisée : quoi faire, dans quel ordre, pourquoi.',
  },
  {
    title: 'Déléguer votre dossier',
    text: 'Celui qui audite est celui qui recommande, applique et vous répond. Toujours.',
  },
];

// Organization + WebSite schema
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#organization`,
  name: 'Ujjwal SEO',
  description: 'Consultant SEO & GEO indépendant en France. Accompagnement en référencement naturel, optimisation technique, sémantique et visibilité dans les moteurs de recherche IA.',
  url: SITE_URL,
  founder: {
    '@type': 'Person',
    '@id': `${SITE_URL}/a-propos/#person`,
    name: 'Ujjwal Lage',
    jobTitle: 'Consultant SEO & GEO indépendant',
    url: `${SITE_URL}/a-propos/`,
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
    { '@type': 'AdministrativeArea', name: 'Pays de la Loire' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
  ],
  knowsAbout: [
    'SEO',
    'GEO - Generative Engine Optimization',
    'Référencement naturel',
    'SEO technique',
    'SEO sémantique',
    'SEO local',
    'Audit SEO',
    'Données structurées Schema.org',
    'Moteurs de réponse IA',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Ujjwal SEO',
  url: SITE_URL,
  publisher: {
    '@id': `${SITE_URL}/#organization`,
  },
};
---

<BaseLayout
  title={buildTitle('Consultant SEO & GEO — Visibilité Moteurs & Recherche IA', false)}
  description="Consultant SEO & GEO indépendant en France. J'aide les entreprises à devenir plus visibles et compréhensibles dans les moteurs de recherche et les espaces de réponse IA."
  canonicalPath="/"
  schema={[professionalServiceSchema, websiteSchema]}
>
  <Header />

  <main id="main-content">

    <!-- ══════════════════════════════════════
         01. HERO (Search Landscape System)
    ══════════════════════════════════════ -->
    <SearchLandscapeHero
      eyebrow="Consultant SEO & GEO indépendant"
      heading="Consultant SEO & GEO"
      subheading="Google ne se contente plus de classer des pages : il cherche à comprendre qui vous êtes. Mon travail consiste à rendre votre entreprise évidente, crédible et citée, sur Google comme dans les réponses des IA."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Voir ma méthode', href: '/approche/' }}
    />

    <!-- Concrete commitments band (animated) -->
    <CommitmentBand />

    <!-- ══════════════════════════════════════
         02. SEO + GEO : INTERACTIVE COMPARISON
    ══════════════════════════════════════ -->
    <section class="duo-section section section--surface" aria-labelledby="duo-heading">
      <div class="container">
        <div class="section-header--centered reveal">
          <p class="eyebrow">La recherche a changé</p>
          <h2 id="duo-heading">Hier, il fallait être <span class="mark">classé</span>. Aujourd'hui, il faut aussi être <span class="mark">cité</span>.</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Même requête, deux façons de répondre. Cliquez pour comparer.
          </p>
        </div>

        <SerpVsAi query="consultant SEO Rennes" />

        <div class="duo-summary reveal">
          <div class="duo-summary__inner">
            <div class="duo-summary__icon" aria-hidden="true">&bull;&bull;&bull;</div>
            <p class="duo-summary__text">
              <strong>Le GEO ne remplace pas le SEO, il le prolonge.</strong> Les IA puisent dans ce que Google comprend déjà de vous. Sans fondations solides, pas de citation.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         03. COMMENT VOTRE ENTREPRISE EST COMPRISE
    ══════════════════════════════════════ -->
    <EntityDiagram />

    <!-- ══════════════════════════════════════
         04. SERVICES (6 EXPERTISES)
    ══════════════════════════════════════ -->
    <section class="home-services section" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Domaines d'intervention</p>
          <h2 id="services-heading">Six leviers. Un seul objectif : <span class="mark">être choisi</span>.</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Technique, contenu, local ou IA : on commence par ce qui bloque le plus, pas par ce qui se vend le mieux.
          </p>
        </div>

        <div class="grid-auto">
          {services.map((service, i) => (
            <ServiceCard
              title={service.title}
              slug={service.slug}
              description={service.shortDescription}
              category={service.category}
              deliverables={service.deliverables}
              index={i + 1}
            />
          ))}
        </div>

        <div class="home-services__footer">
          <a href="/services/" class="btn btn--secondary">
            Explorer le détail de tous les services &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         05. PROCESSUS (5 ÉTAPES)
    ══════════════════════════════════════ -->
    <MethodTimeline
      steps={processSteps}
      heading="De l'analyse aux résultats, sans zone grise"
      subheading="Vous savez à chaque étape ce qui est fait, pourquoi, et ce que ça change."
    />

    <!-- ══════════════════════════════════════
         06. CE QUE JE REFUSE DE FAIRE (confident positioning)
    ══════════════════════════════════════ -->
    <section class="refuse section section--navy" aria-labelledby="refuse-heading">
      <div class="container">
        <div class="refuse__grid">
          <div class="refuse__content">
            <p class="eyebrow reveal">Ma ligne de conduite</p>
            <h2 id="refuse-heading" class="reveal">Ce que je refuse de faire. Et pourquoi c'est une bonne nouvelle pour vous.</h2>

            <ul class="refuse__list" role="list">
              {refusals.map((r, i) => (
                <li class={`refuse__item reveal reveal-delay-${Math.min(i, 3)}`}>
                  <span class="refuse__icon" aria-hidden="true">✕</span>
                  <div>
                    <h3 class="refuse__title">{r.title}</h3>
                    <p class="refuse__text">{r.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <figure class="refuse__portrait reveal reveal-delay-2">
            <img
              src="/assets/ujjwal-lage-portrait.jpg"
              alt="Ujjwal Lage, consultant SEO & GEO indépendant"
              width="682"
              height="1024"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="refuse__caption">
              <span class="refuse__name">Ujjwal Lage</span>
              <span class="refuse__role">Consultant SEO &amp; GEO · Ille-et-Vilaine</span>
              <span class="refuse__quote">« Je préfère vous dire non que vous vendre une promesse que je ne peux pas tenir. »</span>
              <div class="refuse__actions">
                <a href="/contact/" class="btn btn--accent">Échanger sur vos enjeux</a>
                <a href="/a-propos/" class="refuse__link">Mon parcours &rarr;</a>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         07. ZONES D'INTERVENTION PREVIEW
    ══════════════════════════════════════ -->
    <section class="home-zones section" aria-labelledby="zones-heading">
      <div class="container">
        <div class="home-zones__wrapper">
          <div class="home-zones__header">
            <p class="eyebrow">Rayonnement Géographique</p>
            <h2 id="zones-heading">De la Bretagne aux Pays de la Loire, et partout en France</h2>
            <p class="lead" style="margin-top: var(--space-4)">
              <strong>Local quand l'ancrage territorial compte. À distance quand la localisation n'a pas d'importance.</strong> J'accompagne des entreprises locales, des PME régionales et des acteurs à rayonnement national.
            </p>
          </div>

          <div class="home-zones__grid">
            <div class="zone-pill-card">
              <span class="zone-pill-card__tag">Région Ouest</span>
              <h3 class="zone-pill-card__title">Bretagne</h3>
              <p class="zone-pill-card__desc">Rennes, Saint-Malo, Fougères, Vitré, Janzé, Saint-Brieuc, Vannes, Lorient, Brest.</p>
              <a href="/zones-intervention/bretagne/" class="zone-pill-card__link">Découvrir le réseau Bretagne &rarr;</a>
            </div>

            <div class="zone-pill-card">
              <span class="zone-pill-card__tag">Région Ouest</span>
              <h3 class="zone-pill-card__title">Pays de la Loire</h3>
              <p class="zone-pill-card__desc">Laval, Mayenne, Château-Gontier, Nantes, Châteaubriant, Angers, Segré.</p>
              <a href="/zones-intervention/mayenne/" class="zone-pill-card__link">Découvrir le réseau Pays de la Loire &rarr;</a>
            </div>

            <div class="zone-pill-card zone-pill-card--highlight">
              <span class="zone-pill-card__tag">National</span>
              <h3 class="zone-pill-card__title">France entière (à distance)</h3>
              <p class="zone-pill-card__desc">Accompagnement SEO & GEO via visioconférences régulières, tableaux de bord partagés et collaboration fluide.</p>
              <a href="/contact/" class="zone-pill-card__link">Prendre contact pour un projet &rarr;</a>
            </div>
          </div>

          <div class="home-zones__cta">
            <a href="/zones-intervention/" class="btn btn--primary">
              Consulter la carte interactive des zones d'intervention &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         08. BLOG (ARTICLES & RESSOURCES)
    ══════════════════════════════════════ -->
    <section class="home-blog section section--surface" aria-labelledby="blog-heading">
      <div class="container">
        <div class="section-header">
          <div class="home-blog__header-row">
            <div>
              <p class="eyebrow">Publications & Analyses</p>
              <h2 id="blog-heading">Dernières réflexions SEO & GEO</h2>
            </div>
            <a href="/blog/" class="btn btn--secondary home-blog__all-link">
              Tous les articles &rarr;
            </a>
          </div>
          <p class="lead" style="margin-top: var(--space-4)">
            Des guides pédagogiques, des analyses techniques et des réflexions concrètes sur l'évolution de la recherche web et des intelligences artificielles.
          </p>
        </div>

        {latestPosts.length > 0 ? (
          <div class="grid-3">
            {latestPosts.map((post) => {
              const slug = post.id.replace(/\.mdx?$/, '');
              return (
                <BlogCard
                  title={post.data.title}
                  slug={slug}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  featuredImage={post.data.featuredImage}
                  featuredImageAlt={post.data.featuredImageAlt}
                  categories={post.data.categories}
                />
              );
            })}
          </div>
        ) : (
          <div class="home-blog__empty">
            <p>
              Les articles d'analyse sont consultables dans l'espace <a href="/blog/">Blog</a>.
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- ══════════════════════════════════════
         09. FAQ
    ══════════════════════════════════════ -->
    <FAQ items={faqGeneral} heading="Questions fréquentes sur le SEO & le GEO" />

    <!-- ══════════════════════════════════════
         10. CTA FINAL
    ══════════════════════════════════════ -->
    <CTA
      heading="Construisons une visibilité durable pour votre entreprise."
      body="Échangeons pendant 30 minutes sur vos enjeux actuels, votre concurrence et les opportunités de positionnement sur Google et les moteurs IA. Échange direct, sans engagement."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Découvrir mon approche', href: '/approche/' }}
      variant="navy"
    />

  </main>

  <Footer />
</BaseLayout>

<style>
/* ══ REFUSE SECTION (navy band) ══ */
.refuse__grid {
  display: grid;
  grid-template-columns: 1.3fr 0.7fr;
  gap: var(--space-12);
  align-items: center;
}

@media (max-width: 900px) {
  .refuse__grid { grid-template-columns: 1fr; }
}

.refuse__content h2 {
  max-width: 34rem;
  margin-bottom: var(--space-10);
}

.refuse__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
}

@media (max-width: 640px) {
  .refuse__list { grid-template-columns: 1fr; }
}

.refuse__item {
  display: flex;
  gap: var(--space-4);
  padding: var(--space-5);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: var(--radius-lg);
  transition: border-color var(--transition-base), background var(--transition-base);
}

.refuse__item:hover {
  border-color: rgba(245, 158, 11, 0.5);
  background: rgba(255, 255, 255, 0.07);
}

.refuse__icon {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(245, 158, 11, 0.15);
  color: var(--color-highlight);
  font-size: 0.8rem;
  font-weight: var(--weight-bold);
}

.refuse__title {
  font-family: var(--font-sans);
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  margin-bottom: var(--space-1);
}

.refuse__text {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.7);
  line-height: var(--leading-normal);
  margin: 0;
}

.refuse__portrait {
  margin: 0;
  position: relative;
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.refuse__portrait img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  object-position: center 15%;
  display: block;
}

.refuse__caption {
  position: absolute;
  inset: auto 0 0 0;
  padding: var(--space-16) var(--space-5) var(--space-5);
  background: linear-gradient(transparent, rgba(11, 19, 43, 0.92) 45%);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.refuse__name {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: #FFFFFF;
}

.refuse__role {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.65);
}

.refuse__quote {
  margin-top: var(--space-3);
  font-family: var(--font-serif);
  font-style: italic;
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.9);
  line-height: var(--leading-snug);
}

.refuse__actions {
  margin-top: var(--space-4);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.refuse__link {
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: #FFFFFF;
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* ══ DUO SUMMARY ══ */
.duo-summary {
  margin-top: var(--space-8);
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-navy);
  border-radius: var(--radius-sm);
  padding: var(--space-6);
}

.duo-summary__inner {
  display: flex;
  gap: var(--space-4);
  align-items: center;
}

.duo-summary__icon {
  color: var(--color-atlantic);
  letter-spacing: 0.2em;
  font-size: 1.25rem;
  flex-shrink: 0;
}

.duo-summary__text {
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: var(--leading-relaxed);
  margin: 0;
}

/* ══ SERVICES FOOTER ══ */
.home-services__footer {
  margin-top: var(--space-12);
  text-align: center;
}

/* ══ HOME ZONES PREVIEW ══ */
.home-zones__wrapper {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--space-12) var(--space-8);
}

.home-zones__header {
  text-align: center;
  max-width: 44rem;
  margin: 0 auto var(--space-10) auto;
}

.home-zones__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
  margin-bottom: var(--space-10);
}

@media (max-width: 860px) {
  .home-zones__grid {
    grid-template-columns: 1fr;
  }
}

.zone-pill-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
}

.zone-pill-card--highlight {
  border-color: rgba(37, 99, 235, 0.35);
  background: rgba(37, 99, 235, 0.02);
}

.zone-pill-card__tag {
  font-size: 0.7rem;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.zone-pill-card__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-2);
}

.zone-pill-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-4);
}

.zone-pill-card__link {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: var(--color-atlantic);
  text-decoration: none;
  margin-top: auto;
}

.zone-pill-card__link:hover {
  text-decoration: underline;
}

.home-zones__cta {
  text-align: center;
}

/* ══ BLOG SECTION ══ */
.home-blog__header-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-4);
  flex-wrap: wrap;
}

.home-blog__empty {
  padding: var(--space-8);
  text-align: center;
  background: #FFFFFF;
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
}
</style>
