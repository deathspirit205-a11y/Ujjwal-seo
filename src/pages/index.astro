---
/**
 * index.astro — Homepage
 * URL: /
 * H1: Consultant SEO à Rennes et en Bretagne (spec §9)
 *
 * Sections (spec §9):
 *  1. Hero
 *  2. Problèmes clients
 *  3. Services
 *  4. Processus
 *  5. Pourquoi Ujjwal SEO
 *  6. Zones géographiques
 *  7. Réalisations (transparent — pas de faux résultats)
 *  8. Blog (récents articles, vide pour l'instant)
 *  9. FAQ
 * 10. CTA final
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/HomeHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import BlogCard from '../components/BlogCard.astro';
import { buildTitle, SITE_URL } from '../utils/seo';
import { services } from '../data/services';
import { faqGeneral } from '../data/faq';
import { getCollection } from 'astro:content';

// Fetch latest published blog posts (max 3 for homepage)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Process steps per spec §9
const processSteps = [
  {
    number: 1,
    title: 'Analyse',
    description: 'Audit de votre site, de votre positionnement actuel et de vos concurrents pour établir un état des lieux précis.',
  },
  {
    number: 2,
    title: 'Stratégie',
    description: 'Définition des priorités, des mots-clés cibles et des axes d\'optimisation en fonction de vos objectifs.',
  },
  {
    number: 3,
    title: 'Optimisation',
    description: 'Correction des problèmes techniques, amélioration de l\'architecture et de l\'expérience utilisateur.',
  },
  {
    number: 4,
    title: 'Contenu',
    description: 'Création et optimisation des pages et articles pour répondre aux intentions de recherche de vos clients.',
  },
  {
    number: 5,
    title: 'Mesure',
    description: 'Suivi régulier des positions, du trafic organique et des conversions pour évaluer les progrès.',
  },
  {
    number: 6,
    title: 'Amélioration',
    description: 'Ajustement continu de la stratégie selon les données réelles et l\'évolution de votre marché.',
  },
];

// Homepage-specific FAQ items
const homeFAQ = faqGeneral;

// Organization + WebSite schema
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ujjwal SEO',
  description: 'Consultant SEO indépendant à Rennes et en Bretagne. SEO local, SEO technique, audit SEO et accompagnement SEO.',
  url: SITE_URL,
  areaServed: [
    { '@type': 'City', name: 'Rennes' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
    { '@type': 'Country', name: 'France' },
  ],
  founder: {
    '@type': 'Person',
    name: 'Ujjwal Lage',
    jobTitle: 'Consultant SEO indépendant',
    url: `${SITE_URL}/a-propos/`,
  },
  knowsAbout: [
    'SEO local', 'Référencement naturel', 'SEO technique', 'Audit SEO',
    'Optimisation on-page', 'Google Business Profile', 'Core Web Vitals',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ujjwal SEO',
  url: SITE_URL,
};
---

<BaseLayout
  title={buildTitle('Consultant SEO à Rennes et en Bretagne', true)}
  description="Ujjwal SEO — Consultant SEO indépendant à Rennes et en Bretagne. Améliorez votre visibilité sur Google grâce à une stratégie SEO claire, technique et adaptée à votre activité."
  canonicalPath="/"
  schema={[organizationSchema, websiteSchema]}
>
  <Header />

  <main id="main-content">

    <!-- ══════════════════════════════════════
         1. HERO
    ══════════════════════════════════════ -->
    <HomeHero
      eyebrow="Consultant SEO indépendant"
      heading='Consultant SEO à<br /><em>Rennes</em> et en <em>Bretagne</em>'
      subheading="Améliorez votre visibilité sur Google grâce à une stratégie SEO claire, technique et adaptée à votre activité. SEO local, SEO technique, optimisation on-page et accompagnement pour les entreprises à Rennes et en Bretagne."
      primaryCTA={{ label: 'Demander un audit SEO', href: '/contact/' }}
      secondaryCTA={{ label: 'Réserver un appel', href: '/reserver-un-appel/' }}
      trustItems={['Sans jargon inutile', 'Approche orientée résultats', 'Premier échange gratuit']}
    />


    <!-- ══════════════════════════════════════
         2. PROBLÈMES CLIENTS
    ══════════════════════════════════════ -->
    <section class="problems section section--surface" aria-labelledby="problems-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Vous vous reconnaissez ?</p>
          <h2 id="problems-heading">Les problèmes SEO les plus fréquents</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            La plupart des entreprises locales rencontrent les mêmes obstacles sur Google.
            Ces problèmes se résolvent avec une stratégie SEO structurée.
          </p>
        </div>

        <ul class="problems__grid" role="list">
          <li class="problem-card">
            <span class="problem-card__icon" aria-hidden="true">👁️</span>
            <div>
              <h3 class="problem-card__title">Site invisible sur Google</h3>
              <p class="problem-card__desc">
                Vos clients cherchent vos services en ligne, mais c'est toujours votre concurrent
                qui apparaît en premier.
              </p>
            </div>
          </li>
          <li class="problem-card">
            <span class="problem-card__icon" aria-hidden="true">📍</span>
            <div>
              <h3 class="problem-card__title">Faible visibilité locale</h3>
              <p class="problem-card__desc">
                Votre fiche Google Business Profile est incomplète ou mal optimisée,
                et vous n'apparaissez pas dans les recherches locales.
              </p>
            </div>
          </li>
          <li class="problem-card">
            <span class="problem-card__icon" aria-hidden="true">⚙️</span>
            <div>
              <h3 class="problem-card__title">Problèmes techniques non détectés</h3>
              <p class="problem-card__desc">
                Des erreurs d'indexation, une vitesse insuffisante ou une mauvaise
                architecture pénalisent votre référencement sans que vous le sachiez.
              </p>
            </div>
          </li>
          <li class="problem-card">
            <span class="problem-card__icon" aria-hidden="true">🔑</span>
            <div>
              <h3 class="problem-card__title">Pas de stratégie de mots-clés</h3>
              <p class="problem-card__desc">
                Vos pages ne ciblent pas les bons termes de recherche, ou visent
                des mots-clés trop compétitifs sans potentiel réaliste.
              </p>
            </div>
          </li>
          <li class="problem-card">
            <span class="problem-card__icon" aria-hidden="true">📊</span>
            <div>
              <h3 class="problem-card__title">Trafic non qualifié</h3>
              <p class="problem-card__desc">
                Vous recevez des visiteurs, mais ils ne correspondent pas à votre
                clientèle cible et ne génèrent pas de contacts.
              </p>
            </div>
          </li>
          <li class="problem-card">
            <span class="problem-card__icon" aria-hidden="true">🗺️</span>
            <div>
              <h3 class="problem-card__title">Pas de cap SEO clair</h3>
              <p class="problem-card__desc">
                Vous avez essayé différentes actions sans résultats durables, faute
                d'une stratégie cohérente et d'un suivi régulier.
              </p>
            </div>
          </li>
        </ul>

        <div class="problems__cta">
          <p>Ces problèmes ont des solutions concrètes.</p>
          <a href="/services/audit-seo/" class="btn btn--primary">
            Diagnostiquer mon site
          </a>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════
         3. SERVICES
    ══════════════════════════════════════ -->
    <section class="home-services section section--navy" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Ce que je propose</p>
          <h2 id="services-heading">Services SEO</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Des services complémentaires, conçus pour couvrir les différents aspects
            du référencement naturel selon vos besoins et votre situation.
          </p>
        </div>

        <div class="grid-auto">
          {services.map((service, i) => (
            <ServiceCard
              title={service.title}
              slug={service.slug}
              description={service.shortDescription}
              index={i + 1}
            />
          ))}
        </div>

        <div class="home-services__footer">
          <a href="/services/" class="btn btn--secondary">
            Voir tous les services →
          </a>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════
         4. PROCESSUS
    ══════════════════════════════════════ -->
    <ProcessSteps
      steps={processSteps}
      heading="Une méthode SEO structurée, étape par étape"
      subheading="Le SEO efficace n'est pas une question de recettes magiques. C'est un processus itératif, basé sur l'analyse des données et l'amélioration continue."
    />


    <!-- ══════════════════════════════════════
         5. POURQUOI UJJWAL SEO
    ══════════════════════════════════════ -->
    <section class="about-intro section section--surface" aria-labelledby="about-heading">
      <div class="container">
        <div class="about-intro__grid">

          <div class="about-intro__text">
            <p class="eyebrow">À propos</p>
            <h2 id="about-heading">Pourquoi travailler avec Ujjwal SEO ?</h2>

            <p class="lead" style="margin-top: var(--space-5); margin-bottom: var(--space-8)">
              En tant que consultant SEO indépendant, j'interviens directement sur votre projet,
              sans intermédiaire et avec une vision globale de votre visibilité en ligne.
            </p>

            <ul class="about-intro__points">
              <li class="about-point">
                <span class="about-point__marker" aria-hidden="true">01</span>
                <div>
                  <h3 class="about-point__title">Approche orientée business</h3>
                  <p class="about-point__desc">
                    Le SEO n'est pas une fin en soi. Chaque décision d'optimisation
                    est évaluée en fonction de son impact potentiel sur votre activité
                    et vos objectifs commerciaux.
                  </p>
                </div>
              </li>
              <li class="about-point">
                <span class="about-point__marker" aria-hidden="true">02</span>
                <div>
                  <h3 class="about-point__title">Méthode claire et transparente</h3>
                  <p class="about-point__desc">
                    Vous comprenez ce qui est fait et pourquoi. Chaque recommandation
                    est expliquée, priorisée et accompagnée d'un plan d'action concret.
                  </p>
                </div>
              </li>
              <li class="about-point">
                <span class="about-point__marker" aria-hidden="true">03</span>
                <div>
                  <h3 class="about-point__title">Compétences techniques et éditoriales</h3>
                  <p class="about-point__desc">
                    Du SEO technique au contenu, en passant par le SEO local,
                    j'interviens sur l'ensemble des leviers du référencement naturel.
                  </p>
                </div>
              </li>
              <li class="about-point">
                <span class="about-point__marker" aria-hidden="true">04</span>
                <div>
                  <h3 class="about-point__title">Spécialisé Rennes et Bretagne</h3>
                  <p class="about-point__desc">
                    Une connaissance du tissu économique local pour des stratégies
                    adaptées à la réalité des marchés rennais et breton.
                  </p>
                </div>
              </li>
            </ul>

            <a href="/a-propos/" class="btn btn--secondary" style="margin-top: var(--space-8)">
              En savoir plus sur mon parcours
            </a>
          </div>

          <div class="about-intro__visual">
            <div class="about-intro__portrait">
              <img
                src="/assets/ujjwal-lage-homepage.jpg"
                alt="Ujjwal Lage — Consultant SEO indépendant en Bretagne"
                width="682"
                height="1024"
                loading="lazy"
                class="about-intro__portrait-img"
              />
            </div>
            <div class="about-intro__card">
              <p class="about-intro__card-quote">
                "Le SEO est un investissement à long terme qui, bien exécuté,
                génère un flux constant de visiteurs qualifiés."
              </p>
              <p class="about-intro__card-author">— Ujjwal Lage</p>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════
         6. ZONES GÉOGRAPHIQUES
    ══════════════════════════════════════ -->
    <section class="local-section section" aria-labelledby="local-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Zones d'intervention</p>
          <h2 id="local-heading">SEO à Rennes et en Bretagne</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Basé en Bretagne, j'accompagne prioritairement les entreprises rennaises
            et bretonnes dans leur développement de visibilité organique.
          </p>
        </div>

        <div class="local-cards">
          <article class="local-card">
            <div class="local-card__media">
              <img
                src="/assets/hero/french-town.jpg"
                alt="Rues commerçantes et architecture du centre-ville de Rennes"
                width="600"
                height="338"
                loading="lazy"
                class="local-card__img"
              />
            </div>
            <div class="local-card__body">
              <h3 class="local-card__title">
                <a href="/seo-rennes/">Consultant SEO Rennes</a>
              </h3>
              <p class="local-card__desc">
                Vous exercez à Rennes ou dans son agglomération ?
                Une stratégie SEO locale ciblée peut vous aider à apparaître
                dans les recherches de vos clients potentiels rennais.
              </p>
              <ul class="local-card__features">
                <li>Référencement local Rennes</li>
                <li>Google Business Profile</li>
                <li>Contenu local ciblé</li>
                <li>SEO pour TPE et PME rennaises</li>
              </ul>
              <a href="/seo-rennes/" class="btn btn--primary">
                SEO Rennes →
              </a>
            </div>
          </article>

          <article class="local-card">
            <div class="local-card__media">
              <img
                src="/assets/hero/bretagne-coast.jpg"
                alt="Falaises et paysage du littoral breton"
                width="600"
                height="338"
                loading="lazy"
                class="local-card__img"
              />
            </div>
            <div class="local-card__body">
              <h3 class="local-card__title">
                <a href="/seo-bretagne/">Consultant SEO Bretagne</a>
              </h3>
              <p class="local-card__desc">
                Vous couvrez plusieurs villes ou tout le territoire breton ?
                Je vous accompagne dans la construction d'une visibilité
                organique adaptée aux spécificités du marché régional.
              </p>
              <ul class="local-card__features">
                <li>Référencement régional Bretagne</li>
                <li>Stratégie multi-villes</li>
                <li>Contenu régional pertinent</li>
                <li>Visibilité à l'échelle bretonne</li>
              </ul>
              <a href="/seo-bretagne/" class="btn btn--secondary">
                SEO Bretagne →
              </a>
            </div>
          </article>
        </div>

        <p class="local-section__note">
          J'interviens également en <a href="/services/seo-local/">SEO local</a>
          pour des entreprises basées hors de Bretagne, selon disponibilité.
        </p>
      </div>
    </section>


    <!-- ══════════════════════════════════════
         7. RÉALISATIONS (transparent)
    ══════════════════════════════════════ -->
    <section class="realisations-preview section section--warm" aria-labelledby="realisations-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Projets</p>
          <h2 id="realisations-heading">Réalisations</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Les études de cas détaillées seront publiées au fur et à mesure,
            avec les autorisations des clients concernés. Chaque cas présentera
            le contexte réel, les actions menées et les résultats mesurables.
          </p>
        </div>

        <div class="realisations-placeholder">
          <div class="realisations-placeholder__inner">
            <p class="realisations-placeholder__text">
              Les études de cas arrivent prochainement.<br />
              <a href="/contact/">Contactez-moi</a> pour en discuter directement.
            </p>
          </div>
        </div>

        <div style="text-align: center; margin-top: var(--space-8)">
          <a href="/realisations/" class="btn btn--secondary">
            Voir les réalisations →
          </a>
        </div>
      </div>
    </section>


    <!-- ══════════════════════════════════════
         8. BLOG (récents articles)
    ══════════════════════════════════════ -->
    <section class="home-blog section section--surface" aria-labelledby="blog-heading">
      <div class="container">
        <div class="section-header">
          <div class="home-blog__header-row">
            <div>
              <p class="eyebrow">Ressources</p>
              <h2 id="blog-heading">Articles SEO</h2>
            </div>
            <a href="/blog/" class="btn btn--secondary home-blog__all-link">
              Tous les articles →
            </a>
          </div>
          <p class="lead" style="margin-top: var(--space-4)">
            Conseils, méthodes et explications pour comprendre le SEO et améliorer
            votre visibilité sur Google.
          </p>
        </div>

        {latestPosts.length > 0
          ? (
            <div class="grid-3">
              {latestPosts.map((post) => {
                const slug = post.id.replace(/\.mdx?$/, '');
                return (
                  <BlogCard
                    title={post.data.title}
                    slug={slug}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    featuredImage={post.data.featuredImage}
                    featuredImageAlt={post.data.featuredImageAlt}
                    categories={post.data.categories}
                  />
                );
              })}
            </div>
          )
          : (
            <div class="home-blog__empty">
              <p>
                Les premiers articles sont en cours de rédaction.
                <a href="/blog/">Consultez la page blog</a> pour suivre les publications.
              </p>
            </div>
          )
        }
      </div>
    </section>


    <!-- ══════════════════════════════════════
         9. FAQ
    ══════════════════════════════════════ -->
    <FAQ items={homeFAQ} heading="Questions fréquentes sur le SEO" />


    <!-- ══════════════════════════════════════
         10. CTA FINAL
    ══════════════════════════════════════ -->
    <CTA
      heading="Parlons de votre visibilité sur Google."
      body="Un premier échange de 30 minutes pour comprendre votre situation et voir si je peux vous aider. Gratuit, sans engagement."
      primaryCTA={{ label: 'Réserver un appel', href: '/reserver-un-appel/' }}
      secondaryCTA={{ label: 'Demander un audit SEO', href: '/contact/' }}
      variant="navy"
      bgImage="/assets/hero/calm-coast.jpg"
    />

  </main>

  <Footer />

  <script>
    // Scroll reveal — subtle section entrance
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('revealed'));
    }
  </script>

</BaseLayout>

<style>
/* ══ NAVY SERVICE CARD OVERRIDES ══ */
.section--navy .service-card {
  background-color: var(--color-navy-light);
  border-color: rgba(255, 255, 255, 0.08);
}
.section--navy .service-card:hover {
  border-color: rgba(255, 255, 255, 0.18);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}
.section--navy .service-card__index {
  color: var(--color-atlantic-muted);
}
.section--navy .service-card__link {
  color: var(--color-text-inverse);
}
.section--navy .service-card__link:hover {
  color: var(--color-atlantic-muted);
}
.section--navy .service-card__description {
  color: rgba(249, 246, 241, 0.65);
}
.section--navy .service-card__arrow {
  color: var(--color-atlantic-muted);
}
.section--navy .service-card::before {
  background-color: var(--color-atlantic-muted);
}
.section--navy .btn--secondary {
  border-color: rgba(249, 246, 241, 0.25);
  color: var(--color-text-inverse);
}
.section--navy .btn--secondary:hover {
  border-color: var(--color-text-inverse);
  background-color: rgba(249, 246, 241, 0.08);
  color: var(--color-text-inverse);
}


/* ══ PROBLEMS ══ */
.problems__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  gap: var(--space-5);
  margin-bottom: var(--space-12);
}

.problem-card {
  display: flex;
  gap: var(--space-4);
  padding: var(--space-6);
  background-color: var(--color-bg);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  transition: border-color var(--transition-base), box-shadow var(--transition-base);
}

.problem-card:hover {
  border-color: var(--color-border);
  box-shadow: var(--shadow-sm);
}

.problem-card__icon {
  font-size: 1.5rem;
  flex-shrink: 0;
  line-height: 1;
}

.problem-card__title {
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  margin-bottom: var(--space-2);
}

.problem-card__desc {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
}

.problems__cta {
  display: flex;
  align-items: center;
  gap: var(--space-6);
  flex-wrap: wrap;
}

.problems__cta p {
  font-size: var(--text-lg);
  font-weight: var(--weight-medium);
  color: var(--color-text);
}

@media (max-width: 640px) {
  .problems__cta {
    flex-direction: column;
    align-items: flex-start;
  }
}


/* ══ SERVICES FOOTER ══ */
.home-services__footer {
  margin-top: var(--space-10);
  text-align: center;
}


/* ══ ABOUT INTRO ══ */
.about-intro__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: start;
}

@media (max-width: 900px) {
  .about-intro__grid {
    grid-template-columns: 1fr;
  }
  .about-intro__visual {
    display: none; /* Hidden until portrait is supplied */
  }
}

.about-intro__points {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.about-point {
  display: flex;
  gap: var(--space-5);
  align-items: flex-start;
}

.about-point__marker {
  font-family: var(--font-serif);
  font-size: var(--text-xs);
