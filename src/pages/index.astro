---
/**
 * index.astro — Homepage
 * URL: /
 * H1: Consultant SEO & GEO
 *
 * Information Architecture:
 *  01. Hero (SearchLandscapeHero)
 *  02. SEO + GEO : Deux disciplines complémentaires
 *  03. "Comment votre entreprise est comprise" (EntityDiagram)
 *  04. Services SEO & GEO (6 expertises claires)
 *  05. Méthodologie en 5 étapes (ProcessSteps)
 *  06. Pourquoi travailler avec un consultant indépendant
 *  07. Zones d'intervention (Bretagne, Pays de la Loire & France à distance)
 *  08. Blog & Ressources
 *  09. FAQ
 *  10. CTA Final
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchLandscapeHero from '../components/SearchLandscapeHero.astro';
import EntityDiagram from '../components/EntityDiagram.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import BlogCard from '../components/BlogCard.astro';
import { buildTitle, SITE_URL } from '../utils/seo';
import { services } from '../data/services';
import { faqGeneral } from '../data/faq';
import { getCollection } from 'astro:content';

// Fetch latest published blog posts (max 3 for homepage)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// 5-step methodology per prompt specification §10
const processSteps = [
  {
    number: 1,
    title: 'Comprendre',
    description: 'Analyse approfondie de votre modèle économique, de la demande de recherche réelle, des concurrents et des intentions de vos clients.',
  },
  {
    number: 2,
    title: 'Structurer',
    description: 'Organisation de l\'architecture de l\'information, maillage interne, définition des entités et assainissement technique des fondations.',
  },
  {
    number: 3,
    title: 'Optimiser',
    description: 'Résolution des blocages techniques, optimisation sémantique on-page, balisage Schema.org et cohérence locale.',
  },
  {
    number: 4,
    title: 'Développer',
    description: 'Déploiement de contenus stratégiques à forte valeur ajoutée, renforcement de l\'autorité thématique et pertinence contextuelle.',
  },
  {
    number: 5,
    title: 'Observer',
    description: 'Pilotage via Google Search Console, suivi des positions, du trafic qualifié, des conversions et des signaux de visibilité IA émergents.',
  },
];

// Organization + WebSite schema
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Ujjwal SEO',
  description: 'Consultant SEO & GEO indépendant en France. Accompagnement en référencement naturel, optimisation technique, sémantique et visibilité dans les moteurs de recherche IA.',
  url: SITE_URL,
  founder: {
    '@type': 'Person',
    name: 'Ujjwal Lage',
    jobTitle: 'Consultant SEO & GEO indépendant',
    url: `${SITE_URL}/a-propos/`,
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
    { '@type': 'AdministrativeArea', name: 'Pays de la Loire' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
  ],
  knowsAbout: [
    'SEO',
    'GEO - Generative Engine Optimization',
    'Référencement naturel',
    'SEO technique',
    'SEO sémantique',
    'SEO local',
    'Audit SEO',
    'Données structurées Schema.org',
    'Moteurs de réponse IA',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Ujjwal SEO',
  url: SITE_URL,
};
---

<BaseLayout
  title={buildTitle('Consultant SEO & GEO — Visibilité Moteurs & Recherche IA', false)}
  description="Consultant SEO & GEO indépendant en France. J'aide les entreprises à devenir plus visibles et compréhensibles dans les moteurs de recherche et les espaces de réponse IA."
  canonicalPath="/"
  schema={[professionalServiceSchema, websiteSchema]}
>
  <Header />

  <main id="main-content">

    <!-- ══════════════════════════════════════
         01. HERO (Search Landscape System)
    ══════════════════════════════════════ -->
    <SearchLandscapeHero
      eyebrow="Consultant SEO & GEO indépendant"
      heading="Consultant SEO & GEO"
      subheading="J'aide les entreprises à devenir plus visibles dans les moteurs de recherche et les nouveaux espaces de recherche alimentés par l'IA. De la structure technique aux réseaux d'entités, je construis des fondations durables pour votre présence numérique."
      primaryCTA={{ label: 'Découvrir mon approche', href: '/approche/' }}
      secondaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
    />

    <!-- ══════════════════════════════════════
         02. SEO + GEO : DEUX DISCIPLINES COMPLÉMENTAIRES
    ══════════════════════════════════════ -->
    <section class="duo-section section section--surface" aria-labelledby="duo-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Vision & Positionnement</p>
          <h2 id="duo-heading">SEO + GEO : Deux disciplines complémentaires</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Le référencement ne s'arrête plus à une liste de liens bleus. Pour construire une visibilité pérenne, il est indispensable de comprendre comment les moteurs traditionnels et les systèmes d'IA indexent et synthétisent vos informations.
          </p>
        </div>

        <div class="duo-grid">
          <article class="duo-card duo-card--seo">
            <div class="duo-card__header">
              <span class="duo-card__badge">Fondation classique</span>
              <h3 class="duo-card__title">SEO — Search Engine Optimization</h3>
            </div>
            <p class="duo-card__desc">
              Le SEO traditionnel consiste à positionner votre site sur Google en optimisant son accessibilité technique, sa pertinence sémantique et son autorité. L'objectif est de répondre précisément aux requêtes textuelles des internautes.
            </p>
            <ul class="duo-card__list">
              <li><strong>Crawl & Indexation :</strong> Des pages facilement lues par les robots d'exploration.</li>
              <li><strong>Intention de recherche :</strong> Des contenus ciblés répondant aux besoins de vos futurs clients.</li>
              <li><strong>Expérience & Performance :</strong> Temps de chargement rapides, ergonomie mobile et balisage clair.</li>
            </ul>
            <div class="duo-card__footer">
              <span class="duo-card__mechanic">Mécanique : Requête &rarr; Moteur &rarr; Index &rarr; Classement</span>
            </div>
          </article>

          <article class="duo-card duo-card--geo">
            <div class="duo-card__header">
              <span class="duo-card__badge duo-card__badge--geo">Espace émergent</span>
              <h3 class="duo-card__title">GEO — Generative Engine Optimization</h3>
            </div>
            <p class="duo-card__desc">
              Le GEO s'intéresse à la façon dont l'expertise et l'identité de votre entreprise sont comprises, extraites et citées par les moteurs de recherche enrichis d'IA (Google AI Overviews, Perplexity, moteurs de réponse).
            </p>
            <ul class="duo-card__list">
              <li><strong>Clarté des entités :</strong> Rendre explicites vos domaines d'intervention, vos produits et votre singularité.</li>
              <li><strong>Données structurées :</strong> Alimenter les modèles avec des faits vérifiables et standardisés.</li>
              <li><strong>Sources de confiance :</strong> Devenir une référence citée lors des synthèses automatiques.</li>
            </ul>
            <div class="duo-card__footer">
              <span class="duo-card__mechanic">Mécanique : Question complexe &rarr; Extraction contextuelle &rarr; Synthèse sourcée</span>
            </div>
          </article>
        </div>

        <div class="duo-summary">
          <div class="duo-summary__inner">
            <div class="duo-summary__icon" aria-hidden="true">&bull;&bull;&bull;</div>
            <p class="duo-summary__text">
              <strong>Le GEO ne remplace pas le SEO.</strong> Il s'appuie sur les mêmes piliers d'excellence technique, de qualité éditoriale et de cohérence structurelle. Travailler les deux vous assure d'être présent là où vos clients cherchent aujourd'hui et chercheront demain.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         03. COMMENT VOTRE ENTREPRISE EST COMPRISE
    ══════════════════════════════════════ -->
    <EntityDiagram />

    <!-- ══════════════════════════════════════
         04. SERVICES (6 EXPERTISES)
    ══════════════════════════════════════ -->
    <section class="home-services section" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Domaines d'intervention</p>
          <h2 id="services-heading">Des expertises précises pour chaque enjeu</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Que vous ayez besoin de débloquer des freins techniques, d'asseoir une présence locale ou d'anticiper la recherche générative, mes prestations répondent à un besoin concret sans promesse artificielle.
          </p>
        </div>

        <div class="grid-auto">
          {services.map((service, i) => (
            <ServiceCard
              title={service.title}
              slug={service.slug}
              description={service.shortDescription}
              category={service.category}
              deliverables={service.deliverables}
              index={i + 1}
            />
          ))}
        </div>

        <div class="home-services__footer">
          <a href="/services/" class="btn btn--secondary">
            Explorer le détail de tous les services &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         05. PROCESSUS (5 ÉTAPES)
    ══════════════════════════════════════ -->
    <ProcessSteps
      steps={processSteps}
      heading="Une méthode structurée en 5 étapes"
      subheading="Le référencement naturel pérenne repose sur une méthodologie rigoureuse, fondée sur l'analyse de données réelles et l'amélioration méthodique des fondations de votre site."
    />

    <!-- ══════════════════════════════════════
         06. POURQUOI UN CONSULTANT INDÉPENDANT
    ══════════════════════════════════════ -->
    <section class="consultant-value section section--surface" aria-labelledby="why-heading">
      <div class="container">
        <div class="consultant-value__grid">
          <div class="consultant-value__text">
            <p class="eyebrow">Collaboration directe</p>
            <h2 id="why-heading">Pourquoi faire appel à un consultant indépendant ?</h2>
            <p class="lead" style="margin-top: var(--space-4); margin-bottom: var(--space-8)">
              Loin des schémas d'agences aux multiples intermédiaires, travailler avec un consultant indépendant vous garantit un échange direct avec l'expert qui analyse, conseille et intervient sur votre site.
            </p>

            <ul class="consultant-points" role="list">
              <li class="consultant-point">
                <span class="consultant-point__number">01</span>
                <div>
                  <h3 class="consultant-point__title">Interlocuteur unique & engagement direct</h3>
                  <p class="consultant-point__desc">
                    Aucun compte délégué à un stagiaire. Votre dossier est traité directement avec rigueur, écoute et réactivité.
                  </p>
                </div>
              </li>
              <li class="consultant-point">
                <span class="consultant-point__number">02</span>
                <div>
                  <h3 class="consultant-point__title">Double sensibilité technique et commerciale</h3>
                  <p class="consultant-point__desc">
                    Issu d'une formation en management et commerce avant ma spécialisation en SEO, je ne perds jamais de vue vos objectifs d'affaires et la rentabilité de vos actions.
                  </p>
                </div>
              </li>
              <li class="consultant-point">
                <span class="consultant-point__number">03</span>
                <div>
                  <h3 class="consultant-point__title">Pédagogie et transparence totale</h3>
                  <p class="consultant-point__desc">
                    Pas de jargon hermétique ni de faux mystère. Vous comprenez chaque choix technique, chaque priorité et la logique des actions mises en œuvre.
                  </p>
                </div>
              </li>
              <li class="consultant-point">
                <span class="consultant-point__number">04</span>
                <div>
                  <h3 class="consultant-point__title">Veille continue sur l'IA et le GEO</h3>
                  <p class="consultant-point__desc">
                    Les moteurs de recherche évoluent vite. Mon approche intègre en permanence les changements d'algorithmes et l'apparition des nouvelles surfaces de réponse génératives.
                  </p>
                </div>
              </li>
            </ul>

            <div style="margin-top: var(--space-8);">
              <a href="/a-propos/" class="btn btn--secondary">
                En savoir plus sur mon parcours &rarr;
              </a>
            </div>
          </div>

          <div class="consultant-value__panel">
            <div class="consultant-card">
              <div class="consultant-card__badge">Consultant SEO & GEO indépendant</div>
              <h3 class="consultant-card__name">Ujjwal Lage</h3>
              <p class="consultant-card__role">Stratégie de visibilité organique & architecture d'entités</p>
              
              <div class="consultant-card__principles">
                <div class="consultant-card__item">
                  <span class="consultant-card__dot"></span>
                  <span>Zéro promesse irréaliste de positionnement n°1 garanti</span>
                </div>
                <div class="consultant-card__item">
                  <span class="consultant-card__dot"></span>
                  <span>Audit basé sur des données tangibles et vérifiables</span>
                </div>
                <div class="consultant-card__item">
                  <span class="consultant-card__dot"></span>
                  <span>Accompagnement adapté aux TPE, PME et structures ambitieuses</span>
                </div>
                <div class="consultant-card__item">
                  <span class="consultant-card__dot"></span>
                  <span>Interventions locales dans le Grand Ouest & partout en France à distance</span>
                </div>
              </div>

              <div class="consultant-card__cta">
                <a href="/contact/" class="btn btn--primary btn--full">
                  Échanger sur vos enjeux
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         07. ZONES D'INTERVENTION PREVIEW
    ══════════════════════════════════════ -->
    <section class="home-zones section" aria-labelledby="zones-heading">
      <div class="container">
        <div class="home-zones__wrapper">
          <div class="home-zones__header">
            <p class="eyebrow">Rayonnement Géographique</p>
            <h2 id="zones-heading">De la Bretagne aux Pays de la Loire, et partout en France</h2>
            <p class="lead" style="margin-top: var(--space-4)">
              <strong>Local quand l'ancrage territorial compte. À distance quand la localisation n'a pas d'importance.</strong> J'accompagne des entreprises locales, des PME régionales et des acteurs à rayonnement national.
            </p>
          </div>

          <div class="home-zones__grid">
            <div class="zone-pill-card">
              <span class="zone-pill-card__tag">Région Ouest</span>
              <h3 class="zone-pill-card__title">Bretagne</h3>
              <p class="zone-pill-card__desc">Rennes, Saint-Malo, Fougères, Vitré, Janzé, Saint-Brieuc, Vannes, Lorient, Brest.</p>
              <a href="/zones-intervention/bretagne/" class="zone-pill-card__link">Découvrir le réseau Bretagne &rarr;</a>
            </div>

            <div class="zone-pill-card">
              <span class="zone-pill-card__tag">Région Ouest</span>
              <h3 class="zone-pill-card__title">Pays de la Loire</h3>
              <p class="zone-pill-card__desc">Laval, Mayenne, Château-Gontier, Nantes, Châteaubriant, Angers, Segré.</p>
              <a href="/zones-intervention/mayenne/" class="zone-pill-card__link">Découvrir le réseau Pays de la Loire &rarr;</a>
            </div>

            <div class="zone-pill-card zone-pill-card--highlight">
              <span class="zone-pill-card__tag">National</span>
              <h3 class="zone-pill-card__title">France entière (à distance)</h3>
              <p class="zone-pill-card__desc">Accompagnement SEO & GEO via visioconférences régulières, tableaux de bord partagés et collaboration fluide.</p>
              <a href="/contact/" class="zone-pill-card__link">Prendre contact pour un projet &rarr;</a>
            </div>
          </div>

          <div class="home-zones__cta">
            <a href="/zones-intervention/" class="btn btn--primary">
              Consulter la carte interactive des zones d'intervention &rarr;
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         08. BLOG (ARTICLES & RESSOURCES)
    ══════════════════════════════════════ -->
    <section class="home-blog section section--surface" aria-labelledby="blog-heading">
      <div class="container">
        <div class="section-header">
          <div class="home-blog__header-row">
            <div>
              <p class="eyebrow">Publications & Analyses</p>
              <h2 id="blog-heading">Dernières réflexions SEO & GEO</h2>
            </div>
            <a href="/blog/" class="btn btn--secondary home-blog__all-link">
              Tous les articles &rarr;
            </a>
          </div>
          <p class="lead" style="margin-top: var(--space-4)">
            Des guides pédagogiques, des analyses techniques et des réflexions concrètes sur l'évolution de la recherche web et des intelligences artificielles.
          </p>
        </div>

        {latestPosts.length > 0 ? (
          <div class="grid-3">
            {latestPosts.map((post) => {
              const slug = post.id.replace(/\.mdx?$/, '');
              return (
                <BlogCard
                  title={post.data.title}
                  slug={slug}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  featuredImage={post.data.featuredImage}
                  featuredImageAlt={post.data.featuredImageAlt}
                  categories={post.data.categories}
                />
              );
            })}
          </div>
        ) : (
          <div class="home-blog__empty">
            <p>
              Les articles d'analyse sont consultables dans l'espace <a href="/blog/">Blog</a>.
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- ══════════════════════════════════════
         09. FAQ
    ══════════════════════════════════════ -->
    <FAQ items={faqGeneral} heading="Questions fréquentes sur le SEO & le GEO" />

    <!-- ══════════════════════════════════════
         10. CTA FINAL
    ══════════════════════════════════════ -->
    <CTA
      heading="Construisons une visibilité durable pour votre entreprise."
      body="Échangeons pendant 30 minutes sur vos enjeux actuels, votre concurrence et les opportunités de positionnement sur Google et les moteurs IA. Échange direct, sans engagement."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Découvrir mon approche', href: '/approche/' }}
      variant="navy"
    />

  </main>

  <Footer />
</BaseLayout>

<style>
/* ══ DUO SECTION (SEO + GEO) ══ */
.duo-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
  margin-top: var(--space-10);
  margin-bottom: var(--space-10);
}

@media (max-width: 860px) {
  .duo-grid {
    grid-template-columns: 1fr;
  }
}

.duo-card {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-base), box-shadow var(--transition-base);
}

.duo-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.duo-card--seo {
  border-top: 3px solid var(--color-atlantic);
}

.duo-card--geo {
  border-top: 3px solid #6366F1;
}

.duo-card__header {
  margin-bottom: var(--space-4);
}

.duo-card__badge {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-atlantic);
  background: rgba(37, 99, 235, 0.08);
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-3);
}

.duo-card__badge--geo {
  color: #4F46E5;
  background: rgba(99, 102, 241, 0.1);
}

.duo-card__title {
  font-size: var(--text-xl);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
}

.duo-card__desc {
  font-size: var(--text-base);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
  margin-bottom: var(--space-6);
}

.duo-card__list {
  list-style: none;
  padding: 0;
  margin: 0 0 var(--space-6) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: var(--leading-normal);
}

.duo-card__list li {
  position: relative;
  padding-left: var(--space-5);
}

.duo-card__list li::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--color-atlantic);
  font-weight: bold;
}

.duo-card__footer {
  margin-top: auto;
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border-light);
}

.duo-card__mechanic {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--color-text-muted);
  display: block;
}

.duo-summary {
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-navy);
  border-radius: var(--radius-sm);
  padding: var(--space-6);
}

.duo-summary__inner {
  display: flex;
  gap: var(--space-4);
  align-items: center;
}

.duo-summary__icon {
  color: var(--color-atlantic);
  letter-spacing: 0.2em;
  font-size: 1.25rem;
  flex-shrink: 0;
}

.duo-summary__text {
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: var(--leading-relaxed);
  margin: 0;
}

/* ══ SERVICES FOOTER ══ */
.home-services__footer {
  margin-top: var(--space-12);
  text-align: center;
}

/* ══ CONSULTANT VALUE SECTION ══ */
.consultant-value__grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: var(--space-12);
  align-items: center;
}

@media (max-width: 900px) {
  .consultant-value__grid {
    grid-template-columns: 1fr;
  }
}

.consultant-points {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  list-style: none;
  padding: 0;
  margin: 0;
}

.consultant-point {
  display: flex;
  gap: var(--space-5);
  align-items: flex-start;
}

.consultant-point__number {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  font-weight: var(--weight-bold);
  color: var(--color-atlantic);
  background: rgba(37, 99, 235, 0.08);
  padding: 0.2rem 0.5rem;
