---
/**
 * index.astro — Homepage
 * URL: /
 * H1: Consultant SEO & GEO — Développez votre visibilité sur Google et les moteurs de recherche IA.
 *
 * Phase 4 Conversion & Information Architecture:
 *  01. Hero (SearchLandscapeHero) + CommitmentBand
 *  02. Proposition de valeur & comparaison interactive SEO vs GEO (SerpVsAi + EntityDiagram)
 *  03. Aperçu synthétique des 6 Services (nom, résumé, bénéfice commercial, lien) — sans dupliquer /services/
 *  04. Pourquoi travailler avec Ujjwal SEO (engagements, éthique & portrait)
 *  05. Comment fonctionne l'accompagnement (MethodTimeline + lien vers /approche/ en 8 étapes)
 *  06. Preuves & Réalisations vérifiables (architecture live ujjwal-seo.com + lien /realisations/)
 *  07. Couverture géographique (Rennes, Vitré, Laval, Fougères, Janzé, Châteaubriant, Redon + Grand Ouest & France)
 *  08. Derniers articles & analyses (Blog)
 *  09. FAQ
 *  10. Appel à l'action final (Contact)
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchLandscapeHero from '../components/SearchLandscapeHero.astro';
import CommitmentBand from '../components/CommitmentBand.astro';
import SerpVsAi from '../components/SerpVsAi.astro';
import EntityDiagram from '../components/EntityDiagram.astro';
import ServiceCard from '../components/ServiceCard.astro';
import MethodTimeline from '../components/MethodTimeline.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import BlogCard from '../components/BlogCard.astro';
import { buildTitle, SITE_URL } from '../utils/seo';
import { services } from '../data/services';
import { faqGeneral } from '../data/faq';
import { getCollection } from 'astro:content';

// Fetch latest published blog posts (max 3 for homepage)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// 5-step high-level overview on homepage (links to full 8-step lifecycle on /approche/)
const processSteps = [
  {
    title: 'Comprendre & Auditer',
    when: 'Semaines 1–2',
    description: 'Échange initial sur votre modèle économique, audit technique complet et étude des concurrents classés.',
  },
  {
    title: 'Structurer les intentions',
    when: 'Semaines 2–3',
    description: 'Cartographie des mots-clés à intention commerciale, architecture en silos et plan d\'action priorisé.',
  },
  {
    title: 'Optimiser le socle & les pages',
    when: 'Semaines 3–6',
    description: 'Correction des blocages d\'indexation, réécriture des pages d\'offres et déploiement du graphe Schema.org.',
  },
  {
    title: 'Mailler & Développer l\'autorité',
    when: 'Mois 2–6',
    description: 'Maillage interne contextuel, contenus citables par les IA génératives et signaux de confiance locaux.',
  },
  {
    title: 'Suivre & Améliorer en continu',
    when: 'Chaque mois',
    description: 'Pilotage dans Google Search Console : clics qualifiés, positions, citations IA et ajustements itératifs.',
  },
];

// Why work with Ujjwal SEO — transparent principles & explicit refusals
const differentiators = [
  {
    badge: 'Zéro promesse irréaliste',
    title: 'Pas de « 1re place garantie en 15 jours »',
    text: 'Aucun consultant sérieux ne contrôle l\'algorithme de Google. Mon engagement porte sur la rigueur technique, la qualité sémantique et la progression mesurable de vos demandes entrantes.',
  },
  {
    badge: 'Interlocuteur unique',
    title: 'Aucune sous-traitance ni délégation junior',
    text: 'Celui qui audite votre site est celui qui conçoit la stratégie, rédige les spécifications, configure vos données structurées et vous répond directement.',
  },
  {
    badge: 'Livrables exploitables',
    title: 'Fini les rapports PDF de 80 pages illisibles',
    text: 'Vous recevez une feuille de route priorisée par impact commercial et complexité technique : quoi corriger en premier, pourquoi et comment.',
  },
  {
    badge: 'Autorité durable',
    title: 'Refus des réseaux de liens artificiels',
    text: 'Les liens achetés en masse finissent par pénaliser votre domaine. Nous construisons une autorité naturelle et pérenne conforme aux standards de Google Search Central.',
  },
];

const priorityCities = [
  { name: 'Rennes', dept: 'Ille-et-Vilaine (35)', href: '/zones-intervention/seo-rennes/', desc: 'Métropole tertiaire, B2B, tech, services et commerces.' },
  { name: 'Vitré', dept: 'Ille-et-Vilaine (35)', href: '/zones-intervention/seo-vitre/', desc: 'Bassin industriel dynamique, PME, sous-traitance et artisanat.' },
  { name: 'Laval', dept: 'Mayenne (53)', href: '/zones-intervention/seo-laval/', desc: 'Pôle économique mayennais, industrie, réalité virtuelle et services.' },
  { name: 'Fougères', dept: 'Ille-et-Vilaine (35)', href: '/zones-intervention/seo-fougeres/', desc: 'Savoir-faire industriels, commerce local et entreprises des Marches de Bretagne.' },
  { name: 'Janzé', dept: 'Ille-et-Vilaine (35)', href: '/zones-intervention/seo-janze/', desc: 'Entreprises de La Roche-aux-Fées, artisanat et services de proximité.' },
  { name: 'Châteaubriant', dept: 'Loire-Atlantique (44)', href: '/zones-intervention/seo-chateaubriant/', desc: 'Carrefour économique entre Rennes, Nantes et Angers.' },
  { name: 'Redon', dept: 'Ille-et-Vilaine / Morbihan', href: '/zones-intervention/seo-redon/', desc: 'Bassin inter-départemental au croisement de 3 départements.' },
];

// Organization + WebSite schema
const professionalServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#organization`,
  name: 'Ujjwal SEO',
  description: 'Consultant SEO & GEO indépendant en France (Rennes, Vitré, Laval, Fougères, Janzé, Châteaubriant, Redon). Accompagnement en référencement naturel, SEO technique, contenu sémantique, SEO local et moteurs de recherche IA.',
  url: SITE_URL,
  founder: {
    '@type': 'Person',
    '@id': `${SITE_URL}/a-propos/#person`,
    name: 'Ujjwal Lage',
    jobTitle: 'Consultant SEO & GEO indépendant',
    url: `${SITE_URL}/a-propos/`,
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'AdministrativeArea', name: 'Bretagne' },
    { '@type': 'AdministrativeArea', name: 'Pays de la Loire' },
    { '@type': 'AdministrativeArea', name: 'Ille-et-Vilaine' },
    { '@type': 'City', name: 'Rennes' },
    { '@type': 'City', name: 'Vitré' },
    { '@type': 'City', name: 'Laval' },
    { '@type': 'City', name: 'Fougères' },
    { '@type': 'City', name: 'Janzé' },
    { '@type': 'City', name: 'Châteaubriant' },
    { '@type': 'City', name: 'Redon' },
  ],
  knowsAbout: [
    'SEO',
    'GEO - Generative Engine Optimization',
    'Référencement naturel',
    'SEO technique',
    'SEO sémantique',
    'SEO local',
    'Audit SEO',
    'Données structurées Schema.org',
    'Moteurs de réponse IA',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Ujjwal SEO',
  url: SITE_URL,
  publisher: {
    '@id': `${SITE_URL}/#organization`,
  },
};
---

<BaseLayout
  title={buildTitle('Consultant SEO & GEO à Rennes & Grand Ouest — Google & Recherche IA', false)}
  description="Consultant SEO & GEO indépendant (Rennes, Vitré, Laval, Fougères, Janzé, Châteaubriant, Redon & France). Développez votre visibilité sur Google et les moteurs de recherche IA."
  canonicalPath="/"
  schema={[professionalServiceSchema, websiteSchema]}
>
  <Header />

  <main id="main-content">

    <!-- ══════════════════════════════════════
         01. HERO (Light Editorial Search Landscape)
    ══════════════════════════════════════ -->
    <SearchLandscapeHero
      eyebrow="Consultant SEO & GEO indépendant · Bretagne, Grand Ouest & France"
      heading="Consultant SEO & GEO — Développez votre visibilité sur Google et les moteurs de recherche IA."
      subheading="Votre site web doit attirer des prospects qualifiés, pas seulement exister en ligne. J'aide les TPE, PME et indépendants à consolider leur référencement naturel sur Google et à devenir une source citée par ChatGPT, Perplexity et Google AI Overviews."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Explorer les services', href: '/services/' }}
    />

    <!-- Concrete commitments band -->
    <CommitmentBand />

    <!-- ══════════════════════════════════════
         02. PROPOSITION DE VALEUR : SEO + GEO
    ══════════════════════════════════════ -->
    <section class="duo-section section section--surface" aria-labelledby="duo-heading">
      <div class="container">
        <div class="section-header--centered reveal">
          <p class="eyebrow">Pourquoi associer SEO et GEO aujourd'hui</p>
          <h2 id="duo-heading">Hier, il suffisait d'être <span class="mark">classé</span>. Aujourd'hui, il faut aussi être <span class="mark">compris et cité</span>.</h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Vos futurs clients cherchent à la fois sur Google (résultats organiques et Google Maps) et via des assistants génératifs. Comparez comment une même recherche est traitée par les deux systèmes :
          </p>
        </div>

        <SerpVsAi query="consultant SEO Rennes" />

        <div class="duo-summary reveal">
          <div class="duo-summary__inner">
            <div class="duo-summary__icon" aria-hidden="true">SEO + GEO</div>
            <p class="duo-summary__text">
              <strong>Le GEO ne remplace pas le SEO : il s'appuie dessus.</strong> Les modèles de langage (ChatGPT, Perplexity, Gemini) extraient leurs réponses des sites bien indexés, rapides, structurés en <a href="https://schema.org/" target="_blank" rel="noopener noreferrer">Schema.org</a> et dotés d'un contenu factuel vérifiable.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         03. COMMENT VOTRE ENTREPRISE EST COMPRISE
    ══════════════════════════════════════ -->
    <EntityDiagram />

    <!-- ══════════════════════════════════════
         04. APERÇU DES 6 SERVICES (CONCIS, SANS DUPLICATION)
    ══════════════════════════════════════ -->
    <section class="home-services section" aria-labelledby="services-heading">
      <div class="container">
        <div class="section-header--centered">
          <p class="eyebrow">Expertises SEO &amp; GEO</p>
          <h2 id="services-heading">Six leviers complémentaires au service de votre <span class="mark">chiffre d'affaires</span></h2>
          <p class="lead" style="margin-top: var(--space-4)">
            Chaque entreprise a son propre point de blocage : indexation technique, manque de pages commerciales, visibilité locale insuffisante ou absence des synthèses IA. Voici un aperçu synthétique de mes 6 interventions.
          </p>
        </div>

        <div class="grid-auto">
          {services.map((service, i) => (
            <ServiceCard
              title={service.title}
              slug={service.slug}
              description={service.shortDescription}
              category={service.category}
              businessBenefit={service.businessBenefit}
              index={i + 1}
            />
          ))}
        </div>

        <div class="home-services__footer">
          <p class="home-services__hint">
            Vous hésitez entre un audit ponctuel, une refonte technique ou un accompagnement mensuel ?
          </p>
          <a href="/services/" class="btn btn--secondary">
            Consulter le guide détaillé des 6 services (livrables, outils, méthodes &amp; FAQ) &rarr;
          </a>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         05. POURQUOI TRAVAILLER AVEC UJJWAL SEO (LIGHT EDITORIAL)
    ══════════════════════════════════════ -->
    <section class="why-section section section--surface" aria-labelledby="why-heading">
      <div class="container">
        <div class="why__grid">
          <div class="why__content">
            <p class="eyebrow reveal">Pourquoi choisir un consultant indépendant</p>
            <h2 id="why-heading" class="reveal">Une relation directe, rigoureuse et tournée vers votre rentabilité</h2>
            <p class="why__lead reveal">
              Travailler avec un consultant SEO &amp; GEO indépendant, c'est éviter l'inertie des grandes structures tout en bénéficiant d'une méthodologie d'ingénierie transparente. Voici les 4 engagements qui cadrent chaque mission :
            </p>

            <ul class="why__list" role="list">
              {differentiators.map((d, i) => (
                <li class={`why__item reveal reveal-delay-${Math.min(i, 3)}`}>
                  <span class="why__badge">{d.badge}</span>
                  <h3 class="why__title">{d.title}</h3>
                  <p class="why__text">{d.text}</p>
                </li>
              ))}
            </ul>
          </div>

          <figure class="why__portrait reveal reveal-delay-2">
            <div class="why__portrait-img-wrap">
              <img
                src="/assets/ujjwal-lage-portrait.jpg"
                alt="Ujjwal Lage, consultant SEO & GEO indépendant en Ille-et-Vilaine"
                width="682"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="why__caption">
              <span class="why__name">Ujjwal Lage</span>
              <span class="why__role">Consultant SEO &amp; GEO indépendant · Ille-et-Vilaine (35)</span>
              <p class="why__quote">
                « Issu du commerce et du management avant l'ingénierie du search, je considère chaque page SEO sous l'angle de sa rentabilité réelle pour votre entreprise. »
              </p>
              <div class="why__actions">
                <a href="/a-propos/" class="btn btn--secondary btn--sm">Découvrir mon parcours &rarr;</a>
                <a href="/reserver-un-appel/" class="why__link">Réserver 30 min d'échange</a>
              </div>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         06. COMMENT FONCTIONNE L'ACCOMPAGNEMENT
    ══════════════════════════════════════ -->
    <MethodTimeline
      steps={processSteps}
      heading="Comment se déroule un projet SEO & GEO"
      subheading="De l'audit initial au suivi mensuel dans Google Search Console, vous savez toujours ce qui est fait, pourquoi et avec quel impact."
    />

    <div class="container method-cta-bar">
      <p>
        Envie de voir le détail complet des livrables et des 8 étapes d'un projet ?
        <a href="/approche/">Consulter la méthodologie complète en 8 étapes &rarr;</a>
      </p>
    </div>

    <!-- ══════════════════════════════════════
         07. PREUVES & RÉALISATIONS VÉRIFIABLES
    ══════════════════════════════════════ -->
    <section class="proof-section section section--surface" aria-labelledby="proof-heading">
      <div class="container">
        <div class="proof-box">
          <div class="proof-box__content">
            <p class="eyebrow">Preuves par l'exemple &amp; transparence</p>
            <h2 id="proof-heading">Pas de statistiques inventées : inspectez l'architecture réelle et les livrables</h2>
            <p class="proof-box__desc">
              Plutôt que de publier des pourcentages anonymes invérifiables, je mets à votre disposition une <strong>étude de cas ouverte</strong> : l'ingénierie technique, sémantique et GEO de <code>ujjwal-seo.com</code> lui-même, accompagnée d'extraits réels de livrables d'audit et de scénarios d'intervention en Bretagne et Pays de la Loire.
            </p>
            <div class="proof-box__actions">
              <a href="/realisations/" class="btn btn--primary">
                Explorer les réalisations &amp; exemples de livrables &rarr;
              </a>
              <a href="/llms.txt" target="_blank" rel="noopener" class="btn btn--secondary">
                Inspecter le fichier /llms.txt en direct
              </a>
            </div>
          </div>

          <div class="proof-box__highlights">
            <div class="proof-stat">
              <span class="proof-stat__tag">Architecture Astro</span>
              <strong>HTML statique pré-rendu</strong>
              <p>Temps de réponse serveur immédiat, Core Web Vitals optimisés et zéro surcharge JavaScript inutile.</p>
            </div>
            <div class="proof-stat">
              <span class="proof-stat__tag">Graphe d'entités</span>
              <strong>Schema.org JSON-LD complet</strong>
              <p>Liaison explicite entre <code>Organization</code>, <code>Person</code>, <code>Service</code> et identifiants Wikidata locaux.</p>
            </div>
            <div class="proof-stat">
              <span class="proof-stat__tag">Standard GEO</span>
              <strong>Protocole <code>/llms.txt</code> actif</strong>
              <p>Cartographie structurée à la racine du domaine pour orienter les moteurs de réponse IA (ChatGPT, Perplexity, Claude).</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         08. COUVERTURE GÉOGRAPHIQUE (7 VILLES PRIORITAIRES + FRANCE)
    ══════════════════════════════════════ -->
    <section class="home-zones section" aria-labelledby="zones-heading">
      <div class="container">
        <div class="home-zones__wrapper">
          <div class="home-zones__header">
            <p class="eyebrow">Ancrage Territorial &amp; Intervention Nationale</p>
            <h2 id="zones-heading">Consultant SEO en Bretagne, Pays de la Loire et partout en France</h2>
            <p class="lead" style="margin-top: var(--space-4)">
              Basé en <strong>Ille-et-Vilaine (35)</strong>, j'interviens au plus près des tissus économiques de l'Ouest tout en accompagnant des PME sur l'ensemble du territoire français à distance.
            </p>
          </div>

          <div class="cities-showcase" aria-label="Villes d'intervention prioritaires">
            {priorityCities.map((city) => (
              <a href={city.href} class="city-card">
                <div class="city-card__top">
                  <h3 class="city-card__name">SEO {city.name}</h3>
                  <span class="city-card__dept">{city.dept}</span>
                </div>
                <p class="city-card__desc">{city.desc}</p>
                <span class="city-card__cta">Voir l'accompagnement à {city.name} &rarr;</span>
              </a>
            ))}
          </div>

          <div class="home-zones__grid">
            <div class="zone-pill-card">
              <span class="zone-pill-card__tag">Région &amp; Départements</span>
              <h3 class="zone-pill-card__title">Bretagne &amp; Ille-et-Vilaine (35)</h3>
              <p class="zone-pill-card__desc">Accompagnement des PME, artisans, commerces et acteurs B2B sur l'ensemble de la région bretonne.</p>
              <div class="zone-pill-card__links">
                <a href="/zones-intervention/bretagne/">Hub Bretagne &rarr;</a>
                <a href="/zones-intervention/ille-et-vilaine/">Ille-et-Vilaine (35) &rarr;</a>
              </div>
            </div>

            <div class="zone-pill-card">
              <span class="zone-pill-card__tag">Départements limitrophes</span>
              <h3 class="zone-pill-card__title">Mayenne (53), Loire-Atlantique (44) &amp; Anjou (49)</h3>
              <p class="zone-pill-card__desc">Rayonnement sur les bassins industriels et tertiaires des Pays de la Loire et des Marches de Bretagne.</p>
              <div class="zone-pill-card__links">
                <a href="/zones-intervention/mayenne/">Mayenne (53) &rarr;</a>
                <a href="/zones-intervention/loire-atlantique/">Loire-Atlantique (44) &rarr;</a>
                <a href="/zones-intervention/maine-et-loire/">Maine-et-Loire (49) &rarr;</a>
              </div>
            </div>

            <div class="zone-pill-card zone-pill-card--highlight">
              <span class="zone-pill-card__tag">Accompagnement à distance</span>
              <h3 class="zone-pill-card__title">France entière (visioconférence)</h3>
              <p class="zone-pill-card__desc">Points réguliers en visio, partage d'écran en direct sur Search Console et livrables partagés pour les entreprises de toute la France.</p>
              <div class="zone-pill-card__links">
                <a href="/zones-intervention/">Toutes les zones d'intervention &rarr;</a>
                <a href="/contact/">Demander un diagnostic &rarr;</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════
         09. BLOG (ARTICLES & RESSOURCES)
    ══════════════════════════════════════ -->
    <section class="home-blog section section--surface" aria-labelledby="blog-heading">
      <div class="container">
        <div class="section-header">
          <div class="home-blog__header-row">
            <div>
              <p class="eyebrow">Publications &amp; Guides Pratiques</p>
              <h2 id="blog-heading">Dernières analyses SEO &amp; GEO</h2>
            </div>
            <a href="/blog/" class="btn btn--secondary home-blog__all-link">
              Tous les articles &rarr;
            </a>
          </div>
          <p class="lead" style="margin-top: var(--space-4)">
            Des guides méthodologiques, des études sur le référencement local à Rennes et en Bretagne, et des décryptages concrets sur les moteurs de réponse IA.
          </p>
        </div>

        {latestPosts.length > 0 ? (
          <div class="grid-3">
            {latestPosts.map((post) => {
              const slug = post.id.replace(/\.mdx?$/, '');
              return (
                <BlogCard
                  title={post.data.title}
                  slug={slug}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  featuredImage={post.data.featuredImage}
                  featuredImageAlt={post.data.featuredImageAlt}
                  categories={post.data.categories}
                />
              );
            })}
          </div>
        ) : (
          <div class="home-blog__empty">
            <p>
              Les articles d'analyse sont consultables dans l'espace <a href="/blog/">Blog</a>.
            </p>
          </div>
        )}
      </div>
    </section>

    <!-- ══════════════════════════════════════
         10. FAQ
    ══════════════════════════════════════ -->
    <FAQ items={faqGeneral} heading="Questions fréquentes sur le SEO & le GEO" />

    <!-- ══════════════════════════════════════
         11. CTA FINAL
    ══════════════════════════════════════ -->
    <CTA
      heading="Construisons une visibilité durable et rentable pour votre entreprise."
      body="Échangeons pendant 30 minutes sur votre site actuel, vos concurrents et les opportunités de positionnement sur Google et les moteurs IA. Premier avis honnête, sans engagement."
      primaryCTA={{ label: 'Parler de votre projet', href: '/contact/' }}
      secondaryCTA={{ label: 'Réserver un appel de 30 min', href: '/reserver-un-appel/' }}
      variant="navy"
    />

  </main>

  <Footer />
</BaseLayout>

<style>
/* ══ DUO SUMMARY ══ */
.duo-summary {
  margin-top: var(--space-8);
  background: #FFFFFF;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-atlantic);
  border-radius: var(--radius-md);
  padding: var(--space-6);
}

.duo-summary__inner {
  display: flex;
  gap: var(--space-4);
  align-items: center;
}

.duo-summary__icon {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  padding: 0.35rem 0.65rem;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.duo-summary__text {
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: var(--leading-relaxed);
  margin: 0;
}

