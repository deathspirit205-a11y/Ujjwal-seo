---
/**
 * contact.astro — Contact page
 * URL: /contact/
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactForm from '../components/ContactForm.astro';
import PageHero from '../components/PageHero.astro';
import { buildTitle, SITE_URL } from '../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'Contact', href: '/contact/' },
];

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact — Ujjwal SEO',
  description: 'Contactez Ujjwal Lage, consultant SEO indépendant en Bretagne. Posez vos questions sur le référencement naturel.',
  url: `${SITE_URL}/contact/`,
  mainEntity: {
    '@type': 'ProfessionalService',
    name: 'Ujjwal SEO',
    url: SITE_URL,
    telephone: '+33757579666',
    email: 'lagechabau@gmail.com',
    address: {
      '@type': 'PostalAddress',
      streetAddress: '1 Le Petit Chevrolais',
      postalCode: '35130',
      addressLocality: 'Moutiers',
      addressRegion: 'Ille-et-Vilaine',
      addressCountry: 'FR',
    },
    areaServed: [
      { '@type': 'City', name: 'Rennes' },
      { '@type': 'City', name: 'Vitré' },
      { '@type': 'City', name: 'La Guerche-de-Bretagne' },
      { '@type': 'AdministrativeArea', name: 'Bretagne' },
      { '@type': 'Country', name: 'France' },
    ],
  },
};

const infos = [
  {
    label: 'Rayonnement & Ancrage',
    value: 'Grand Ouest & France à distance',
    note: 'Interventions physiques en Bretagne & Pays de la Loire (Rennes, Vitré, Laval, Nantes)',
  },
  {
    label: 'Délai de réponse',
    value: 'Sous 24 h ouvrées',
    note: 'Du lundi au vendredi, réponse personnalisée',
  },
  {
    label: 'Premier échange',
    value: '30 min de cadrage gratuit',
    note: 'Échange direct sur vos enjeux et votre marché, sans engagement',
  },
];
---

<BaseLayout
  title={buildTitle('Contact — Parlez de votre projet SEO & GEO')}
  description="Contactez Ujjwal Lage, consultant SEO & GEO indépendant en France. Échangeons sur votre projet, vos blocages techniques ou demandez un audit."
  canonicalPath="/contact/"
  schema={contactSchema}
>
  <Header />
  <main id="main-content">
    <PageHero
      eyebrow="Échange Direct & Devis"
      title="Parlons de votre visibilité SEO & GEO"
      description="Vous souhaitez améliorer le positionnement de votre entreprise, corriger des anomalies techniques ou anticiper les moteurs de recherche IA ? Échangeons directement."
      compact={true}
    />

    <Breadcrumbs items={breadcrumbs} />

    <section class="contact-section section">
      <div class="container">
        <div class="contact-grid">
          <!-- Left: info -->
          <div class="contact-info">
            <p class="contact-info__lead">
              Remplissez le formulaire ci-contre en décrivant votre activité et l'adresse de votre site web. Je vous réponds personnellement sous 24 heures pour convenir d'un échange ou vous transmettre de premières pistes.
            </p>

            <ul class="contact-details">
              {infos.map((info) => (
                <li class="contact-detail">
                  <div class="contact-detail__text">
                    <span class="contact-detail__label">{info.label}</span>
                    <span class="contact-detail__value">{info.value}</span>
                    <span class="contact-detail__note">{info.note}</span>
                  </div>
                </li>
              ))}
            </ul>

            <div class="contact-booking-nudge">
              <p>Vous préférez échanger immédiatement sur WhatsApp ?</p>
              <a
                href="https://wa.me/33757579666"
                class="btn btn--secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Discuter sur WhatsApp &rarr;
              </a>
            </div>
          </div>

          <!-- Right: form -->
          <div class="contact-form-wrapper">
            <ContactForm />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .contact-section {
    padding-top: var(--space-12);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  /* Info side */
  .contact-info__eyebrow {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .contact-info h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    color: var(--color-text);
    margin-bottom: var(--space-5);
    line-height: 1.2;
  }

  .contact-info__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .contact-details {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .contact-detail {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .contact-detail__icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact-detail__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .contact-detail__label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .contact-detail__value {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
  }

  .contact-detail__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .contact-booking-nudge {
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .contact-booking-nudge p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  /* Form wrapper */
  .contact-form-wrapper {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
