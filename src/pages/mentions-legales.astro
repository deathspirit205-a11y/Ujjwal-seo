---
/**
 * mentions-legales.astro — Legal notices
 * URL: /mentions-legales/
 * Per spec §35: DO NOT invent SIRET, address, or legal status.
 * Real business information must be supplied before launch.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildTitle } from '../utils/seo';
---

<BaseLayout
  title={buildTitle('Mentions légales — Ujjwal SEO')}
  description="Mentions légales du site ujjwal-seo.com — Ujjwal SEO, consultant SEO & GEO indépendant."
  canonicalPath="/mentions-legales/"
  noIndex={true}
>
  <Header />
  <main id="main-content">
    <section class="section">
      <div class="container legal-prose">
        <h1>Mentions légales</h1>

        <section aria-labelledby="editeur-heading">
          <h2 id="editeur-heading">Éditeur du site</h2>
          <p>
            <strong>Ujjwal SEO</strong><br />
            Ujjwal Lage — Consultant SEO &amp; GEO indépendant<br />
            Statut juridique : Micro-entreprise<br />
            SIRET : 944 143 957 00016<br />
            Adresse : 1 Le Petit Chevrolais, 35130 Moutiers<br />
            Contact : <a href="mailto:lagechabau@gmail.com">lagechabau@gmail.com</a>
          </p>
        </section>

        <section aria-labelledby="hebergeur-heading">
          <h2 id="hebergeur-heading">Hébergement</h2>
          <p>
            Ce site est hébergé par :<br />
            <strong>Netlify, Inc.</strong><br />
            512 2nd Street, Suite 200<br />
            San Francisco, CA 94107<br />
            États-Unis<br />
            <a href="https://www.netlify.com" target="_blank" rel="noopener noreferrer">www.netlify.com</a>
          </p>
        </section>

        <section aria-labelledby="propriete-heading">
          <h2 id="propriete-heading">Propriété intellectuelle</h2>
          <p>
            L'ensemble des contenus présents sur ce site (textes, images, structure) est la propriété
            exclusive d'Ujjwal SEO, sauf mention contraire. Toute reproduction est interdite sans
            autorisation préalable.
          </p>
        </section>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .legal-prose {
    max-width: 48rem;
  }

  .legal-prose h1 {
    margin-bottom: var(--space-10);
  }

  .legal-prose section {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .legal-prose section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .legal-prose h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-3);
  }

  .legal-prose p {
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  .legal-prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
