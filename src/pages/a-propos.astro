---
/**
 * a-propos.astro — À propos page
 * URL: /a-propos/
 * Full content: Phase 8
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildTitle } from '../utils/seo';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ujjwal Lage',
  jobTitle: 'Consultant SEO indépendant',
  url: 'https://ujjwalseo.fr/a-propos/',
  worksFor: {
    '@type': 'Organization',
    name: 'Ujjwal SEO',
    url: 'https://ujjwalseo.fr',
  },
};
---

<BaseLayout
  title={buildTitle('À propos — Ujjwal Lage, Consultant SEO à Rennes')}
  description="Découvrez Ujjwal Lage, consultant SEO indépendant à Rennes. Parcours, méthode de travail et approche SEO orientée résultats pour les entreprises bretonnes."
  canonicalPath="/a-propos/"
  schema={personSchema}
>
  <Header />
  <main id="main-content">
    <h1>À propos — Ujjwal Lage, Consultant SEO à Rennes</h1>
    <!-- Full content: Phase 8 -->
    <p><em>Page en construction — Phase 8.</em></p>
  </main>
  <Footer />
</BaseLayout>
