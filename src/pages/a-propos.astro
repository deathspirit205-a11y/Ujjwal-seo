---
/**
 * a-propos.astro — About page
 * URL: /a-propos/
 * H1: Ujjwal Lage — Consultant SEO indépendant à Rennes
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTA from '../components/CTA.astro';
import { buildTitle, SITE_URL } from '../utils/seo';

const breadcrumbs = [
  { label: 'Accueil', href: '/' },
  { label: 'À propos', href: '/a-propos/' },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ujjwal Lage',
  jobTitle: 'Consultant SEO indépendant',
  url: `${SITE_URL}/a-propos/`,
  worksFor: {
    '@type': 'Organization',
    name: 'Ujjwal SEO',
    url: SITE_URL,
  },
  knowsAbout: [
    'SEO', 'Référencement naturel', 'SEO local', 'SEO technique',
    'Audit SEO', 'Google Business Profile', 'Core Web Vitals',
    'Stratégie de contenu', 'Maillage interne',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rennes',
    addressRegion: 'Ille-et-Vilaine',
    addressCountry: 'FR',
  },
};

const valeurs = [
  {
    icon: '🎯',
    title: 'Résultats avant tout',
    description: 'Le SEO n\'a de valeur que s\'il génère du trafic qualifié et des clients. Je mesure mes actions à l\'aune de ce critère, pas de métriques vanité.',
  },
  {
    icon: '🔍',
    title: 'Transparence totale',
    description: 'Vous savez exactement ce que je fais, pourquoi, et comment mesurer l\'impact. Pas de jargon inutile, pas de mystère autour de ma méthode.',
  },
  {
    icon: '⚡',
    title: 'SEO durable, pas de raccourcis',
    description: 'Je n\'utilise que des pratiques approuvées par Google. Les résultats prennent du temps mais ils durent — sans risque de pénalités.',
  },
  {
    icon: '🤝',
    title: 'Partenariat, pas prestation',
    description: 'Je m\'implique dans votre réussite comme si c\'était mon propre projet. Votre croissance est ma satisfaction.',
  },
];

const competences = [
  { name: 'SEO local & Google Business Profile', level: 95 },
  { name: 'SEO technique & Core Web Vitals', level: 90 },
  { name: 'Stratégie de contenu & optimisation on-page', level: 88 },
  { name: 'Audit SEO complet', level: 92 },
  { name: 'Analyse de données & reporting', level: 85 },
  { name: 'Netlinking & autorité de domaine', level: 80 },
];

const outils = [
  'Google Search Console', 'Google Analytics 4', 'Screaming Frog',
  'Ahrefs / SEMrush', 'Google Business Profile', 'PageSpeed Insights',
  'Looker Studio', 'Notion', 'Slack',
];
---

<BaseLayout
  title={buildTitle('À propos — Ujjwal Lage, Consultant SEO à Rennes')}
  description="Découvrez Ujjwal Lage, consultant SEO indépendant à Rennes. Parcours, valeurs, méthode de travail et approche SEO orientée résultats pour les entreprises bretonnes."
  canonicalPath="/a-propos/"
  schema={personSchema}
>
  <Header />
  <main id="main-content">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Hero About -->
    <section class="about-hero section">
      <div class="container">
        <div class="about-hero__grid">
          <div class="about-hero__text">
            <span class="about-hero__eyebrow">À propos</span>
            <h1>Ujjwal Lage<br /><span class="accent">Consultant SEO indépendant en Bretagne</span></h1>
            <p class="about-hero__lead">
              Un regard humain et une approche concrète du web.
              J'aide les TPE, PME, artisans, commerçants et indépendants à développer
              leur visibilité en ligne.
            </p>
            <div class="about-hero__actions">
              <a href="/reserver-un-appel/" class="btn btn--primary">Réserver un appel découverte</a>
              <a href="/contact/" class="btn btn--outline">Me contacter</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mon parcours -->
    <section class="section section--alt">
      <div class="container">
        <div class="story-grid">
          <div class="story-content">
            <h2>Mon parcours</h2>
            <p>
              Mon parcours est assez différent de celui d'un consultant SEO traditionnel.
              Avant de me consacrer au web, j'ai travaillé plusieurs années dans le
              <strong>tourisme, l'hôtellerie, la gestion de projets et l'accompagnement de clients</strong>.
              Ces expériences m'ont appris une chose essentielle : derrière chaque recherche Google,
              chaque visite sur un site et chaque demande de contact, il y a avant tout une personne.
            </p>
            <p>
              Aujourd'hui, j'utilise cette expérience pour aider les TPE, PME, artisans,
              commerçants, indépendants et professions libérales à développer leur visibilité en ligne.
            </p>

            <h2>Je privilégie le concret</h2>
            <p>
              Un site internet ne doit pas seulement être esthétique. Il doit être compréhensible,
              rapide, accessible et pensé pour les personnes qui vont réellement l'utiliser.
            </p>
            <p>Mon travail associe :</p>
            <ul>
              <li>Création ou amélioration de sites web</li>
              <li>Référencement naturel (SEO)</li>
              <li>SEO local</li>
              <li>Optimisation technique et des contenus</li>
              <li>Structure et expérience utilisateur</li>
              <li>Accompagnement personnalisé</li>
            </ul>
            <p>
              Je prends le temps de comprendre votre activité, vos clients et vos objectifs
              avant de proposer des solutions. L'objectif n'est pas de multiplier les fonctionnalités
              ou de promettre des résultats irréalistes, mais de construire une présence en ligne
              utile, crédible et durable.
            </p>

            <h2>Une collaboration simple et transparente</h2>
            <p>
              Je travaille directement avec mes clients, sans multiplier les intermédiaires.
              Vous savez ce qui est réalisé, pourquoi c'est réalisé et quelles sont les prochaines étapes.
              Lorsque quelque chose n'est pas nécessaire, je préfère le dire plutôt que de vous le vendre.
            </p>
            <p>
              Votre site doit travailler pour votre activité, pas simplement exister sur internet.
            </p>
          </div>
          <div class="story-aside">
            <div class="info-card">
              <div class="info-card__item">
                <span class="info-card__label">Localisation</span>
                <span class="info-card__value">Bretagne (Ille-et-Vilaine)</span>
              </div>
              <div class="info-card__item">
                <span class="info-card__label">Statut</span>
                <span class="info-card__value">Micro-entreprise</span>
              </div>
              <div class="info-card__item">
                <span class="info-card__label">Zones d'intervention</span>
                <span class="info-card__value">Rennes · Vitré · La Guerche-de-Bretagne · Bretagne</span>
              </div>
              <div class="info-card__item">
                <span class="info-card__label">Spécialités</span>
                <span class="info-card__value">SEO local · SEO technique · Audit SEO</span>
              </div>
              <div class="info-card__item">
                <span class="info-card__label">Langues</span>
                <span class="info-card__value">Français · Anglais</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Valeurs -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Ce en quoi je crois</h2>
        <p class="section-subtitle">
          Quatre principes qui guident chaque mission, chaque recommandation, chaque rapport.
        </p>
        <div class="valeurs-grid">
          {valeurs.map((v) => (
            <article class="valeur-card">
              <span class="valeur-card__icon" aria-hidden="true">{v.icon}</span>
              <h3 class="valeur-card__title">{v.title}</h3>
              <p class="valeur-card__desc">{v.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Compétences -->
    <section class="section section--alt">
      <div class="container">
        <h2 class="section-title">Mes compétences SEO</h2>
        <div class="competences-grid">
          {competences.map((c) => (
            <div class="competence-item">
              <div class="competence-item__header">
                <span class="competence-item__name">{c.name}</span>
                <span class="competence-item__level">{c.level} %</span>
              </div>
              <div class="competence-item__bar" role="progressbar" aria-valuenow={c.level} aria-valuemin={0} aria-valuemax={100} aria-label={c.name}>
                <div class="competence-item__fill" style={`width: ${c.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Outils -->
    <section class="section">
      <div class="container">
        <h2 class="section-title">Outils & technologies</h2>
        <p class="section-subtitle">Les outils que j'utilise au quotidien pour analyser, optimiser et mesurer.</p>
        <div class="outils-grid">
          {outils.map((outil) => (
            <span class="outil-tag">{outil}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- Ma méthode -->
    <section class="methode section section--alt">
      <div class="container">
        <h2 class="section-title">Ma méthode de travail</h2>
        <div class="methode-grid">
          <article class="methode-step">
            <span class="methode-step__num">1</span>
            <h3>Je comprends votre business</h3>
            <p>Avant toute optimisation, je prends le temps de comprendre votre activité, vos clients cibles, votre zone géographique et vos objectifs commerciaux. Le SEO doit servir votre stratégie, pas l'inverse.</p>
          </article>
          <article class="methode-step">
            <span class="methode-step__num">2</span>
            <h3>J'analyse avant d'agir</h3>
            <p>Un audit complet du site, des mots-clés et de la concurrence. Pas de recommandation sans données. Je priorise les actions à fort impact pour éviter de disperser les efforts.</p>
          </article>
          <article class="methode-step">
            <span class="methode-step__num">3</span>
            <h3>J'optimise avec rigueur</h3>
            <p>Corrections techniques, optimisation des pages, stratégie de contenu. Chaque action est documentée et justifiée. Vous savez toujours ce qui a été fait sur votre site.</p>
          </article>
          <article class="methode-step">
            <span class="methode-step__num">4</span>
            <h3>Je mesure et j'ajuste</h3>
            <p>Reporting mensuel avec les positions, le trafic organique et les conversions. Si quelque chose ne fonctionne pas comme prévu, j'adapte la stratégie. La transparence est non-négociable.</p>
          </article>
        </div>
      </div>
    </section>

    <CTA
      title="Travaillons ensemble"
      description="Prêt à améliorer votre visibilité sur Google ? Parlons de votre projet lors d'un premier appel gratuit de 30 minutes."
      primaryLabel="Réserver un appel découverte"
      primaryHref="/reserver-un-appel/"
      secondaryLabel="Voir mes réalisations"
      secondaryHref="/realisations/"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .about-hero {
    padding-top: var(--space-12);
  }

  .about-hero__grid {
    max-width: 720px;
  }

  .about-hero__eyebrow {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .about-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
    margin-bottom: var(--space-6);
    color: var(--color-text);
  }

  .about-hero h1 .accent {
    color: var(--color-accent);
    font-size: 0.75em;
    display: block;
    margin-top: var(--space-1);
  }

  .about-hero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 560px;
  }

  .about-hero__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
  }



  /* Story */
  .story-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--space-12);
    align-items: start;
  }

  .story-content h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
    color: var(--color-text);
  }

  .story-content p {
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: var(--space-4);
  }

  .info-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .info-card__item {
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .info-card__item:last-child {
    border-bottom: none;
  }

  .info-card__label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .info-card__value {
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
  }

  /* Valeurs */
  .valeurs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .valeur-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .valeur-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .valeur-card__icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--space-3);
  }

  .valeur-card__title {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .valeur-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  /* Compétences */
  .competences-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 680px;
  }

  .competence-item__header {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .competence-item__name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }

  .competence-item__level {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .competence-item__bar {
    height: 6px;
    background: var(--color-border);
    border-radius: 100px;
    overflow: hidden;
  }

  .competence-item__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-accent), #6ec98f);
    border-radius: 100px;
    transition: width 1s ease;
  }

  /* Outils */
  .outils-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .outil-tag {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    font-weight: 500;
  }

  /* Méthode */
  .methode-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .methode-step {
    position: relative;
    padding: var(--space-6);
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .methode-step__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--color-accent);
    color: white;
    border-radius: 50%;
    font-weight: 700;
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .methode-step h3 {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-3);
  }

  .methode-step p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .about-hero__grid {
      max-width: 100%;
    }

    .story-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
