---
/**
 * 404.astro — Custom 404 error page
 * Light, natural editorial style with helpful navigation links.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildTitle } from '../utils/seo';
---

<BaseLayout
  title={buildTitle('Page introuvable — Ujjwal SEO')}
  description="La page que vous recherchez n'existe pas ou a été déplacée."
  canonicalPath="/404/"
  noIndex={true}
>
  <Header />
  <main id="main-content">
    <section class="error-hero">
      <div class="container error-hero__content">
        <p class="error-hero__code">404</p>
        <h1 class="error-hero__title">Page introuvable</h1>
        <p class="error-hero__desc">
          La page que vous recherchez n'existe pas ou a changé d'adresse. Voici les pages principales pour poursuivre votre navigation :
        </p>
        <div class="error-hero__actions">
          <a href="/" class="btn btn--lg btn--primary">Retour à l'accueil</a>
          <a href="/services/" class="btn btn--lg btn--secondary">Voir les services SEO &amp; GEO</a>
          <a href="/contact/" class="btn btn--lg btn--secondary">Me contacter</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
.error-hero {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  background-color: var(--color-bg);
  padding-block: var(--space-20);
}

.error-hero__code {
  font-family: var(--font-serif);
  font-size: clamp(4.5rem, 10vw, 8rem);
  font-weight: var(--weight-bold);
  line-height: 1;
  color: var(--color-accent-soft);
  letter-spacing: -0.04em;
  margin-bottom: var(--space-3);
}

.error-hero__title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 4.5vw, 2.85rem);
  font-weight: var(--weight-bold);
  color: var(--color-navy);
  margin-bottom: var(--space-4);
}

.error-hero__desc {
  font-size: var(--text-lg);
  color: var(--color-text-muted);
  margin-bottom: var(--space-8);
  max-width: 34rem;
  margin-inline: auto;
}

.error-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  justify-content: center;
}

@media (max-width: 480px) {
  .error-hero__actions {
    flex-direction: column;
  }
  .error-hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
}
</style>
