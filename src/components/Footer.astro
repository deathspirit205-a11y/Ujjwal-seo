---
/**
 * Footer.astro
 * Site-wide footer: brand statement, navigation clusters, legal links, copyright.
 */
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { label: 'SEO Local',           href: '/services/seo-local/' },
  { label: 'SEO Technique',       href: '/services/seo-technique/' },
  { label: 'SEO On-Page',         href: '/services/seo-on-page/' },
  { label: 'Audit SEO',           href: '/services/audit-seo/' },
  { label: 'Accompagnement SEO',  href: '/services/accompagnement-seo/' },
];

const localLinks = [
  { label: 'SEO Rennes',   href: '/seo-rennes/' },
  { label: 'SEO Bretagne', href: '/seo-bretagne/' },
];

const infoLinks = [
  { label: 'À propos',     href: '/a-propos/' },
  { label: 'Réalisations', href: '/realisations/' },
  { label: 'Blog',         href: '/blog/' },
  { label: 'Contact',      href: '/contact/' },
];
---

<footer class="site-footer">
  <div class="container">

    <div class="site-footer__top">

      <!-- Brand column -->
      <div class="site-footer__brand">
        <a href="/" class="footer-logo" aria-label="Ujjwal SEO">
          <span class="footer-logo__name">Ujjwal</span>
          <span class="footer-logo__seo"> SEO</span>
        </a>
        <p class="site-footer__tagline">
          Consultant SEO indépendant à Rennes et en Bretagne.
          Stratégie SEO claire, technique et adaptée à votre activité.
        </p>
        <a href="/reserver-un-appel/" class="btn btn--primary btn--sm">
          Réserver un appel
        </a>

        <!-- Social media links -->
        <div class="footer-social" aria-label="Réseaux sociaux">
          <a
            href="https://www.linkedin.com/in/ujjwal2050"
            class="footer-social__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suivre Ujjwal Lage sur LinkedIn"
          >in</a>
          <a
            href="https://www.instagram.com/seo_ujjwalfr/"
            class="footer-social__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suivre sur Instagram"
          >Ig</a>
          <a
            href="https://www.facebook.com/profile.php?id=61589067783854"
            class="footer-social__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Page Facebook Ujjwal SEO"
          >Fb</a>
          <a
            href="https://wa.me/33757579666"
            class="footer-social__link footer-social__link--wa"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contacter sur WhatsApp"
          >WA</a>
        </div>
      </div>

      <!-- Navigation columns -->
      <nav aria-label="Navigation pied de page" class="site-footer__nav">

        <div class="footer-nav-col">
          <h3 class="footer-nav-col__title">Services</h3>
          <ul>
            {serviceLinks.map(({ label, href }) => (
              <li><a href={href} class="footer-nav-col__link">{label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-nav-col">
          <h3 class="footer-nav-col__title">Zones géographiques</h3>
          <ul>
            {localLinks.map(({ label, href }) => (
              <li><a href={href} class="footer-nav-col__link">{label}</a></li>
            ))}
          </ul>

          <h3 class="footer-nav-col__title" style="margin-top: var(--space-6);">Informations</h3>
          <ul>
            {infoLinks.map(({ label, href }) => (
              <li><a href={href} class="footer-nav-col__link">{label}</a></li>
            ))}
          </ul>
        </div>

      </nav>
    </div>

    <!-- Footer bottom bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {currentYear} Ujjwal SEO. Tous droits réservés.
      </p>
      <nav aria-label="Liens légaux" class="site-footer__legal">
        <a href="/mentions-legales/" class="site-footer__legal-link">Mentions légales</a>
        <a href="/politique-confidentialite/" class="site-footer__legal-link">Politique de confidentialité</a>
      </nav>
    </div>

  </div>
</footer>

<style>
.site-footer {
  background-color: var(--color-surface-dark);
  color: var(--color-text-inverse);
  padding-top: var(--space-16);
  padding-bottom: var(--space-8);
}

/* Top area: brand + nav */
.site-footer__top {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: var(--space-16);
  padding-bottom: var(--space-12);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  margin-bottom: var(--space-8);
}

@media (max-width: 768px) {
  .site-footer__top {
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
}

/* Brand column */
.site-footer__brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  max-width: 22rem;
}

.footer-logo {
  text-decoration: none;
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-tight);
  line-height: 1;
  transition: opacity var(--transition-fast);
}

.footer-logo:hover {
  opacity: 0.85;
}

.footer-logo__name {
  color: var(--color-text-inverse);
}

.footer-logo__seo {
  color: var(--color-accent-light);
}

.site-footer__tagline {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: rgba(249, 246, 241, 0.65);
}

/* Social links row */
.footer-social {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
}

.footer-social__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid rgba(249, 246, 241, 0.2);
  border-radius: var(--radius-md);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: rgba(249, 246, 241, 0.7);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: background-color var(--transition-fast),
              color var(--transition-fast),
              border-color var(--transition-fast);
}

.footer-social__link:hover {
  background-color: var(--color-accent);
  border-color: var(--color-accent);
  color: white;
}

.footer-social__link--wa {
  background-color: rgba(37, 211, 102, 0.15);
  border-color: rgba(37, 211, 102, 0.3);
  color: #25D366;
}

.footer-social__link--wa:hover {
  background-color: #25D366;
  color: white;
}

/* Nav columns */
.site-footer__nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-8);
}

@media (max-width: 480px) {
  .site-footer__nav {
    grid-template-columns: 1fr;
  }
}

.footer-nav-col__title {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: rgba(249, 246, 241, 0.45);
  margin-bottom: var(--space-4);
}

.footer-nav-col ul {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.footer-nav-col__link {
  font-size: var(--text-sm);
  color: rgba(249, 246, 241, 0.75);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer-nav-col__link:hover {
  color: var(--color-text-inverse);
}

/* Bottom bar */
.site-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.site-footer__copyright {
  font-size: var(--text-xs);
  color: rgba(249, 246, 241, 0.4);
}

.site-footer__legal {
  display: flex;
  gap: var(--space-6);
}

.site-footer__legal-link {
  font-size: var(--text-xs);
  color: rgba(249, 246, 241, 0.4);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.site-footer__legal-link:hover {
  color: rgba(249, 246, 241, 0.75);
}
</style>
