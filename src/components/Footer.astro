---
/**
 * Footer.astro
 * Site-wide footer: Consultant SEO & GEO branding, core services, zones, navigation, legal.
 */
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { label: 'SEO Technique', href: '/services/seo-technique/' },
  { label: 'SEO Contenu & Sémantique', href: '/services/seo-contenu/' },
  { label: 'SEO Local', href: '/services/seo-local/' },
  { label: 'Audit SEO', href: '/services/audit-seo/' },
  { label: 'Stratégie SEO', href: '/services/strategie-seo/' },
  { label: 'GEO (Search IA)', href: '/services/geo/' },
];

const navigationLinks = [
  { label: 'Accueil', href: '/' },
  { label: 'Services', href: '/services/' },
  { label: 'Approche', href: '/approche/' },
  { label: 'À propos', href: '/a-propos/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];

const zoneLinks = [
  { label: 'Carte & zones d\'intervention', href: '/zones-intervention/' },
  { label: 'SEO Rennes', href: '/zones-intervention/seo-rennes/' },
  { label: 'Bretagne & Ille-et-Vilaine', href: '/zones-intervention/ille-et-vilaine/' },
  { label: 'Mayenne & Pays de la Loire', href: '/zones-intervention/mayenne/' },
  { label: 'Accompagnement France entière (à distance)', href: '/contact/' },
];
---

<footer class="site-footer">
  <div class="container">

    <div class="site-footer__top">

      <!-- Brand column -->
      <div class="site-footer__brand">
        <a href="/" class="footer-logo" aria-label="Ujjwal SEO — Consultant SEO & GEO">
          <span class="footer-logo__name">Ujjwal</span>
          <span class="footer-logo__seo"> SEO</span>
        </a>
        <div class="footer-badge">Consultant SEO & GEO</div>
        <p class="site-footer__tagline">
          Accompagnement indépendant en visibilité organique et compréhension d'entités pour les entreprises : moteurs de recherche traditionnels et nouveaux espaces de réponse assistés par l'IA.
        </p>
        <div class="site-footer__cta">
          <a href="/contact/" class="btn btn--primary btn--sm">
            Parler de votre projet
          </a>
        </div>

        <!-- Social media links -->
        <div class="footer-social" aria-label="Réseaux sociaux et contact direct">
          <a
            href="https://www.linkedin.com/in/ujjwal2050"
            class="footer-social__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Profil LinkedIn d'Ujjwal Lage"
          >in</a>
          <a
            href="https://www.instagram.com/seo_ujjwalfr/"
            class="footer-social__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram Ujjwal SEO"
          >Ig</a>
          <a
            href="https://www.facebook.com/profile.php?id=61589067783854"
            class="footer-social__link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Page Facebook Ujjwal SEO"
          >Fb</a>
          <a
            href="https://wa.me/33757579666"
            class="footer-social__link footer-social__link--wa"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Échanger directement sur WhatsApp"
          >WA</a>
        </div>
      </div>

      <!-- Navigation columns -->
      <nav aria-label="Navigation pied de page" class="site-footer__nav">

        <div class="footer-nav-col">
          <h3 class="footer-nav-col__title">Expertises & Services</h3>
          <ul>
            {serviceLinks.map(({ label, href }) => (
              <li><a href={href} class="footer-nav-col__link">{label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-nav-col">
          <h3 class="footer-nav-col__title">Navigation</h3>
          <ul>
            {navigationLinks.map(({ label, href }) => (
              <li><a href={href} class="footer-nav-col__link">{label}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-nav-col">
          <h3 class="footer-nav-col__title">Rayonnement & Zones</h3>
          <ul>
            {zoneLinks.map(({ label, href }) => (
              <li><a href={href} class="footer-nav-col__link">{label}</a></li>
            ))}
          </ul>
        </div>

      </nav>
    </div>

    <!-- Footer bottom bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__copyright">
        &copy; {currentYear} Ujjwal SEO &bull; Consultant SEO & GEO indépendant &bull; Tous droits réservés.
      </p>
      <nav aria-label="Liens légaux" class="site-footer__legal">
        <a href="/mentions-legales/" class="site-footer__legal-link">Mentions légales</a>
        <a href="/politique-confidentialite/" class="site-footer__legal-link">Politique de confidentialité</a>
      </nav>
    </div>

  </div>
</footer>

<style>
.site-footer {
  background-color: var(--color-navy);
  color: var(--color-text-inverse);
  padding-top: var(--space-16);
  padding-bottom: var(--space-8);
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

/* Top area: brand + nav */
.site-footer__top {
  display: grid;
  grid-template-columns: 1.2fr 2fr;
  gap: var(--space-12);
  padding-bottom: var(--space-12);
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  margin-bottom: var(--space-8);
}

@media (max-width: 900px) {
  .site-footer__top {
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
}

/* Brand column */
.site-footer__brand {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  max-width: 24rem;
}

.footer-logo {
  text-decoration: none;
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: var(--weight-bold);
  letter-spacing: var(--tracking-tight);
  line-height: 1;
  transition: opacity var(--transition-fast);
}

.footer-logo:hover {
  opacity: 0.85;
}

.footer-logo__name {
  color: #FFFFFF;
}

.footer-logo__seo {
  color: var(--color-atlantic);
}

.footer-badge {
  display: inline-block;
  align-self: flex-start;
  font-family: var(--font-sans);
  font-size: 0.72rem;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #93C5FD;
  background: rgba(37, 99, 235, 0.15);
  border: 1px solid rgba(147, 197, 253, 0.25);
  padding: 0.2rem 0.6rem;
  border-radius: var(--radius-full);
}

.site-footer__tagline {
  font-size: var(--text-sm);
  line-height: var(--leading-relaxed);
  color: rgba(255, 255, 255, 0.68);
  margin: 0;
}

.site-footer__cta {
  margin-top: var(--space-2);
}

/* Social links row */
.footer-social {
  display: flex;
  gap: var(--space-2);
  flex-wrap: wrap;
  margin-top: var(--space-2);
}

.footer-social__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-sm);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: rgba(255, 255, 255, 0.75);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: background-color var(--transition-fast),
              color var(--transition-fast),
              border-color var(--transition-fast);
}

.footer-social__link:hover {
  background-color: var(--color-atlantic);
  border-color: var(--color-atlantic);
  color: #FFFFFF;
}

.footer-social__link--wa {
  background-color: rgba(37, 211, 102, 0.12);
  border-color: rgba(37, 211, 102, 0.3);
  color: #25D366;
}

.footer-social__link--wa:hover {
  background-color: #25D366;
  border-color: #25D366;
  color: #FFFFFF;
}

/* Nav columns */
.site-footer__nav {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-6);
}

@media (max-width: 640px) {
  .site-footer__nav {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
}

.footer-nav-col__title {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: var(--space-4);
}

.footer-nav-col ul {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-nav-col__link {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.72);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.footer-nav-col__link:hover {
  color: #FFFFFF;
}

/* Bottom bar */
.site-footer__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.site-footer__copyright {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.45);
  margin: 0;
}

.site-footer__legal {
  display: flex;
  gap: var(--space-6);
}

.site-footer__legal-link {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.45);
  text-decoration: none;
  transition: color var(--transition-fast);
}

.site-footer__legal-link:hover {
  color: rgba(255, 255, 255, 0.85);
}
</style>

