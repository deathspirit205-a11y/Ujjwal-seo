---
/**
 * MethodTimeline.astro
 * Horizontal timeline of the 5-step method with indicative time markers.
 * Replaces the text-heavy step list on the homepage.
 */
export interface Step {
  title: string;
  when: string;
  description: string;
}

export interface Props {
  steps: Step[];
  heading: string;
  subheading?: string;
}

const { steps, heading, subheading } = Astro.props;
---

<section class="timeline section section--warm" aria-labelledby="timeline-heading">
  <div class="container">
    <div class="section-header--centered reveal">
      <p class="eyebrow">Méthode</p>
      <h2 id="timeline-heading">{heading}</h2>
      {subheading && <p class="lead" style="margin-top: var(--space-4)">{subheading}</p>}
    </div>

    <ol class="timeline__track" role="list">
      {steps.map((step, i) => (
        <li class={`timeline__step reveal reveal-delay-${Math.min(i, 3)}`}>
          <span class="timeline__when">{step.when}</span>
          <span class="timeline__node" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="timeline__title">{step.title}</h3>
          <p class="timeline__desc">{step.description}</p>
        </li>
      ))}
    </ol>

    <p class="timeline__note">Durées indicatives : elles s'ajustent à la taille du site et à vos priorités.</p>
  </div>
</section>

<style>
.timeline__track {
  position: relative;
  list-style: none;
  padding: 0;
  margin: var(--space-12) 0 0 0;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-5);
}

.timeline__track::before {
  content: '';
  position: absolute;
  top: 58px;
  left: 6%;
  right: 6%;
  height: 2px;
  background: linear-gradient(90deg, var(--color-atlantic), var(--color-highlight));
  opacity: 0.5;
}

.timeline__step {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.timeline__when {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: var(--weight-semibold);
  letter-spacing: 0.04em;
  color: var(--color-text-muted);
  text-transform: uppercase;
  margin-bottom: var(--space-3);
  min-height: 1.2em;
}

.timeline__node {
  position: relative;
  z-index: 1;
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2px solid var(--color-atlantic);
  font-family: var(--font-mono);
  font-weight: var(--weight-bold);
  font-size: var(--text-sm);
  color: var(--color-navy);
  box-shadow: 0 0 0 6px var(--color-surface-warm);
  transition: transform var(--transition-base), background var(--transition-base), color var(--transition-base);
}

.timeline__step:last-child .timeline__node {
  border-color: var(--color-highlight);
}

.timeline__step:hover .timeline__node {
  transform: scale(1.08);
  background: var(--color-navy);
  color: #FFFFFF;
}

.timeline__title {
  margin-top: var(--space-4);
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  color: var(--color-navy);
}

.timeline__desc {
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-normal);
  max-width: 15rem;
}

.timeline__note {
  margin-top: var(--space-10);
  text-align: center;
  font-size: var(--text-xs);
  color: var(--color-text-subtle);
}

@media (max-width: 900px) {
  .timeline__track {
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-left: var(--space-2);
  }

  .timeline__track::before {
    top: 0;
    bottom: 0;
    left: 33px;
    right: auto;
    width: 2px;
    height: auto;
    background: linear-gradient(180deg, var(--color-atlantic), var(--color-highlight));
  }

  .timeline__step {
    display: grid;
    grid-template-columns: 52px 1fr;
    column-gap: var(--space-4);
    align-items: start;
    text-align: left;
  }

  .timeline__node { grid-row: 1 / span 3; grid-column: 1; }
  .timeline__when { grid-column: 2; margin-bottom: 0; }
  .timeline__title { grid-column: 2; margin-top: var(--space-1); }
  .timeline__desc { grid-column: 2; max-width: none; }
}
</style>

