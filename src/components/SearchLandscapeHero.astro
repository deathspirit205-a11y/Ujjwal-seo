---
/**
 * SearchLandscapeHero.astro
 * Light, natural, editorial homepage hero for Ujjwal SEO.
 *
 * Visual direction (Phase 3):
 * - Natural photographic background (/assets/hero/calm-coast.jpg) with a soft, luminous
 *   editorial veil (#F7F8F5 / #EDF3F4) for effortless readability and WCAG AAA contrast.
 * - Palette: #F7F8F5 main bg, #EDF3F4 secondary bg, #17324D primary navy,
 *   #397B9B Atlantic blue, #B8D1D6 soft accent, #263746 body text, #FFFFFF cards.
 * - Clear H1, realistic value proposition, 1 primary CTA + 1 secondary CTA,
 *   and an editorial Search & GEO architecture card (zero fabricated metrics).
 */

export interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const {
  eyebrow = 'Consultant SEO & GEO indépendant — Bretagne, Grand Ouest & France',
  heading = 'Consultant SEO & GEO — Développez votre visibilité sur Google et les moteurs de recherche IA.',
  subheading = "J'accompagne les PME, ETI et acteurs locaux pour attirer un trafic qualifié, structurer durablement leur présence sur Google et rendre leur expertise clairement identifiable par les moteurs génératifs (ChatGPT, Perplexity, Google AI).",
  primaryCTA = { label: 'Discuter de votre projet', href: '/contact/' },
  secondaryCTA = { label: 'Découvrir mes services', href: '/services/' },
} = Astro.props;
---

<section class="hero-editorial" aria-labelledby="hero-title">
  <!-- Natural photographic background with soft light treatment -->
  <div class="hero-editorial__media" aria-hidden="true">
    <img
      src="/assets/hero/calm-coast.jpg"
      alt=""
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-editorial__photo"
    />
    <div class="hero-editorial__veil"></div>
  </div>

  <div class="container hero-editorial__container">
    <!-- Left Column: H1, Value Proposition & CTAs -->
    <div class="hero-editorial__content">
      <div class="hero-editorial__eyebrow">
        <span class="hero-editorial__dot" aria-hidden="true"></span>
        <span>{eyebrow}</span>
      </div>

      <h1 id="hero-title" class="hero-editorial__title">
        Consultant SEO &amp; GEO — <span class="hero-editorial__title-accent">Développez votre visibilité sur Google et les moteurs de recherche IA.</span>
      </h1>

      <p class="hero-editorial__lead">
        {subheading}
      </p>

      <div class="hero-editorial__actions">
        <a href={primaryCTA.href} class="btn btn--primary btn--lg">
          {primaryCTA.label}
          <svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={secondaryCTA.href} class="btn btn--secondary btn--lg">
          {secondaryCTA.label}
        </a>
      </div>

      <!-- Consultant identity & direct contact assurance -->
      <div class="hero-consultant">
        <img
          src="/assets/ujjwal-lage-portrait.jpg"
          alt="Ujjwal Lage, consultant SEO et GEO indépendant"
          width="52"
          height="52"
          class="hero-consultant__avatar"
          loading="eager"
          decoding="async"
        />
        <div class="hero-consultant__info">
          <p class="hero-consultant__name">
            <strong>Ujjwal Lage</strong> · Interlocuteur unique du diagnostic à l'exécution
          </p>
          <p class="hero-consultant__meta">
            <span class="hero-consultant__status-dot" aria-hidden="true"></span>
            Basé dans le Grand Ouest (Rennes / Vitré) · Réponse sous 24 h ouvrées
          </p>
        </div>
      </div>
    </div>

    <!-- Right Column: Editorial Search & GEO Architecture Panel -->
    <aside class="hero-editorial__panel" aria-label="Architecture de visibilité SEO et GEO">
      <div class="editorial-card">
        <div class="editorial-card__header">
          <span class="editorial-card__tag">Approche complémentaire</span>
          <span class="editorial-card__caption">SEO Classique + Search IA (GEO)</span>
        </div>

        <p class="editorial-card__intro">
          Une même fondation technique et éditoriale nourrit aujourd'hui deux canaux d'acquisition complémentaires :
        </p>

        <!-- Dual channel visual diagram -->
        <div class="editorial-channels">
          <div class="channel-box">
            <div class="channel-box__head">
              <span class="channel-box__badge channel-box__badge--seo">01 · SEO Google &amp; Maps</span>
              <span class="channel-box__goal">Capter la demande active</span>
            </div>
            <p class="channel-box__desc">
              Positionner vos pages de services et votre fiche Google Business Profile face aux décideurs et clients qui recherchent vos prestations.
            </p>
            <ul class="channel-box__list">
              <li>Indexation propre &amp; Core Web Vitals</li>
              <li>Pages ciblées par intention de recherche</li>
              <li>Ancrage local (Rennes, Vitré, Laval, Grand Ouest)</li>
            </ul>
          </div>

          <div class="channel-box channel-box--geo">
            <div class="channel-box__head">
              <span class="channel-box__badge channel-box__badge--geo">02 · GEO &amp; Moteurs IA</span>
              <span class="channel-box__goal">Être compris &amp; cité</span>
            </div>
            <p class="channel-box__desc">
              Structurer vos contenus, vos preuves et vos données Schema.org pour que ChatGPT, Perplexity et Google AI identifient votre entreprise sans ambiguïté.
            </p>
            <ul class="channel-box__list">
              <li>Graphe d'entités JSON-LD relié (<code>@id</code>)</li>
              <li>Réponses factuelles directement extractibles</li>
              <li>Cohérence des sources et citations externes</li>
            </ul>
          </div>
        </div>

        <!-- Bottom synthesis bar -->
        <div class="editorial-card__footer">
          <div class="editorial-card__outcome">
            <strong>Objectif :</strong> transformer votre site en un actif durable qui attire un trafic qualifié et génère des opportunités commerciales mesurables.
          </div>
          <a href="/approche/" class="editorial-card__link">
            Voir la méthodologie en 8 étapes &rarr;
          </a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
.hero-editorial {
  position: relative;
  background-color: var(--color-bg); /* #F7F8F5 */
  color: var(--color-text);          /* #263746 */
  padding-top: var(--space-16);
  padding-bottom: var(--space-20);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}

/* Photographic background with natural light veil */
.hero-editorial__media {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.hero-editorial__photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 40%;
  opacity: 0.28;
  filter: saturate(0.85) contrast(0.95);
}

.hero-editorial__veil {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      105deg,
      rgba(247, 248, 245, 0.96) 0%,
      rgba(247, 248, 245, 0.90) 48%,
      rgba(237, 243, 244, 0.78) 100%
    );
}

.hero-editorial__container {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.12fr 0.88fr;
  gap: var(--space-12);
  align-items: center;
}

/* Left content */
.hero-editorial__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.4rem 0.9rem;
  background-color: #FFFFFF;
  border: 1px solid var(--color-accent-soft); /* #B8D1D6 */
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-navy); /* #17324D */
  margin-bottom: var(--space-6);
  box-shadow: var(--shadow-xs);
}

.hero-editorial__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--color-atlantic); /* #397B9B */
  flex-shrink: 0;
}

.hero-editorial__title {
  font-family: var(--font-serif);
  font-size: clamp(2.15rem, 4.1vw, 3.35rem);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -0.025em;
  color: var(--color-navy); /* #17324D */
  margin-bottom: var(--space-6);
}

.hero-editorial__title-accent {
  color: var(--color-atlantic); /* #397B9B */
  font-weight: 600;
}

.hero-editorial__lead {
  font-size: clamp(1.05rem, 1.35vw, 1.2rem);
  line-height: 1.7;
  color: var(--color-text); /* #263746 */
  max-width: 39rem;
  margin-bottom: var(--space-8);
}

.hero-editorial__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

.btn__arrow {
  margin-left: 0.25rem;
  transition: transform var(--transition-fast);
}

.btn:hover .btn__arrow {
  transform: translateX(3px);
}

/* Consultant trust badge */
.hero-consultant {
  display: inline-flex;
  align-items: center;
  gap: var(--space-4);
  padding: 0.65rem 1.25rem 0.65rem 0.65rem;
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.hero-consultant__avatar {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center 18%;
  border: 2px solid var(--color-accent-soft);
  flex-shrink: 0;
}

.hero-consultant__info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.hero-consultant__name {
  font-size: var(--text-sm);
  color: var(--color-navy);
  margin: 0;
}

.hero-consultant__meta {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: var(--text-xs);
  color: var(--color-text-muted);
  margin: 0;
}

.hero-consultant__status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: #2E7D5B;
  flex-shrink: 0;
}

/* Right Column: Editorial Card */
.editorial-card {
  background-color: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(8px);
  border: 1px solid var(--color-accent-soft);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  box-shadow: 0 16px 40px -12px rgba(23, 50, 77, 0.10);
}

.editorial-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-bottom: var(--space-4);
  margin-bottom: var(--space-4);
  border-bottom: 1px solid var(--color-border-light);
}

.editorial-card__tag {
  font-size: 0.72rem;
  font-weight: var(--weight-semibold);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-navy);
  background-color: var(--color-surface-warm); /* #EDF3F4 */
  border: 1px solid var(--color-accent-soft);
  padding: 0.25rem 0.65rem;
  border-radius: var(--radius-full);
}

.editorial-card__caption {
  font-size: var(--text-xs);
  font-weight: var(--weight-medium);
  color: var(--color-text-muted);
}

.editorial-card__intro {
  font-size: var(--text-sm);
  color: var(--color-text);
  line-height: 1.55;
  margin-bottom: var(--space-4);
}

.editorial-channels {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-5);
}

.channel-box {
  background-color: var(--color-bg); /* #F7F8F5 */
  border: 1px solid var(--color-border);
  border-left: 3px solid var(--color-navy);
  border-radius: var(--radius-md);
  padding: var(--space-4);
}

.channel-box--geo {
  background-color: var(--color-surface-warm); /* #EDF3F4 */
  border-left-color: var(--color-atlantic);
}

.channel-box__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  margin-bottom: var(--space-2);
  flex-wrap: wrap;
}

.channel-box__badge {
  font-size: 0.75rem;
  font-weight: var(--weight-bold);
  color: var(--color-navy);
}

.channel-box__badge--geo {
  color: var(--color-atlantic);
}

.channel-box__goal {
  font-size: 0.72rem;
  font-weight: var(--weight-semibold);
  color: var(--color-text-muted);
  background: #FFFFFF;
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
}

.channel-box__desc {
  font-size: 0.8125rem;
  color: var(--color-text);
  line-height: 1.5;
  margin-bottom: var(--space-3);
}

.channel-box__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.channel-box__list li {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  padding-left: 1rem;
  position: relative;
}

.channel-box__list li::before {
  content: '✓';
  position: absolute;
  left: 0;
  color: var(--color-atlantic);
  font-weight: 700;
}

.channel-box__list code {
  font-size: 0.74rem;
  background: #FFFFFF;
  padding: 0.05rem 0.3rem;
  border-radius: 3px;
}

.editorial-card__footer {
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border-light);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.editorial-card__outcome {
  font-size: 0.8125rem;
  color: var(--color-text);
  line-height: 1.5;
}

.editorial-card__link {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: var(--color-atlantic);
  text-decoration: none;
  align-self: flex-start;
}

.editorial-card__link:hover {
  color: var(--color-navy);
  text-decoration: underline;
}

@media (max-width: 1024px) {
  .hero-editorial__container {
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
}

@media (max-width: 640px) {
  .hero-editorial {
    padding-top: var(--space-10);
    padding-bottom: var(--space-12);
  }

  .hero-editorial__actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-editorial__actions .btn {
    width: 100%;
  }

  .hero-consultant {
    flex-direction: row;
    width: 100%;
  }
}
</style>
