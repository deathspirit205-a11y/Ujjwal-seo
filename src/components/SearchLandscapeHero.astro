---
/**
 * SearchLandscapeHero.astro
 * Premium Hero component for Ujjwal SEO.
 * Brand positioning: Consultant SEO & GEO.
 * Visual: Deep search & generative AI performance cockpit with animated organic traffic growth graph.
 * Fully responsive, WCAG-compliant, respects prefers-reduced-motion.
 */

export interface Props {
  eyebrow?: string;
  heading?: string;
  subheading?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
}

const {
  eyebrow = 'Consultant SEO & GEO indépendant',
  heading = 'Consultant SEO & GEO',
  subheading = "J'aide les entreprises à devenir plus visibles dans Google, les moteurs de recherche traditionnels et les nouveaux moteurs alimentés par l'IA.",
  primaryCTA = { label: 'Découvrir mon approche', href: '/approche/' },
  secondaryCTA = { label: 'Parler de votre projet', href: '/contact/' },
} = Astro.props;
---

<section class="hero-landscape" aria-labelledby="hero-title">
  <!-- Dynamic Digital Background: grid + glowing traffic pathways -->
  <div class="hero-landscape__bg" aria-hidden="true">
    <div class="hero-landscape__glow hero-landscape__glow--blue"></div>
    <div class="hero-landscape__glow hero-landscape__glow--amber"></div>
    <div class="hero-landscape__grid"></div>

    <!-- Flowing ambient traffic curve waves in background -->
    <svg class="hero-landscape__waves" viewBox="0 0 1440 600" preserveAspectRatio="none" fill="none">
      <defs>
        <linearGradient id="waveGrad1" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#2563EB" stop-opacity="0.03" />
          <stop offset="50%" stop-color="#38BDF8" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.25" />
        </linearGradient>
        <linearGradient id="waveGrad2" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#1D4ED8" stop-opacity="0.08" />
          <stop offset="70%" stop-color="#60A5FA" stop-opacity="0.15" />
          <stop offset="100%" stop-color="#10B981" stop-opacity="0.12" />
        </linearGradient>
      </defs>
      <path
        d="M-40 480 C 260 490, 480 380, 780 320 C 1040 270, 1260 170, 1480 110"
        stroke="url(#waveGrad1)"
        stroke-width="2.5"
        stroke-dasharray="6 6"
        class="ambient-wave"
      />
      <path
        d="M-40 540 C 300 520, 520 440, 840 370 C 1100 310, 1280 230, 1480 180"
        stroke="url(#waveGrad2)"
        stroke-width="1.5"
      />
    </svg>
  </div>

  <div class="container hero-landscape__container">
    <!-- Left: Content & Value Proposition -->
    <div class="hero-landscape__content">
      <div class="hero-badge">
        <span class="hero-badge__dot"></span>
        <span class="hero-badge__text">{eyebrow}</span>
      </div>

      <h1 id="hero-title" class="hero-landscape__title">
        Consultant <span class="text-gradient">SEO &amp; GEO</span>
      </h1>

      <p class="hero-landscape__lead">
        {subheading}
      </p>

      <div class="hero-landscape__actions">
        <a href={primaryCTA.href} class="btn btn--accent btn--lg">
          {primaryCTA.label}
          <svg class="btn__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={secondaryCTA.href} class="btn btn--outline-light btn--lg">
          {secondaryCTA.label}
        </a>
      </div>

      <!-- Human trust chip -->
      <div class="hero-person">
        <img
          src="/assets/ujjwal-lage-portrait.jpg"
          alt="Ujjwal Lage"
          width="44"
          height="44"
          class="hero-person__avatar"
          loading="eager"
          decoding="async"
        />
        <p class="hero-person__text">
          <strong>Ujjwal Lage</strong>
          <span class="hero-person__role">Consultant direct · Pas d'intermédiaire</span>
          <span class="hero-person__status">
            <span class="hero-person__pulse" aria-hidden="true"></span>
            Réponse sous 24 h ouvrées
          </span>
        </p>
      </div>

      <!-- Search Landscape Signals -->
      <div class="hero-landscape__signals">
        <div class="signal-item">
          <span class="signal-item__indicator"></span>
          <div>
            <strong>SEO Fondamental</strong>
            <p>Technique, contenu &amp; autorité</p>
          </div>
        </div>
        <div class="signal-item">
          <span class="signal-item__indicator signal-item__indicator--geo"></span>
          <div>
            <strong>GEO Émergent</strong>
            <p>Clarté entités &amp; visibilité IA</p>
          </div>
        </div>
        <div class="signal-item">
          <span class="signal-item__indicator signal-item__indicator--france"></span>
          <div>
            <strong>France &amp; Grand Ouest</strong>
            <p>Rennes, Nantes &amp; à distance</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right: High-Tech SEO & GEO Performance Cockpit -->
    <div class="hero-landscape__visual" aria-hidden="true">
      <div class="cockpit-card">
        <!-- Cockpit Header: Status Bar -->
        <div class="cockpit-header">
          <div class="cockpit-dots">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
          </div>
          <div class="cockpit-title">
            <span class="cockpit-pulse"></span>
            Search Console &amp; Moteurs IA · Cockpit de Visibilité
          </div>
          <div class="cockpit-badge">Index 100%</div>
        </div>

        <!-- Upper Visual: Entity & Search Architecture Graph -->
        <div class="cockpit-section cockpit-section--graph">
          <svg class="cockpit-svg" viewBox="0 0 540 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="wireGlow" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.8" />
                <stop offset="100%" stop-color="#F59E0B" stop-opacity="0.8" />
              </linearGradient>
              <radialGradient id="centerGlow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.4" />
                <stop offset="100%" stop-color="#3B82F6" stop-opacity="0" />
              </radialGradient>
            </defs>

            <!-- Connecting Wireframe Traces -->
            <line x1="270" y1="100" x2="100" y2="50" stroke="rgba(96, 165, 250, 0.4)" stroke-width="1.5" stroke-dasharray="4 4" class="tracer-line" />
            <line x1="270" y1="100" x2="440" y2="50" stroke="rgba(96, 165, 250, 0.4)" stroke-width="1.5" stroke-dasharray="4 4" class="tracer-line" />
            <line x1="270" y1="100" x2="90" y2="160" stroke="rgba(16, 185, 129, 0.4)" stroke-width="1.5" />
            <line x1="270" y1="100" x2="450" y2="160" stroke="rgba(245, 158, 11, 0.4)" stroke-width="1.5" />
            <line x1="100" y1="50" x2="440" y2="50" stroke="rgba(255, 255, 255, 0.1)" stroke-width="1" />

            <!-- Core Hub: Brand Entity -->
            <circle cx="270" cy="100" r="42" fill="url(#centerGlow)" />
            <circle cx="270" cy="100" r="24" fill="#0B132B" stroke="#60A5FA" stroke-width="2.5" class="core-hub" />
            <circle cx="270" cy="100" r="5" fill="#F59E0B" />
            <text x="270" y="140" font-size="11" font-weight="700" fill="#FFFFFF" text-anchor="middle" font-family="Inter, sans-serif">VOTRE MARQUE</text>
            <text x="270" y="153" font-size="9" fill="#93C5FD" text-anchor="middle" font-family="Inter, sans-serif">Entité référente Schema.org</text>

            <!-- Node 1: Google Crawl & Index -->
            <g class="graph-node" transform="translate(100, 50)">
              <circle cx="0" cy="0" r="16" fill="#0B132B" stroke="#3B82F6" stroke-width="2" />
              <circle cx="0" cy="0" r="4" fill="#60A5FA" />
              <text x="0" y="26" font-size="9" font-weight="600" fill="#E2E8F0" text-anchor="middle" font-family="Inter, sans-serif">SEO Technique</text>
            </g>

            <!-- Node 2: Generative Engines (GEO) -->
            <g class="graph-node" transform="translate(440, 50)">
              <circle cx="0" cy="0" r="16" fill="#0B132B" stroke="#8B5CF6" stroke-width="2" />
              <circle cx="0" cy="0" r="4" fill="#C084FC" />
              <text x="0" y="26" font-size="9" font-weight="600" fill="#E2E8F0" text-anchor="middle" font-family="Inter, sans-serif">Citations IA (GEO)</text>
            </g>

            <!-- Node 3: Local Pack & Proximity -->
            <g class="graph-node" transform="translate(90, 160)">
              <circle cx="0" cy="0" r="14" fill="#0B132B" stroke="#10B981" stroke-width="2" />
              <circle cx="0" cy="0" r="3.5" fill="#34D399" />
              <text x="0" y="-18" font-size="9" font-weight="600" fill="#A7F3D0" text-anchor="middle" font-family="Inter, sans-serif">Visibilité Locale</text>
            </g>

            <!-- Node 4: Knowledge Graph & Autorité -->
            <g class="graph-node" transform="translate(450, 160)">
              <circle cx="0" cy="0" r="14" fill="#0B132B" stroke="#F59E0B" stroke-width="2" />
              <circle cx="0" cy="0" r="3.5" fill="#FBBF24" />
              <text x="0" y="-18" font-size="9" font-weight="600" fill="#FDE68A" text-anchor="middle" font-family="Inter, sans-serif">Autorité Sémantique</text>
            </g>
          </svg>
        </div>

        <!-- Lower Visual: Animated Traffic Increasing Graph -->
        <div class="cockpit-section cockpit-section--traffic">
          <div class="traffic-header">
            <div class="traffic-title">
              <span class="traffic-icon">↗</span>
              <div>
                <strong>Trafic Organique Qualifié</strong>
                <span class="traffic-subtitle">Progression après structuration SEO &amp; GEO</span>
              </div>
            </div>
            <div class="traffic-pill">
              <span class="traffic-pill__arrow">↑</span>
              <span class="traffic-pill__val">+184%</span>
              <span class="traffic-pill__tag">croissance</span>
            </div>
          </div>

          <!-- Dynamic SVG Traffic Chart -->
          <div class="traffic-chart">
            <svg class="traffic-svg" viewBox="0 0 500 160" fill="none" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <linearGradient id="trafficArea" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#3B82F6" stop-opacity="0.5" />
                  <stop offset="70%" stop-color="#1D4ED8" stop-opacity="0.15" />
                  <stop offset="100%" stop-color="#1D4ED8" stop-opacity="0" />
                </linearGradient>
                <linearGradient id="trafficStroke" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#60A5FA" />
                  <stop offset="65%" stop-color="#38BDF8" />
                  <stop offset="100%" stop-color="#F59E0B" />
                </linearGradient>
              </defs>

              <!-- Horizontal Grid Lines -->
              <line x1="30" y1="30" x2="480" y2="30" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 3" />
              <line x1="30" y1="70" x2="480" y2="70" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 3" />
              <line x1="30" y1="110" x2="480" y2="110" stroke="rgba(255,255,255,0.08)" stroke-dasharray="3 3" />
              <line x1="30" y1="140" x2="480" y2="140" stroke="rgba(255,255,255,0.15)" />

              <!-- Area Fill -->
              <path
                d="M 30 135 L 85 130 L 140 126 L 195 118 L 250 110 L 305 92 L 360 76 L 415 54 L 475 28 L 475 140 L 30 140 Z"
                fill="url(#trafficArea)"
                class="traffic-area"
              />

              <!-- The Growth Curve Line -->
              <path
                d="M 30 135 L 85 130 L 140 126 L 195 118 L 250 110 L 305 92 L 360 76 L 415 54 L 475 28"
                stroke="url(#trafficStroke)"
                stroke-width="3.5"
                stroke-linecap="round"
                class="traffic-line"
              />

              <!-- Milestones Data Points -->
              <g class="chart-point" transform="translate(140, 126)">
                <circle cx="0" cy="0" r="4" fill="#60A5FA" />
              </g>
              <g class="chart-point" transform="translate(250, 110)">
                <circle cx="0" cy="0" r="4.5" fill="#38BDF8" />
              </g>
              <g class="chart-point" transform="translate(360, 76)">
                <circle cx="0" cy="0" r="5" fill="#FBBF24" />
              </g>
              <!-- Final Top Point (Pulsing) -->
              <g class="chart-point chart-point--final" transform="translate(475, 28)">
                <circle cx="0" cy="0" r="12" fill="#F59E0B" fill-opacity="0.25" class="point-halo" />
                <circle cx="0" cy="0" r="6" fill="#F59E0B" stroke="#FFFFFF" stroke-width="2" />
              </g>

              <!-- X-Axis Labels -->
              <text x="30" y="154" font-size="9" fill="#64748B" font-family="Inter, sans-serif">Mois 1 (Audit)</text>
              <text x="170" y="154" font-size="9" fill="#64748B" font-family="Inter, sans-serif">Mois 2 (Technique)</text>
              <text x="310" y="154" font-size="9" fill="#64748B" font-family="Inter, sans-serif">Mois 4 (Entités)</text>
              <text x="440" y="154" font-size="9" font-weight="600" fill="#F59E0B" font-family="Inter, sans-serif">Mois 6 (Autorité)</text>
            </svg>
          </div>
        </div>

        <!-- Floating Live Badges -->
        <div class="cockpit-chips">
          <div class="cockpit-chip chip-1">
            <span class="chip-dot chip-dot--green"></span>
            <span>Google Search Console : Clics ↗</span>
          </div>
          <div class="cockpit-chip chip-2">
            <span class="chip-dot chip-dot--ai"></span>
            <span>IA Générative : Référence citée</span>
          </div>
          <div class="cockpit-chip chip-3">
            <span class="chip-dot chip-dot--amber"></span>
            <span>Core Web Vitals : 100/100</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
/* ══ HERO SHELL ══ */
.hero-landscape {
  position: relative;
  background-color: #070D1E;
  color: #FFFFFF;
  padding-top: var(--space-20);
  padding-bottom: var(--space-24);
  overflow: hidden;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* Dynamic Digital Background */
.hero-landscape__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.hero-landscape__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.45;
  pointer-events: none;
}

.hero-landscape__glow--blue {
  top: -10%;
  right: 5%;
  width: 55vw;
  height: 55vw;
  max-width: 650px;
  max-height: 650px;
  background: radial-gradient(circle, #1D4ED8 0%, rgba(29, 78, 216, 0) 70%);
}

.hero-landscape__glow--amber {
  bottom: -15%;
  left: 2%;
  width: 40vw;
  height: 40vw;
  max-width: 500px;
  max-height: 500px;
  background: radial-gradient(circle, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0) 70%);
}

.hero-landscape__grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: radial-gradient(circle at 60% 40%, black 40%, transparent 85%);
}

.hero-landscape__waves {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.8;
}

@media (prefers-reduced-motion: no-preference) {
  .ambient-wave {
    animation: waveShift 18s ease-in-out infinite alternate;
  }
  @keyframes waveShift {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: 80; }
  }
}

.hero-landscape__container {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: var(--space-12);
  align-items: center;
  position: relative;
  z-index: 1;
}

/* ══ LEFT CONTENT ══ */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.35rem 0.9rem;
  background-color: rgba(37, 99, 235, 0.15);
  border: 1px solid rgba(96, 165, 250, 0.3);
  border-radius: var(--radius-full);
  margin-bottom: var(--space-6);
  backdrop-filter: blur(8px);
}

.hero-badge__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: #38BDF8;
  box-shadow: 0 0 8px #38BDF8;
}

.hero-badge__text {
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: #93C5FD;
}

.hero-landscape__title {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 5vw, 4.1rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: var(--tracking-tight);
  color: #FFFFFF;
  margin-bottom: var(--space-6);
}

.text-gradient {
  background: linear-gradient(135deg, #93C5FD 0%, #38BDF8 35%, #F59E0B 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-landscape__lead {
  font-size: clamp(var(--text-lg), 1.5vw, var(--text-xl));
  color: rgba(226, 232, 240, 0.88);
  line-height: var(--leading-relaxed);
  max-width: 36rem;
  margin-bottom: var(--space-8);
}

.hero-landscape__actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-8);
}

.btn--outline-light {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
  backdrop-filter: blur(8px);
  transition: all var(--transition-base);
}

.btn--outline-light:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: #FFFFFF;
  color: #FFFFFF;
  transform: translateY(-2px);
}

.btn__arrow {
  margin-left: 0.25rem;
  transition: transform var(--transition-fast);
}

.btn:hover .btn__arrow {
  transform: translateX(3px);
}

/* ══ HUMAN TRUST CHIP ══ */
.hero-person {
  display: inline-flex;
  align-items: center;
  gap: var(--space-4);
  padding: 0.5rem 1.25rem 0.5rem 0.5rem;
  margin-bottom: var(--space-8);
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--radius-full);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(12px);
}

.hero-person__avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  object-position: center 18%;
  border: 2px solid #F59E0B;
}

.hero-person__text {
  display: flex;
  flex-direction: column;
  font-size: var(--text-sm);
  color: #FFFFFF;
  line-height: 1.35;
  margin: 0;
}

.hero-person__role {
  font-size: 0.75rem;
  color: #94A3B8;
}

.hero-person__status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  color: #34D399;
  font-weight: var(--weight-medium);
  margin-top: 2px;
}

.hero-person__pulse {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6);
}

@media (prefers-reduced-motion: no-preference) {
  .hero-person__pulse { animation: personPulse 2.4s ease-out infinite; }
  @keyframes personPulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
}

/* ══ SIGNAL CARDS ══ */
.hero-landscape__signals {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  padding-top: var(--space-6);
  border-top: 1px solid rgba(255, 255, 255, 0.12);
}

.signal-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-3);
}

.signal-item__indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: #38BDF8;
  box-shadow: 0 0 8px #38BDF8;
  margin-top: 5px;
  flex-shrink: 0;
}

.signal-item__indicator--geo {
  background-color: #A78BFA;
  box-shadow: 0 0 8px #A78BFA;
}

.signal-item__indicator--france {
  background-color: #34D399;
  box-shadow: 0 0 8px #34D399;
}

.signal-item strong {
  display: block;
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  color: #FFFFFF;
  margin-bottom: 2px;
}

.signal-item p {
  font-size: 0.75rem;
  color: #94A3B8;
  line-height: 1.4;
  margin: 0;
}

/* ══ RIGHT VISUAL: PERFORMANCE COCKPIT CARD ══ */
.hero-landscape__visual {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
}

.cockpit-card {
  position: relative;
  width: 100%;
  max-width: 580px;
  background: rgba(11, 19, 43, 0.85);
  border: 1px solid rgba(96, 165, 250, 0.25);
  border-radius: var(--radius-xl);
  box-shadow:
    0 24px 60px rgba(0, 0, 0, 0.5),
    0 0 50px rgba(37, 99, 235, 0.15),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(16px);
  overflow: visible;
  padding: var(--space-4);
}

/* Header bar */
.cockpit-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem var(--space-4);
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-4);
}

.cockpit-dots {
  display: flex;
  gap: 6px;
}

.dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
}
.dot--red { background: #EF4444; opacity: 0.7; }
