---
/**
 * ContactForm.astro
 * GDPR-aware contact form.
 * Per spec §33: minimal fields, explicit consent, no unnecessary data.
 * Netlify Forms integration (data-netlify="true") — wired in Phase 10.
 */
---

<form
  class="contact-form"
  name="contact"
  method="POST"
  action="/merci/"
  data-netlify="true"
  netlify-honeypot="bot-field"
  aria-label="Formulaire de contact"
  novalidate
>
  <!-- Netlify honeypot spam protection -->
  <p class="sr-only" aria-hidden="true">
    <label>Ne pas remplir : <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="form-row">
    <div class="form-field">
      <label for="contact-name">Nom <span aria-hidden="true">*</span></label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        autocomplete="name"
        aria-required="true"
        placeholder="Votre nom"
      />
    </div>

    <div class="form-field">
      <label for="contact-email">Adresse e-mail <span aria-hidden="true">*</span></label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
        aria-required="true"
        placeholder="vous@example.com"
      />
    </div>
  </div>

  <div class="form-field">
    <label for="contact-website">URL de votre site web</label>
    <input
      type="url"
      id="contact-website"
      name="website"
      autocomplete="url"
      placeholder="https://votre-site.fr"
    />
  </div>

  <div class="form-field">
    <label for="contact-message">Votre message <span aria-hidden="true">*</span></label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="5"
      aria-required="true"
      placeholder="Décrivez votre projet, vos objectifs et vos questions…"
    ></textarea>
  </div>

  <div class="form-field form-field--consent">
    <input
      type="checkbox"
      id="contact-consent"
      name="consent"
      required
      aria-required="true"
    />
    <label for="contact-consent">
      J'accepte que mes données soient utilisées pour traiter ma demande,
      conformément à la <a href="/politique-confidentialite/">politique de confidentialité</a>.
      Aucune donnée n'est revendue à des tiers.
    </label>
  </div>

  <button type="submit" class="btn btn--primary" id="contact-submit">
    Envoyer ma demande
  </button>
</form>

<style>
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 0;
}

/* Two-column row for name + email */
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}

@media (max-width: 640px) {
  .form-row {
    grid-template-columns: 1fr;
  }
}
</style>
