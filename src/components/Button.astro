---
/**
 * Button.astro — Reusable button/link component.
 * Variants: primary | secondary | ghost
 * Sizes: default | sm | lg
 */
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'default' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  id?: string;
  class?: string;
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  type = 'button',
  id,
  class: className,
  'aria-label': ariaLabel,
} = Astro.props;

const sizeClass = size === 'sm' ? 'btn--sm' : size === 'lg' ? 'btn--lg' : '';
const cls = ['btn', `btn--${variant}`, sizeClass, className].filter(Boolean).join(' ');
---

{href
  ? <a href={href} class={cls} id={id} aria-label={ariaLabel}><slot /></a>
  : <button type={type} class={cls} id={id} aria-label={ariaLabel}><slot /></button>
}
