---
/**
 * BookingSection.astro
 * Booking/scheduling section — booking embed wired in Phase 10.
 */
---

<section class="booking-section" aria-labelledby="booking-heading">
  <div class="container">
    <div class="booking-section__inner">

      <div class="booking-section__text">
        <p class="eyebrow">Appel découverte</p>
        <h2 id="booking-heading">Réservez un appel de 30 minutes</h2>
        <p class="lead">
          Un échange sans engagement pour discuter de votre situation,
          de vos objectifs et de la manière dont le SEO peut vous aider.
        </p>
        <ul class="booking-section__points">
          <li>30 minutes, en visioconférence</li>
          <li>Diagnostic rapide de votre visibilité actuelle</li>
          <li>Questions libres, sans jargon</li>
          <li>Aucun engagement à l'issue de l'appel</li>
        </ul>
      </div>

      <!-- Booking embed placeholder — provider connected in Phase 10 -->
      <div class="booking-embed" aria-label="Calendrier de réservation">
        <div class="booking-embed__placeholder">
          <p>
            La réservation en ligne sera disponible prochainement.<br />
            En attendant, contactez-moi directement via le
            <a href="/contact/">formulaire de contact</a>.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.booking-section {
  padding-block: var(--space-20);
  background-color: var(--color-surface-warm);
  border-top: 1px solid var(--color-border-light);
}

.booking-section__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: start;
}

@media (max-width: 860px) {
  .booking-section__inner {
    grid-template-columns: 1fr;
  }
}

.booking-section__text {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.booking-section__points {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding-left: 0;
  list-style: none;
}

.booking-section__points li {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  font-size: var(--text-sm);
  color: var(--color-text-muted);
}

/* Checkmark bullet */
.booking-section__points li::before {
  content: '✓';
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 1.25rem;
  height: 1.25rem;
  background-color: var(--color-accent-light);
  color: var(--color-accent);
  border-radius: var(--radius-full);
  font-size: 0.65rem;
  font-weight: var(--weight-bold);
  flex-shrink: 0;
}

/* Embed area */
.booking-embed {
  background-color: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  min-height: 20rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.booking-embed__placeholder {
  padding: var(--space-8);
  text-align: center;
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
}

.booking-embed__placeholder a {
  color: var(--color-accent);
  text-underline-offset: 3px;
}
</style>
