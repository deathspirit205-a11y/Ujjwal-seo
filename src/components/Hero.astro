---
/**
 * Hero.astro
 * Page hero section — the most prominent visual element of any page.
 * Full page content (homepage hero) built in Phase 5.
 */
export interface Props {
  heading: string;
  subheading?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  eyebrow?: string;
  /** 'default' = cream bg, 'dark' = charcoal bg */
  variant?: 'default' | 'dark' | 'minimal';
  /** Center-align all content */
  centered?: boolean;
}

const {
  heading,
  subheading,
  primaryCTA,
  secondaryCTA,
  eyebrow,
  variant = 'default',
  centered = false,
} = Astro.props;
---

<section class:list={['hero', `hero--${variant}`, { 'hero--centered': centered }]}>
  <div class="container">
    <div class="hero__content">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="hero__heading">{heading}</h1>
      {subheading && <p class="hero__subheading lead">{subheading}</p>}
      {(primaryCTA || secondaryCTA) && (
        <div class="hero__actions">
          {primaryCTA && (
            <a href={primaryCTA.href} class="btn btn--primary btn--lg">
              {primaryCTA.label}
            </a>
          )}
          {secondaryCTA && (
            <a href={secondaryCTA.href} class="btn btn--secondary btn--lg">
              {secondaryCTA.label}
            </a>
          )}
        </div>
      )}
      <!-- Optional slot for extra content (stats, badges, etc.) -->
      <slot />
    </div>
  </div>
</section>

<style>
.hero {
  padding-block: var(--space-24) var(--space-20);
  position: relative;
}

.hero--minimal {
  padding-block: var(--space-16) var(--space-12);
}

.hero--dark {
  background-color: var(--color-surface-dark);
  color: var(--color-text-inverse);
}

.hero--dark .eyebrow {
  color: var(--color-accent-light);
}

.hero__content {
  max-width: 48rem;
}

.hero--centered .hero__content {
  max-width: 52rem;
  margin-inline: auto;
  text-align: center;
}

.hero__heading {
  font-family: var(--font-serif);
  font-size: clamp(2.25rem, 5.5vw, 3.75rem);
  font-weight: var(--weight-bold);
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: inherit;
  margin-bottom: var(--space-6);
}

/* Subtle accent on part of the heading — applied via <em> inside heading */
.hero__heading em {
  font-style: normal;
  color: var(--color-accent);
}

.hero__subheading {
  max-width: 42rem;
  color: var(--color-text-muted);
  margin-bottom: var(--space-10);
}

.hero--dark .hero__subheading {
  color: rgba(249, 246, 241, 0.7);
}

.hero--centered .hero__subheading {
  margin-inline: auto;
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.hero--centered .hero__actions {
  justify-content: center;
}

@media (max-width: 480px) {
  .hero {
    padding-block: var(--space-16) var(--space-12);
  }
  .hero__actions {
    flex-direction: column;
    align-items: flex-start;
  }
  .hero--centered .hero__actions {
    align-items: center;
  }
  .hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
}
</style>
