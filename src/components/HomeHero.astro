---
/**
 * HomeHero.astro
 * Premium multi-image sliced hero composition for the homepage only.
 * Uses 4 photographic panels with angled boundaries, gradient overlay,
 * Ken Burns effect, and staggered entrance animation.
 * Respects prefers-reduced-motion.
 */
export interface Props {
  eyebrow: string;
  heading: string;
  subheading: string;
  primaryCTA: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  trustItems?: string[];
}

const {
  eyebrow,
  heading,
  subheading,
  primaryCTA,
  secondaryCTA,
  trustItems = [],
} = Astro.props;
---

<section class="home-hero" aria-labelledby="hero-heading">
  {/* Image composition — decorative */}
  <div class="home-hero__mosaic" aria-hidden="true">
    <div class="home-hero__slice home-hero__slice--1">
      <img
        src="/assets/hero/bretagne-coast.jpg"
        alt=""
        width="1600" height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="home-hero__slice-img"
      />
    </div>
    <div class="home-hero__slice home-hero__slice--2">
      <img
        src="/assets/hero/french-town.jpg"
        alt=""
        width="1600" height="900"
        loading="eager"
        decoding="async"
        class="home-hero__slice-img"
      />
    </div>
    <div class="home-hero__slice home-hero__slice--3">
      <img
        src="/assets/hero/digital-network.jpg"
        alt=""
        width="1600" height="900"
        loading="eager"
        decoding="async"
        class="home-hero__slice-img"
      />
    </div>
    <div class="home-hero__slice home-hero__slice--4">
      <img
        src="/assets/hero/architecture.jpg"
        alt=""
        width="1600" height="900"
        loading="eager"
        decoding="async"
        class="home-hero__slice-img"
      />
    </div>
  </div>

  {/* Gradient overlay for text readability */}
  <div class="home-hero__overlay"></div>

  {/* Content */}
  <div class="container home-hero__content">
    <p class="home-hero__eyebrow anim-item anim-item--1">{eyebrow}</p>
    <h1 class="home-hero__heading anim-item anim-item--2" id="hero-heading" set:html={heading} />
    <p class="home-hero__lead anim-item anim-item--3">{subheading}</p>
    <div class="home-hero__actions anim-item anim-item--4">
      <a href={primaryCTA.href} class="btn btn--lg btn--cta-dark-primary">
        {primaryCTA.label}
      </a>
      {secondaryCTA && (
        <a href={secondaryCTA.href} class="btn btn--lg btn--secondary home-hero__btn-secondary">
          {secondaryCTA.label}
        </a>
      )}
    </div>
    {trustItems.length > 0 && (
      <div class="home-hero__trust anim-item anim-item--5">
        {trustItems.map((item) => (
          <span class="trust-item">✓ {item}</span>
        ))}
      </div>
    )}
  </div>

  {/* Scroll indicator */}
  <div class="home-hero__scroll anim-item anim-item--5" aria-hidden="true">
    <div class="home-hero__scroll-line"></div>
  </div>
</section>

<style>
/* ══ HERO SHELL ══ */
.home-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-bottom: var(--space-16);
}

/* ══ IMAGE MOSAIC — 4 ANGLED SLICES ══ */
.home-hero__mosaic {
  position: absolute;
  inset: 0;
  display: flex;
  z-index: 0;
}

.home-hero__slice {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}

/* Each slice uses clip-path for angled boundaries */
.home-hero__slice--1 {
  width: 32%;
  clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);
}
.home-hero__slice--2 {
  width: 26%;
  margin-left: -3%;
  clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
}
.home-hero__slice--3 {
  width: 24%;
  margin-left: -3%;
  clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
}
.home-hero__slice--4 {
  width: 28%;
  margin-left: -3%;
  clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%);
}

.home-hero__slice-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Ken Burns — very subtle slow zoom/pan per slice */
.home-hero__slice--1 .home-hero__slice-img {
  animation: ken-burns-1 25s ease-in-out infinite alternate;
  object-position: center;
}
.home-hero__slice--2 .home-hero__slice-img {
  animation: ken-burns-2 28s ease-in-out infinite alternate;
  object-position: center 40%;
}
.home-hero__slice--3 .home-hero__slice-img {
  animation: ken-burns-3 22s ease-in-out infinite alternate;
  object-position: center;
}
.home-hero__slice--4 .home-hero__slice-img {
  animation: ken-burns-4 26s ease-in-out infinite alternate;
  object-position: center 30%;
}

@keyframes ken-burns-1 {
  0%   { transform: scale(1) translate(0, 0); }
  100% { transform: scale(1.08) translate(-1%, 1%); }
}
@keyframes ken-burns-2 {
  0%   { transform: scale(1.04) translate(0, 0); }
  100% { transform: scale(1) translate(1%, -1%); }
}
@keyframes ken-burns-3 {
  0%   { transform: scale(1) translate(0, 0); }
  100% { transform: scale(1.06) translate(-0.5%, 0.5%); }
}
@keyframes ken-burns-4 {
  0%   { transform: scale(1.06) translate(0, 0); }
  100% { transform: scale(1) translate(0.5%, -0.5%); }
}

/* Slice entrance animation */
.home-hero__slice--1 { animation: slice-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0s both; }
.home-hero__slice--2 { animation: slice-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both; }
.home-hero__slice--3 { animation: slice-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both; }
.home-hero__slice--4 { animation: slice-enter 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both; }

@keyframes slice-enter {
  from { opacity: 0; transform: scale(1.1); }
  to   { opacity: 1; transform: scale(1); }
}

/* ══ GRADIENT OVERLAY ══ */
.home-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to top,
    rgba(26, 39, 68, 0.92) 0%,
    rgba(26, 39, 68, 0.65) 35%,
    rgba(26, 39, 68, 0.3) 65%,
    rgba(26, 39, 68, 0.15) 100%
  );
}

/* ══ CONTENT ══ */
.home-hero__content {
  position: relative;
  z-index: 2;
  max-width: var(--max-width-content);
}

.home-hero__eyebrow {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: var(--color-atlantic-muted);
  margin-bottom: var(--space-4);
}

.home-hero__heading {
  font-family: var(--font-serif);
  font-size: clamp(2.5rem, 6vw, 4.25rem);
  font-weight: var(--weight-bold);
  line-height: 1.08;
  letter-spacing: -0.03em;
  color: var(--color-text-inverse);
  margin-bottom: var(--space-6);
  max-width: 48rem;
}

.home-hero__heading :global(em) {
  font-style: normal;
  color: var(--color-atlantic-muted);
}

.home-hero__lead {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: rgba(249, 246, 241, 0.78);
  max-width: 42rem;
  margin-bottom: var(--space-10);
}

.home-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-8);
}

.home-hero__btn-secondary {
  border-color: rgba(249, 246, 241, 0.35);
  color: var(--color-text-inverse);
}

.home-hero__btn-secondary:hover {
  border-color: var(--color-text-inverse);
  background-color: rgba(249, 246, 241, 0.1);
  color: var(--color-text-inverse);
}

.home-hero__trust {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.home-hero__trust .trust-item {
  font-size: var(--text-sm);
  color: rgba(249, 246, 241, 0.6);
}

/* ══ ENTRANCE ANIMATIONS ══ */
.anim-item {
  opacity: 0;
  transform: translateY(16px);
}

.anim-item--1 { animation: anim-enter 0.6s ease-out 0.4s both; }
.anim-item--2 { animation: anim-enter 0.7s ease-out 0.55s both; }
.anim-item--3 { animation: anim-enter 0.6s ease-out 0.75s both; }
.anim-item--4 { animation: anim-enter 0.6s ease-out 0.95s both; }
.anim-item--5 { animation: anim-enter 0.6s ease-out 1.1s both; }

@keyframes anim-enter {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ══ SCROLL INDICATOR ══ */
.home-hero__scroll {
  position: absolute;
  bottom: var(--space-6);
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.home-hero__scroll-line {
  width: 1px;
  height: 2.5rem;
  background: linear-gradient(to bottom, transparent, rgba(249, 246, 241, 0.4));
  animation: scroll-pulse 2s ease-in-out infinite;
}

@keyframes scroll-pulse {
  0%, 100% { opacity: 0.3; transform: scaleY(0.7); }
  50%      { opacity: 1; transform: scaleY(1); }
}

/* ══ REDUCED MOTION ══ */
@media (prefers-reduced-motion: reduce) {
  .home-hero__slice--1,
  .home-hero__slice--2,
  .home-hero__slice--3,
  .home-hero__slice--4,
  .anim-item--1,
  .anim-item--2,
  .anim-item--3,
  .anim-item--4,
  .anim-item--5 {
    animation: none !important;
    opacity: 1;
    transform: none;
  }
  .home-hero__slice-img {
    animation: none !important;
  }
  .home-hero__scroll-line {
    animation: none !important;
    opacity: 0.4;
  }
}

/* ══ RESPONSIVE ══ */
@media (max-width: 1024px) {
  .home-hero {
    min-height: 80vh;
  }
  .home-hero__slice--3 {
    display: none;
  }
  .home-hero__slice--1 { width: 38%; }
  .home-hero__slice--2 { width: 34%; }
  .home-hero__slice--4 { width: 34%; }
}

@media (max-width: 768px) {
  .home-hero {
    min-height: 75vh;
    padding-bottom: var(--space-12);
  }
  /* On tablet, show 2 slices */
  .home-hero__slice--3,
  .home-hero__slice--4 {
    display: none;
  }
  .home-hero__slice--1 {
    width: 55%;
    clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
  }
  .home-hero__slice--2 {
    width: 55%;
    margin-left: -8%;
    clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
  }
}

@media (max-width: 480px) {
  .home-hero {
    min-height: 70vh;
    padding-bottom: var(--space-10);
  }
  /* On mobile, use single dominant image */
  .home-hero__mosaic {
    display: block;
  }
  .home-hero__slice--2,
  .home-hero__slice--3,
  .home-hero__slice--4 {
    display: none;
  }
  .home-hero__slice--1 {
    width: 100%;
    clip-path: none;
    position: absolute;
    inset: 0;
  }
  .home-hero__actions {
    flex-direction: column;
  }
  .home-hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
  .home-hero__scroll {
    display: none;
  }
}
</style>
