---
/**
 * Breadcrumbs.astro
 * Accessible breadcrumb nav with BreadcrumbList schema markup.
 * Full design: Phase 4. Schema auto-generated in ServiceLayout.
 */
export interface Props {
  items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<nav aria-label="Fil d'Ariane" class="breadcrumbs">
  <ol class="breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">
    {items.map((item, i) => {
      const isLast = i === items.length - 1;
      return (
        <li
          class="breadcrumbs__item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          {isLast
            ? <span itemprop="name" aria-current="page">{item.label}</span>
            : <a itemprop="item" href={item.href}><span itemprop="name">{item.label}</span></a>
          }
          <meta itemprop="position" content={String(i + 1)} />
        </li>
      );
    })}
  </ol>
</nav>
