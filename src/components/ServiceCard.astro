---
/**
 * ServiceCard.astro
 * Used in the homepage services grid and /services/ hub.
 */
export interface Props {
  title: string;
  slug: string;
  description: string;
  icon?: string;
  /** Optional visual accent number (1–5) */
  index?: number;
}

const { title, slug, description, index } = Astro.props;
---

<article class="service-card">
  {index !== undefined && (
    <span class="service-card__index" aria-hidden="true">
      {String(index).padStart(2, '0')}
    </span>
  )}
  <div class="service-card__body">
    <h3 class="service-card__title">
      <a href={slug} class="service-card__link">{title}</a>
    </h3>
    <p class="service-card__description">{description}</p>
  </div>
  <a
    href={slug}
    class="service-card__arrow"
    aria-label={`En savoir plus sur ${title}`}
    tabindex="-1"
    aria-hidden="true"
  >
    →
  </a>
</article>

<style>
.service-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-8);
  background-color: var(--color-surface);
  border: 1px solid var(--color-border-light);
  border-radius: var(--radius-lg);
  transition:
    border-color var(--transition-base),
    box-shadow var(--transition-base),
    transform var(--transition-base);
  overflow: hidden;
}

.service-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background-color: var(--color-accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--transition-base);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.service-card:hover {
  border-color: var(--color-border);
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}

.service-card:hover::before {
  transform: scaleX(1);
}

.service-card:has(.service-card__link:focus-visible) {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
}

.service-card__index {
  font-family: var(--font-serif);
  font-size: var(--text-xs);
  font-weight: var(--weight-bold);
  color: var(--color-text-subtle);
  letter-spacing: var(--tracking-wide);
}

.service-card__body {
  flex: 1;
}

.service-card__title {
  font-size: var(--text-lg);
  font-weight: var(--weight-semibold);
  margin-bottom: var(--space-3);
}

.service-card__link {
  text-decoration: none;
  color: var(--color-text);
  transition: color var(--transition-fast);
}

/* Extend link hit area to the whole card */
.service-card__link::after {
  content: '';
  position: absolute;
  inset: 0;
}

.service-card__link:hover {
  color: var(--color-accent);
}

.service-card__description {
  font-size: var(--text-sm);
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
}

.service-card__arrow {
  display: block;
  font-size: var(--text-lg);
  color: var(--color-accent);
  text-decoration: none;
  transition: transform var(--transition-fast);
  width: fit-content;
}

.service-card:hover .service-card__arrow {
  transform: translateX(4px);
}
</style>
