---
/**
 * CTA.astro
 * Standalone CTA section — used at section ends and page bottoms.
 * Per spec §32: placed intentionally, not after every section.
 */
export interface Props {
  heading?: string;
  body?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  /** 'cream' (default), 'green', 'dark', 'navy' */
  variant?: 'cream' | 'green' | 'dark' | 'navy';
  bgImage?: string;
}

const {
  heading = 'Parlons de votre visibilité sur Google.',
  body,
  primaryCTA = { label: 'Réserver un appel', href: '/reserver-un-appel/' },
  secondaryCTA,
  variant = 'cream',
  bgImage,
} = Astro.props;

const isDarkTheme = variant === 'dark' || variant === 'navy' || Boolean(bgImage);
---

<section
  class:list={[
    'cta-block',
    `cta-block--${variant}`,
    { 'cta-block--has-image': Boolean(bgImage) }
  ]}
  aria-labelledby="cta-heading"
>
  {bgImage && (
    <div class="cta-block__bg" aria-hidden="true">
      <img src={bgImage} alt="" loading="lazy" class="cta-block__bg-img" />
      <div class="cta-block__overlay"></div>
    </div>
  )}
  <div class="container">
    <div class="cta-block__inner">
      <div class="cta-block__text">
        <h2 class="cta-block__heading" id="cta-heading">{heading}</h2>
        {body && <p class="cta-block__body">{body}</p>}
      </div>
      <div class="cta-block__actions">
        <a href={primaryCTA.href} class:list={['btn', 'btn--lg', isDarkTheme ? 'btn--cta-dark-primary' : 'btn--primary']}>
          {primaryCTA.label}
        </a>
        {secondaryCTA && (
          <a href={secondaryCTA.href} class:list={['btn', 'btn--lg', isDarkTheme ? 'btn--secondary cta-btn-secondary--light' : 'btn--secondary']}>
            {secondaryCTA.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
.cta-block {
  position: relative;
  padding-block: var(--space-20);
  overflow: hidden;
}

.cta-block > .container {
  position: relative;
  z-index: 1;
}

.cta-block__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.cta-block__bg-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cta-block__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(26, 39, 68, 0.90) 0%, rgba(17, 26, 46, 0.95) 100%);
}

.cta-block--cream {
  background-color: var(--color-surface-warm);
  border-top: 1px solid var(--color-border-light);
  border-bottom: 1px solid var(--color-border-light);
}

.cta-block--green {
  background-color: var(--color-accent);
  color: white;
}

.cta-block--dark {
  background-color: var(--color-surface-dark);
  color: var(--color-text-inverse);
}

.cta-block--navy {
  background: linear-gradient(150deg, var(--color-navy, #1a2744) 0%, #111a2e 100%);
  color: #F9F6F1;
}

.cta-block--navy .cta-block__heading,
.cta-block--has-image .cta-block__heading {
  color: #F9F6F1;
}

.cta-block--navy .cta-block__body,
.cta-block--has-image .cta-block__body {
  color: rgba(249, 246, 241, 0.82);
}

.cta-btn-secondary--light {
  border-color: rgba(249, 246, 241, 0.4);
  color: #F9F6F1;
}

.cta-btn-secondary--light:hover {
  border-color: #F9F6F1;
  background-color: rgba(249, 246, 241, 0.1);
}

.cta-block__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-12);
  flex-wrap: wrap;
}

.cta-block__heading {
  font-family: var(--font-serif);
  font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
  font-weight: var(--weight-bold);
  line-height: var(--leading-snug);
  letter-spacing: var(--tracking-tight);
  max-width: 32rem;
}

.cta-block__body {
  margin-top: var(--space-3);
  font-size: var(--text-lg);
  opacity: 0.75;
}

.cta-block__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  flex-shrink: 0;
}

/* Light primary button for dark/green sections */
.btn--cta-dark-primary {
  background-color: var(--color-text-inverse);
  border-color: var(--color-text-inverse);
  color: var(--color-text);
}

.btn--cta-dark-primary:hover {
  background-color: var(--color-accent-light);
  border-color: var(--color-accent-light);
}

@media (max-width: 768px) {
  .cta-block__inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
