---
/**
 * ProcessSteps.astro
 * Numbered process / methodology visualization for the 5 steps:
 * 01 — Comprendre
 * 02 — Structurer
 * 03 — Optimiser
 * 04 — Développer
 * 05 — Observer
 */
export interface Step {
  number: number;
  title: string;
  description: string;
}

export interface Props {
  steps: Step[];
  eyebrow?: string;
  heading?: string;
  subheading?: string;
}

const {
  steps,
  eyebrow = 'Méthodologie',
  heading = 'Une méthode en 5 étapes structurées',
  subheading = 'Le SEO et le GEO ne reposent pas sur des astuces éphémères, mais sur un processus logique et itératif d\'analyse, d\'optimisation et de mesure.',
} = Astro.props;
---

<section class="process section" aria-labelledby="process-heading">
  <div class="container">
    <div class="section-header--centered">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 id="process-heading">{heading}</h2>
      {subheading && <p class="lead" style="margin-top: var(--space-3)">{subheading}</p>}
    </div>

    <ol class="process__steps">
      {steps.map((step, i) => (
        <li class="process__step">
          <div class="process__step-inner">
            <div class="process__number-wrap" aria-hidden="true">
              <span class="process__number">{String(step.number).padStart(2, '0')}</span>
            </div>
            <div class="process__content">
              <h3 class="process__title">{step.title}</h3>
              <p class="process__description">{step.description}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
.process__steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-4);
  position: relative;
  list-style: none;
  padding: 0;
  margin: 0;
}

.process__step {
  position: relative;
}

.process__step-inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding: var(--space-6);
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  height: 100%;
  transition: all var(--transition-base);
}

.process__step-inner:hover {
  border-color: var(--color-accent);
  box-shadow: 0 8px 20px -4px rgba(15, 23, 42, 0.06);
  transform: translateY(-2px);
}

/* Number badge */
.process__number-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  background-color: var(--color-accent-light);
  border: 1px solid rgba(29, 78, 216, 0.15);
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.process__number {
  font-family: var(--font-sans);
  font-size: var(--text-xs);
  font-weight: 700;
  color: var(--color-accent);
  letter-spacing: 0.05em;
}

.process__title {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: var(--space-2);
}

.process__description {
  font-size: 0.8125rem;
  color: var(--color-text-muted);
  line-height: var(--leading-relaxed);
}

@media (max-width: 1024px) {
  .process__steps {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .process__steps {
    grid-template-columns: 1fr;
  }
}
</style>
