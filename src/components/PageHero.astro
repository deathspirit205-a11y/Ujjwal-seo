---
/**
 * PageHero.astro
 * Reusable photographic hero for all pages except homepage.
 * Supports: background image, overlay, eyebrow, title, description, CTA.
 * Accessibility: decorative bg image via CSS, meaningful alt handled separately.
 */
export interface Props {
  /** Background image path (relative to /public) */
  bgImage: string;
  /** Alt text for screen readers — empty string for decorative */
  bgAlt?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  /** CSS object-position for the background image */
  focalPosition?: string;
  /** 'default' | 'dark' | 'light' */
  overlay?: 'default' | 'dark' | 'light';
  /** Compact variant for inner pages */
  compact?: boolean;
}

const {
  bgImage,
  bgAlt = '',
  eyebrow,
  title,
  description,
  primaryCTA,
  secondaryCTA,
  focalPosition = 'center',
  overlay = 'default',
  compact = false,
} = Astro.props;
---

<section class:list={['page-hero', `page-hero--${overlay}`, { 'page-hero--compact': compact }]}>
  <div class="page-hero__bg">
    <img
      src={bgImage}
      alt={bgAlt}
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="page-hero__img"
      style={`object-position: ${focalPosition}`}
    />
  </div>
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    {eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
    <h1 class="page-hero__title">{title}</h1>
    {description && <p class="page-hero__desc">{description}</p>}
    {(primaryCTA || secondaryCTA) && (
      <div class="page-hero__actions">
        {primaryCTA && (
          <a href={primaryCTA.href} class="btn btn--lg btn--cta-dark-primary">
            {primaryCTA.label}
          </a>
        )}
        {secondaryCTA && (
          <a href={secondaryCTA.href} class="btn btn--lg btn--secondary page-hero__btn-secondary">
            {secondaryCTA.label}
          </a>
        )}
      </div>
    )}
    <slot />
  </div>
</section>

<style>
.page-hero {
  position: relative;
  min-height: 50vh;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding-block: var(--space-32) var(--space-16);
}

.page-hero--compact {
  min-height: 36vh;
  padding-block: var(--space-24) var(--space-12);
}

/* Background image */
.page-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.page-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Gradient overlay */
.page-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.page-hero--default .page-hero__overlay {
  background: linear-gradient(
    to top,
    rgba(26, 39, 68, 0.85) 0%,
    rgba(26, 39, 68, 0.5) 50%,
    rgba(26, 39, 68, 0.25) 100%
  );
}

.page-hero--dark .page-hero__overlay {
  background: linear-gradient(
    to top,
    rgba(26, 39, 68, 0.92) 0%,
    rgba(26, 39, 68, 0.65) 50%,
    rgba(26, 39, 68, 0.4) 100%
  );
}

.page-hero--light .page-hero__overlay {
  background: linear-gradient(
    to top,
    rgba(26, 39, 68, 0.7) 0%,
    rgba(26, 39, 68, 0.3) 50%,
    rgba(26, 39, 68, 0.12) 100%
  );
}

/* Content */
.page-hero__content {
  position: relative;
  z-index: 2;
  max-width: var(--max-width-content);
}

.page-hero__eyebrow {
  display: inline-block;
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: var(--color-atlantic-muted);
  margin-bottom: var(--space-4);
}

.page-hero__title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: var(--weight-bold);
  line-height: 1.12;
  letter-spacing: -0.025em;
  color: var(--color-text-inverse);
  margin-bottom: var(--space-5);
  max-width: 44rem;
}

.page-hero__desc {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: rgba(249, 246, 241, 0.8);
  max-width: 38rem;
  margin-bottom: var(--space-8);
}

.page-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

.page-hero__btn-secondary {
  border-color: rgba(249, 246, 241, 0.4);
  color: var(--color-text-inverse);
}

.page-hero__btn-secondary:hover {
  border-color: var(--color-text-inverse);
  background-color: rgba(249, 246, 241, 0.12);
  color: var(--color-text-inverse);
}

/* Responsive */
@media (max-width: 768px) {
  .page-hero {
    min-height: 40vh;
    padding-block: var(--space-24) var(--space-10);
  }
  .page-hero--compact {
    min-height: 30vh;
    padding-block: var(--space-20) var(--space-8);
  }
}

@media (max-width: 480px) {
  .page-hero {
    min-height: 36vh;
    padding-block: var(--space-20) var(--space-8);
  }
  .page-hero__actions {
    flex-direction: column;
  }
  .page-hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
}
</style>
