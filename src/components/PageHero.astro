---
/**
 * PageHero.astro
 * Light, natural, editorial hero for inner pages (Phase 3 visual direction).
 * Uses soft natural photography or subtle coastal mist tones (#F7F8F5 / #EDF3F4)
 * with high-contrast #17324D / #263746 typography and optional HeroVisual diagram.
 */
import HeroVisual, { type HeroVisualVariant } from './HeroVisual.astro';

export interface Props {
  /** Background image path (optional) */
  bgImage?: string;
  /** Alt text for screen readers */
  bgAlt?: string;
  eyebrow?: string;
  title: string;
  description?: string;
  primaryCTA?: { label: string; href: string };
  secondaryCTA?: { label: string; href: string };
  /** CSS object-position for the background image */
  focalPosition?: string;
  /** 'default' | 'dark' | 'light' */
  overlay?: 'default' | 'dark' | 'light';
  /** Compact variant for inner pages */
  compact?: boolean;
  /** Animated data illustration */
  visual?: HeroVisualVariant;
}

const {
  bgImage = '/assets/hero/calm-coast.jpg',
  bgAlt = '',
  eyebrow,
  title,
  description,
  primaryCTA,
  secondaryCTA,
  focalPosition = 'center',
  overlay = 'light',
  compact = false,
  visual,
} = Astro.props;
---

<section class:list={['page-hero', `page-hero--${overlay}`, { 'page-hero--compact': compact, 'page-hero--visual': Boolean(visual) }]}>
  <div class="page-hero__bg" aria-hidden="true">
    <img
      src={bgImage}
      alt={bgAlt}
      width="1600"
      height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="page-hero__img"
      style={`object-position: ${focalPosition}`}
    />
    <div class="page-hero__veil"></div>
  </div>

  {visual && <HeroVisual variant={visual} />}

  <div class="container page-hero__content">
    {eyebrow && (
      <p class="page-hero__eyebrow">
        <span class="page-hero__dot" aria-hidden="true"></span>
        <span>{eyebrow}</span>
      </p>
    )}
    <h1 class="page-hero__title">{title}</h1>
    {description && <p class="page-hero__desc">{description}</p>}
    {(primaryCTA || secondaryCTA) && (
      <div class="page-hero__actions">
        {primaryCTA && (
          <a href={primaryCTA.href} class="btn btn--lg btn--primary">
            {primaryCTA.label}
          </a>
        )}
        {secondaryCTA && (
          <a href={secondaryCTA.href} class="btn btn--lg btn--secondary">
            {secondaryCTA.label}
          </a>
        )}
      </div>
    )}
    <slot />
  </div>
</section>

<style>
.page-hero {
  position: relative;
  min-height: 40vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding-block: var(--space-16) var(--space-14);
  background-color: var(--color-surface-warm); /* #EDF3F4 */
  border-bottom: 1px solid var(--color-border);
}

.page-hero--compact {
  min-height: 30vh;
  padding-block: var(--space-14) var(--space-12);
}

.page-hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
}

.page-hero__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  opacity: 0.22;
  filter: saturate(0.85) contrast(0.95);
}

.page-hero__veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    105deg,
    rgba(247, 248, 245, 0.96) 0%,
    rgba(247, 248, 245, 0.90) 52%,
    rgba(237, 243, 244, 0.80) 100%
  );
}

.page-hero__content {
  position: relative;
  z-index: 2;
  max-width: var(--max-width-content);
}

.page-hero__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: 0.35rem 0.85rem;
  background-color: #FFFFFF;
  border: 1px solid var(--color-accent-soft);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: var(--weight-semibold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-navy);
  margin-bottom: var(--space-4);
  box-shadow: var(--shadow-xs);
}

.page-hero__dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--color-atlantic);
}

.page-hero__title {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 4.4vw, 3.15rem);
  font-weight: var(--weight-bold);
  line-height: 1.14;
  letter-spacing: -0.025em;
  color: var(--color-navy); /* #17324D */
  margin-bottom: var(--space-4);
  max-width: 44rem;
}

.page-hero__desc {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: var(--color-text); /* #263746 */
  max-width: 40rem;
  margin-bottom: var(--space-7);
}

.page-hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
}

@media (min-width: 1025px) {
  .page-hero--visual .page-hero__content {
    margin-left: max(1.5rem, calc((100vw - 1216px) / 2));
    margin-right: auto;
    max-width: 54%;
    padding-inline: 0;
  }
}

@media (max-width: 768px) {
  .page-hero {
    min-height: 32vh;
    padding-block: var(--space-12) var(--space-10);
  }
  .page-hero--compact {
    min-height: 26vh;
    padding-block: var(--space-10) var(--space-8);
  }
}

@media (max-width: 480px) {
  .page-hero__actions {
    flex-direction: column;
  }
  .page-hero__actions .btn {
    width: 100%;
    justify-content: center;
  }
}
</style>
