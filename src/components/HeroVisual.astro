---
/**
 * HeroVisual.astro
 * Light editorial SVG diagrams for inner page heroes (Phase 3 palette).
 * Uses #FFFFFF card, #17324D primary navy, #397B9B Atlantic blue, #B8D1D6 soft accent.
 * Respects prefers-reduced-motion. Zero fabricated client stats.
 */
export type HeroVisualVariant =
  | 'traffic' | 'network' | 'serp' | 'map' | 'ai' | 'audit' | 'content' | 'speed';

export interface Props { variant?: HeroVisualVariant }
const { variant = 'traffic' } = Astro.props;
---

<div class={`hv hv--${variant}`} aria-hidden="true">
  <svg viewBox="0 0 500 320" xmlns="http://www.w3.org/2000/svg" fill="none">
    <defs>
      <linearGradient id="hvAreaLight" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#397B9B" stop-opacity="0.24" />
        <stop offset="100%" stop-color="#397B9B" stop-opacity="0.02" />
      </linearGradient>
      <linearGradient id="hvLineLight" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#397B9B" />
        <stop offset="100%" stop-color="#17324D" />
      </linearGradient>
    </defs>

    {/* Light editorial card frame */}
    <rect x="10" y="10" width="480" height="300" rx="16" class="hv-card" />
    <circle cx="32" cy="30" r="3.5" fill="#B8D1D6" />
    <circle cx="44" cy="30" r="3.5" fill="#397B9B" />
    <circle cx="56" cy="30" r="3.5" fill="#17324D" />

    {variant === 'traffic' && (
      <g>
        <text x="36" y="68" class="hv-label">Structure &amp; Visibilité Organique</text>
        <text x="36" y="94" class="hv-big">Progression durable</text>
        {[0,1,2,3].map((i) => <line x1="36" x2="464" y1={138 + i*42} y2={138 + i*42} class="hv-grid" />)}
        <path d="M36 280 L90 272 L145 264 L200 248 L255 236 L310 212 L365 188 L420 160 L464 134 L464 280 Z" fill="url(#hvAreaLight)" />
        <path d="M36 280 L90 272 L145 264 L200 248 L255 236 L310 212 L365 188 L420 160 L464 134" stroke="url(#hvLineLight)" stroke-width="3" stroke-linecap="round" class="hv-draw" />
        <circle cx="464" cy="134" r="5.5" fill="#17324D" />
      </g>
    )}

    {variant === 'speed' && (
      <g>
        <text x="36" y="68" class="hv-label">Signaux Core Web Vitals</text>
        {[['LCP', 115, '#17324D'], ['INP', 250, '#397B9B'], ['CLS', 385, '#2E7D5B']].map(([l, x, c]) => (
          <g>
            <circle cx={x} cy="178" r="46" class="hv-ring-bg" />
            <circle cx={x} cy="178" r="46" stroke={c as string} class="hv-ring" transform={`rotate(-90 ${x} 178)`} />
            <text x={x} y="184" text-anchor="middle" class="hv-ring-txt">{l}</text>
          </g>
        ))}
        <rect x="36" y="258" width="428" height="8" rx="4" class="hv-bar-bg" />
        <rect x="36" y="258" width="380" height="8" rx="4" fill="url(#hvLineLight)" />
      </g>
    )}

    {variant === 'network' && (
      <g>
        <text x="36" y="68" class="hv-label">Graphe d'entités &amp; Maillage</text>
        {[[250,180,125,115],[250,180,385,110],[250,180,110,250],[250,180,395,250],[250,180,250,278],[125,115,385,110]].map(([a,b,c,d]) => (
          <line x1={a} y1={b} x2={c} y2={d} class="hv-edge" />
        ))}
        {[[125,115],[385,110],[110,250],[395,250],[250,278]].map(([x,y]) => (
          <circle cx={x} cy={y} r="10" class="hv-node" />
        ))}
        <circle cx="250" cy="180" r="20" fill="#17324D" />
      </g>
    )}

    {variant === 'serp' && (
      <g>
        <rect x="36" y="54" width="428" height="34" rx="17" class="hv-input" />
        <rect x="56" y="67" width="210" height="8" rx="4" fill="#397B9B" opacity="0.65" />
        {[0,1,2].map((i) => (
          <g>
            <rect x="36" y={108 + i*62} width="428" height="50" rx="10" class={i === 0 ? 'hv-result hv-result--top' : 'hv-result'} />
            <rect x="54" y={122 + i*62} width={i === 0 ? 210 : 170} height="8" rx="4" fill={i === 0 ? '#17324D' : '#397B9B'} />
            <rect x="54" y={138 + i*62} width="300" height="6" rx="3" class="hv-line" />
          </g>
        ))}
      </g>
    )}

    {variant === 'map' && (
      <g>
        <text x="36" y="68" class="hv-label">Ancrage Territorial &amp; Proximité</text>
        {[0,1,2,3,4,5,6,7].map((i) => <line x1={36 + i*60} x2={36 + i*60} y1="86" y2="290" class="hv-grid" />)}
        {[0,1,2,3].map((i) => <line x1="36" x2="464" y1={86 + i*60} y2={86 + i*60} class="hv-grid" />)}
        <path d="M56 266 C 150 192, 230 245, 290 164 S 420 118, 452 98" class="hv-road" />
        {[[145,218],[290,164],[385,126],[210,136],[345,236]].map(([x,y], i) => (
          <g>
            <circle cx={x} cy={y} r="14" fill={i === 1 ? '#17324D' : '#397B9B'} opacity=".16" />
            <circle cx={x} cy={y} r="5.5" fill={i === 1 ? '#17324D' : '#397B9B'} />
          </g>
        ))}
      </g>
    )}

    {variant === 'ai' && (
      <g>
        <text x="36" y="68" class="hv-label">Compréhension &amp; Citation IA (GEO)</text>
        <rect x="180" y="84" width="284" height="34" rx="12" fill="#17324D" />
        <rect x="200" y="98" width="190" height="7" rx="3.5" fill="#EDF3F4" />
        <rect x="36" y="132" width="350" height="98" rx="12" class="hv-result hv-result--top" />
        <rect x="54" y="150" width="290" height="7" rx="3.5" class="hv-line" />
        <rect x="54" y="168" width="250" height="7" rx="3.5" class="hv-line" />
        <rect x="54" y="186" width="270" height="7" rx="3.5" class="hv-line" />
        <rect x="54" y="204" width="98" height="16" rx="8" fill="#397B9B" />
        {[0,1,2].map((i) => <rect x={36 + i*116} y="244" width="104" height="42" rx="8" class={i === 0 ? 'hv-result hv-result--top' : 'hv-result'} />)}
      </g>
    )}

    {variant === 'audit' && (
      <g>
        <text x="36" y="68" class="hv-label">Diagnostic Technique &amp; Sémantique</text>
        {[0,1,2,3,4].map((i) => (
          <g>
            <rect x="36" y={92 + i*38} width="280" height="10" rx="5" class="hv-bar-bg" />
            <rect x="36" y={92 + i*38} width={[245,180,220,150,205][i]} height="10" rx="5" fill={['#17324D','#397B9B','#2E7D5B','#397B9B','#17324D'][i]} />
          </g>
        ))}
        <circle cx="400" cy="180" r="50" class="hv-ring-bg" />
        <circle cx="400" cy="180" r="50" stroke="#17324D" class="hv-ring" transform="rotate(-90 400 180)" />
        <text x="400" y="186" text-anchor="middle" class="hv-ring-txt">Audit</text>
      </g>
    )}

    {variant === 'content' && (
      <g>
        <text x="36" y="68" class="hv-label">Architecture Éditoriale</text>
        <rect x="36" y="84" width="236" height="202" rx="10" class="hv-result" />
        <rect x="54" y="104" width="160" height="10" rx="5" fill="#17324D" />
        {[0,1,2,3,4,5].map((i) => <rect x="54" y={130 + i*22} width={[188,168,195,140,178,150][i]} height="6" rx="3" class="hv-line" />)}
        {[0,1,2,3,4].map((i) => (
          <rect x={304 + i*32} y={286 - (38 + i*38)} width="20" height={38 + i*38} rx="4" fill={i === 4 ? '#17324D' : '#397B9B'} opacity={0.55 + i*0.1} />
        ))}
      </g>
    )}
  </svg>
</div>

<style>
.hv {
  position: absolute;
  right: max(1.5rem, calc((100vw - 1216px) / 2));
  top: 50%;
  transform: translateY(-50%);
  width: min(38vw, 460px);
  z-index: 1;
  pointer-events: none;
}
.hv svg {
  width: 100%;
  height: auto;
  display: block;
  filter: drop-shadow(0 14px 32px rgba(23, 50, 77, 0.08));
}
.hv-card { fill: rgba(255, 255, 255, 0.92); stroke: #B8D1D6; stroke-width: 1.25; }
.hv-label { fill: #397B9B; font: 600 11px Inter, sans-serif; letter-spacing: .07em; text-transform: uppercase; }
.hv-big { fill: #17324D; font: 700 21px 'Playfair Display', Georgia, serif; }
.hv-grid { stroke: #E6EFF1; }
.hv-line { fill: #D5E2E6; }
.hv-input { fill: #F7F8F5; stroke: #B8D1D6; }
.hv-result { fill: #F7F8F5; stroke: #D5E2E6; }
.hv-result--top { stroke: #397B9B; fill: #EDF3F4; }
.hv-edge { stroke: #B8D1D6; stroke-width: 1.5; stroke-dasharray: 4 4; }
.hv-node { fill: #FFFFFF; stroke: #397B9B; stroke-width: 2.5; }
.hv-road { stroke: #397B9B; stroke-width: 2.5; stroke-dasharray: 6 5; }
.hv-ring-bg { stroke: #EDF3F4; stroke-width: 8; }
.hv-ring { stroke-width: 8; stroke-linecap: round; stroke-dasharray: 290; stroke-dashoffset: 65; }
.hv-ring-txt { fill: #17324D; font: 700 15px Inter, sans-serif; }
.hv-bar-bg { fill: #EDF3F4; }

@media (max-width: 1024px) { .hv { display: none; } }
</style>
