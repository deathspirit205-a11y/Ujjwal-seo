---
/**
 * CommitmentBand.astro
 * Light editorial band of concrete, verifiable offer commitments (no invented performance stats).
 * Numbers use data-count for a count-up animation handled in BaseLayout.
 */
const items = [
  { value: 30, suffix: 'min', label: "d'appel découverte offert", note: 'Premier diagnostic sans engagement' },
  { value: 24, suffix: 'h', label: 'pour une réponse personnelle', note: 'Jours ouvrés, en direct' },
  { value: 1, suffix: '', label: 'seul interlocuteur dédié', note: "De l'audit technique au suivi" },
  { value: 14, suffix: 'j', label: 'max. pour un audit complet', note: "Plan d'action priorisé livré" },
];
---

<section class="commit-band" aria-label="Engagements de travail">
  <div class="container">
    <ul class="commit-band__grid" role="list">
      {items.map((item, i) => (
        <li class={`commit-item reveal reveal-delay-${i}`}>
          <span class="commit-item__value">
            <span data-count={item.value}>{item.value}</span><span class="commit-item__suffix">{item.suffix}</span>
          </span>
          <span class="commit-item__label">{item.label}</span>
          <span class="commit-item__note">{item.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.commit-band {
  background-color: var(--color-surface-warm); /* #EDF3F4 */
  color: var(--color-text);
  padding-block: var(--space-10);
  border-bottom: 1px solid var(--color-border);
}

.commit-band__grid {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-6);
}

@media (max-width: 860px) {
  .commit-band__grid { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 500px) {
  .commit-band__grid { grid-template-columns: 1fr; }
}

.commit-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: var(--space-4) var(--space-5);
  background-color: #FFFFFF;
  border: 1px solid var(--color-border);
  border-left: 3px solid var(--color-atlantic); /* #397B9B */
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xs);
}

.commit-item__value {
  font-family: var(--font-serif);
  font-size: clamp(2rem, 3.5vw, 2.6rem);
  font-weight: var(--weight-bold);
  line-height: 1;
  color: var(--color-navy); /* #17324D */
  font-variant-numeric: tabular-nums;
}

.commit-item__suffix {
  font-size: 0.55em;
  margin-left: 3px;
  color: var(--color-atlantic);
}

.commit-item__label {
  margin-top: var(--space-2);
  font-size: var(--text-sm);
  font-weight: var(--weight-semibold);
  color: var(--color-navy);
}

.commit-item__note {
  font-size: var(--text-xs);
  color: var(--color-text-muted);
}
</style>
